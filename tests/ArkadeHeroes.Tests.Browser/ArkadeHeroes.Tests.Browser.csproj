<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Sdk.Web (not Sdk) because this project HOSTS the published bundle itself: a Kestrel static-file
      server standing in for whatever serves it in production. That keeps the suite to one moving part —
      no external web server to install, start or leave running.
    -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The SERVER, so the browser can be pointed at a REAL game API instead of a dead port.

    ArkadeHeroesWalkTests boots ArkadeHeroes.Server's own Program on Kestrel with the published bundle as
    its wwwroot — the exact topology the shipped container runs, one origin serving both the app and /api.
    Client.Sdk comes with it so a test can seed the server through the same typed client the console uses,
    then assert the BROWSER draws what the server actually holds. Neither reference touches the bundle: the
    browser still sees only what it downloads.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ArkadeHeroes.Server\ArkadeHeroes.Server.csproj" />
    <ProjectReference Include="..\..\src\ArkadeHeroes.Client.Sdk\ArkadeHeroes.Client.Sdk.csproj" />
    <ProjectReference Include="..\..\src\ArkadeHeroes.Core\ArkadeHeroes.Core.csproj" />
    <ProjectReference Include="..\..\src\ArkadeHeroes.Shared\ArkadeHeroes.Shared.csproj" />
  </ItemGroup>

  <!--
    Deliberately NO ProjectReference to ArkadeHeroes.Web.

    This suite's whole subject is the PUBLISHED artifact — the trimmed, linked, fingerprinted bundle a
    player downloads — not the assemblies a build produces. Referencing the project would tempt a test to
    assert against types it can see in-process, which is exactly the visibility a browser does not have,
    and would also couple this project's build to a WASM native link it does not need.
  -->

</Project>
