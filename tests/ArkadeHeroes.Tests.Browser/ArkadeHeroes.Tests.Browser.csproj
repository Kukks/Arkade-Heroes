<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Sdk.Web (not Sdk) because this project HOSTS the published bundle itself: a Kestrel static-file
      server standing in for whatever serves it in production. That keeps the suite to one moving part —
      no external web server to install, start or leave running.
    -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Deliberately NO ProjectReference to ArkadeHeroes.Web.

    This suite's whole subject is the PUBLISHED artifact — the trimmed, linked, fingerprinted bundle a
    player downloads — not the assemblies a build produces. Referencing the project would tempt a test to
    assert against types it can see in-process, which is exactly the visibility a browser does not have,
    and would also couple this project's build to a WASM native link it does not need.
  -->

</Project>
