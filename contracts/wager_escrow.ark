// Arkade Heroes — wagered-match escrow
//
// Modeled on ArkLabsHQ/coinflip's trustless escrow (docs/PROTOCOL.md and
// packages/lib/src/script.ts): each side funds its own stake VTXO carrying
// this contract; the settle path sweeps BOTH stakes atomically to the winner
// (coinflip's atomicSweep cross-input check), and time-locked forfeit/refund
// paths guarantee neither side needs to trust the other — or the game server
// — for liveness.
//
// Winner derivation (game-specific): the match outcome is a pure function of
//   matchSeed = SHA256(serverSeed ‖ matchId ‖ challengerHeroId ‖ defenderHeroId ‖ nonce)
// replayed through the deterministic BattleEngine over the committed pre-fight
// hero snapshots. The server commits SHA256(serverSeed) at open. The oracle
// attests the replayable outcome by co-signing ONLY the settle branch that
// pays the actual winner — settlement is branch-per-party because the Arkade
// Language grammar has no pubkey-equality predicate. Any observer can recompute
// the outcome from the revealed seed and expose a lying oracle.

import "single_sig.ark";

contract WagerEscrow(
    bytes32 serverSeedCommit,   // SHA256(serverSeed), fixed at match open
    pubkey challengerPk,
    pubkey defenderPk,
    pubkey oraclePk,            // game outcome oracle
    int stakeSats,              // per-side stake
    int potSats,                // 2 * stakeSats — explicit param: the grammar has no inline arithmetic
    int expiryTime,             // absolute locktime for forfeit/refund paths
    int exit                    // CSV delay for unilateral exit leaves
) {
    // Challenger won: sweep both stake VTXOs in one tx paying the pot to the
    // challenger. The revealed serverSeed must match the pre-nonce commitment,
    // and the oracle signs only the branch matching the engine outcome.
    function settleToChallenger(
        bytes32 serverSeed,
        signature oracleSig,
        int otherStakeInputIdx
    ) {
        require(sha256(serverSeed) == serverSeedCommit, "seed does not match commitment");
        require(checkSig(oracleSig, oraclePk), "invalid oracle sig");

        // atomicSweep: the sibling stake VTXO is spent in the same tx, so one
        // stake can never be swept alone (coinflip covenants.ts pattern).
        require(tx.inputs[otherStakeInputIdx].value == stakeSats, "sibling stake missing");

        require(tx.outputs[0].value >= potSats, "pot underpaid");
        require(tx.outputs[0].scriptPubKey == new SingleSig(challengerPk, exit), "pot not paid to challenger");
    }

    // Defender won: identical shape, paying the defender.
    function settleToDefender(
        bytes32 serverSeed,
        signature oracleSig,
        int otherStakeInputIdx
    ) {
        require(sha256(serverSeed) == serverSeedCommit, "seed does not match commitment");
        require(checkSig(oracleSig, oraclePk), "invalid oracle sig");
        require(tx.inputs[otherStakeInputIdx].value == stakeSats, "sibling stake missing");
        require(tx.outputs[0].value >= potSats, "pot underpaid");
        require(tx.outputs[0].scriptPubKey == new SingleSig(defenderPk, exit), "pot not paid to defender");
    }

    // Challenger walks away with both stakes if the match never resolves
    // (defender accepted but the fight was never settled before expiry).
    function forfeitToChallenger(signature challengerSig, int otherStakeInputIdx) {
        require(tx.locktime >= expiryTime, "not yet expired");
        require(tx.inputs[otherStakeInputIdx].value == stakeSats, "sibling stake missing");
        require(tx.outputs[0].scriptPubKey == new SingleSig(challengerPk, exit), "must pay challenger");
        require(checkSig(challengerSig, challengerPk), "invalid challenger sig");
    }

    // Per-side refunds: reclaim ONLY your own stake after expiry (open matches
    // nobody accepted, or mutual abandonment). No sibling-input requirement.
    function refundChallenger(signature challengerSig) {
        require(tx.locktime >= expiryTime, "not yet expired");
        require(tx.outputs[0].value >= stakeSats, "stake underpaid");
        require(tx.outputs[0].scriptPubKey == new SingleSig(challengerPk, exit), "must pay the challenger");
        require(checkSig(challengerSig, challengerPk), "invalid challenger sig");
    }

    function refundDefender(signature defenderSig) {
        require(tx.locktime >= expiryTime, "not yet expired");
        require(tx.outputs[0].value >= stakeSats, "stake underpaid");
        require(tx.outputs[0].scriptPubKey == new SingleSig(defenderPk, exit), "must pay the defender");
        require(checkSig(defenderSig, defenderPk), "invalid defender sig");
    }
}
