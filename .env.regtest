# Host-port overrides for the arkade-regtest stack (regtest/ submodule, master).
# Auto-discovered by regtest.mjs as ../.env.regtest from the submodule.
# The default postgres/nbxplorer host ports collide with the btcpayservertests
# docker project on this machine; remap them (container-internal ports unchanged).
POSTGRES_PORT=39373
NBXPLORER_PORT=32839

# arkade-regtest moved these from SECONDS to BLOCKS (upstream "Block based configuration").
# The new defaults are tiny — UNILATERAL/CHECKPOINT_EXIT_DELAY=5, VTXO_TREE_EXPIRY=180 — and our E2E
# mines blocks as it goes (`mine 6` for confirmations), so coins aged past the exit delay MID-RUN and
# arkd started answering VTXO_RECOVERABLE. That made five different covenant/offer/reclaim tests fail
# intermittently, never the same two together. These restore a window wider than a full suite run.
# They govern the ENVIRONMENT's sweep timing only — our own refund/reclaim locktimes are timestamps
# carried in the covenant, so the reclaim-after-expiry tests still exercise the real thing.
ARKD_VTXO_TREE_EXPIRY=4096
ARKD_UNILATERAL_EXIT_DELAY=512
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=512
ARKD_BOARDING_EXIT_DELAY=4096
ARKD_CHECKPOINT_EXIT_DELAY=512
