<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- Serves the Blazor WASM bundle from this host: _framework paths, the .wasm/.dat
         content types the runtime needs, and the brotli/gzip variants. Present so ONE
         container is the whole deployment - the browser then loads the app and calls the
         API on the SAME origin, which is why the localhost-only CORS policy is never
         consulted rather than needing to be widened. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
    <!-- Patched native SQLite for CVE-2025-6965 — see the full reasoning in ArkadeHeroes.Chain.csproj.
         Named here as well as there because this project declares EF's Sqlite provider itself, so it is a
         second place the vulnerable native library enters the graph; the durable state DB holding real-sats
         bookkeeping runs on it. Keep the version in step across Chain, Server and Web. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkadeHeroes.Core\ArkadeHeroes.Core.csproj" />
    <ProjectReference Include="..\ArkadeHeroes.Shared\ArkadeHeroes.Shared.csproj" />
    <ProjectReference Include="..\ArkadeHeroes.Chain\ArkadeHeroes.Chain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
