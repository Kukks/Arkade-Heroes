@* Genome-driven procedural pixel creature, rendered by wwwroot/js/hero-render.js
   (deterministic — the same genome always renders identical pixels). The holographic
   card frame around this art lives in the card components' CSS, not here. *@
@using Microsoft.JSInterop
@inject IJSRuntime JS

<img class="hero-px" style="width:@(Size)px;height:@(Size)px;image-rendering:pixelated;display:block"
     src="@_src" alt="@($"{DisplayName} — pixel portrait")" draggable="false" />

@code {
    /// <summary>The hero to draw. Optional so a genome can be rendered without one — see
    /// <see cref="Genome"/>, which the landing page uses to show real creatures before anybody
    /// has signed in and there is no hero to fetch.</summary>
    [Parameter] public HeroDto? Hero { get; set; }

    /// <summary>A raw 64-char genome hex, used when no <see cref="Hero"/> is supplied. The renderer only
    /// ever reads the genome, so demanding a whole HeroDto for a decorative sprite would mean inventing
    /// stats, skills and provenance that nothing draws.</summary>
    [Parameter] public string? Genome { get; set; }

    /// <summary>Alt-text name when rendering a bare genome.</summary>
    [Parameter] public string? Name { get; set; }

    private string DisplayName => Hero?.Name ?? Name ?? "Hero";

    /// <summary>Rendered pixel size (square).</summary>
    [Parameter] public int Size { get; set; } = 112;

    // dataURL cache shared across every sprite instance, keyed by genome+size —
    // a large grid renders each unique genome only once.
    private static readonly Dictionary<string, string> _cache = new();
    private static Task<IJSObjectReference>? _module;
    private string? _src;

    protected override async Task OnParametersSetAsync()
    {
        var hex = Hero?.GenomeHex ?? Genome ?? string.Empty;
        var key = $"{hex}:{Size}";
        if (_cache.TryGetValue(key, out var cached)) { _src = cached; return; }
        try
        {
            _module ??= JS.InvokeAsync<IJSObjectReference>("import", "./js/hero-render.js").AsTask();
            var module = await _module;
            var src = await module.InvokeAsync<string>("renderHeroDataUrl", hex, Size, "menace");
            _cache[key] = src;
            _src = src;
        }
        catch
        {
            // Render/module error → blank art rather than a broken grid.
        }
    }
}
