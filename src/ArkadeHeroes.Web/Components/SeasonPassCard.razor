@inject GameSession Session
@inject WalletState State
@implements IDisposable

@* The season-long goal that carries on after the daily is claimed. Read-only: the pass pays TITLES, never
   sats, so there is nothing to claim here — the tier moves on its own as you play. *@
<div class="card">
    <div class="page-head" style="margin:0 0 .5rem">
        <h3 style="margin:0">Season pass</h3>
        @if (_pass is { Title: not null })
        {
            <span class="hud">🏅 @_pass.Title</span>
        }
        <span class="spacer"></span>
        @if (_pass is not null)
        {
            <span class="chip mono">tier @_pass.Tier / @_pass.MaxTier</span>
        }
    </div>

    @if (!State.IsSignedIn)
    {
        <p class="muted" style="margin:0">Press <a href="/">Play</a> to set up your wallet — then every duel, breed and clear counts toward the season.</p>
    }
    @* "Still reading" and "the read failed" used to be the same spinner. The only retry is a sign-in
       TRANSITION, and the shell resumes the session before you ever reach this card — so for an
       already-signed-in player it can never fire again and this sat on "reading your season…" for the
       rest of the session. The comment on the catch below claimed a retry that could not happen. *@
    else if (_error is not null)
    {
        <div class="status-line"><span class="dot bad"></span> Couldn't read your season.</div>
        <p class="muted" style="margin:.6rem 0 .7rem;font-size:.85rem">@_error</p>
        <button class="btn ghost sm" @onclick="LoadAsync" disabled="@_loading">Try again</button>
    }
    else if (_pass is null)
    {
        <div class="status-line"><span class="dot wait"></span> reading your season…</div>
    }
    else
    {
        <div class="track" style="height:.55rem;border-radius:999px;overflow:hidden;background:rgba(255,255,255,.08)">
            <div style="height:100%;width:@(PercentIntoTier)%;background:var(--gold)"></div>
        </div>
        <p class="muted" style="margin:.5rem 0 0;font-size:.85rem">
            @_pass.Points points this season ·
            @if (_pass.PointsToNextTier > 0)
            {
                <span>@_pass.PointsToNextTier to tier @(_pass.Tier + 1)</span>
                @if (_pass.NextTitle is not null)
                {
                    <span> · next title <b>@_pass.NextTitle</b></span>
                }
            }
            else
            {
                <span>pass complete — nothing left to climb</span>
            }
        </p>
        <p class="muted" style="margin:.5rem 0 0;font-size:.78rem">
            Won duels, death-matches and gauntlet clears score most; breeding and fusing also count.
            The pass pays titles, never sats.
        </p>
    }
</div>

@code {
    private SeasonPassProgress? _pass;
    private bool _wasSignedIn;
    private bool _loading;

    /// <summary>Why the season is missing, when it is missing because the read failed.</summary>
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        _wasSignedIn = State.IsSignedIn;
        await LoadAsync();
    }

    // Guard against divide-by-zero if the tier size is ever retuned to 0 in config.
    private int PercentIntoTier => _pass is null || SeasonPass.PointsPerTier <= 0
        ? 0
        : Math.Clamp(_pass.PointsIntoTier * 100 / SeasonPass.PointsPerTier, 0, 100);

    private async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _pass = null; _error = null; StateHasChanged(); return; }
        _loading = true;
        _error = null;
        StateHasChanged();
        try { _pass = await Session.SeasonPassAsync(); }
        catch (Exception ex) { _pass = null; _error = ex.Message; }
        finally { _loading = false; }
        StateHasChanged();
    }

    private void OnState() => InvokeAsync(async () =>
    {
        if (State.IsSignedIn != _wasSignedIn)
        {
            _wasSignedIn = State.IsSignedIn;
            await LoadAsync();
        }
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;
}
