@using ArkadeHeroes.Core.Progression
@implements IDisposable
@* A single hero as a holographic rarity card: pixel-creature portrait in a
   tier-framed, foil-sheened tile, with rarity pips + expressed-trait badges. *@

<a class="@CardClass" href="@($"heroes/{Hero.Id}")" style="--tier:var(--r-@(TierKey));--flare:@FlareColor">
    @if (_stage is not RevealStage.Open)
    {
        <span class="crawl-seal @(_stage is RevealStage.Opening ? "crawl-open" : "")">
            <span class="crawl-shell up"></span>
            <span class="crawl-shell dn"></span>
            <b>@SealLabel</b>
            <i>@SealNote</i>
        </span>
    }
    <div class="hero-tile tier-@TierIndex">
        <HeroSprite Hero="Hero" Size="118" />
        <span class="hero-foil"></span>
        <span class="hero-gen mono">GEN·@Hero.Generation</span>
        @if (Hero.IsSterile)
        {
            <span class="hero-sterile mono" title="sterile — cannot breed">⌀</span>
        }
    </div>
    <div class="hero-body">
        <div class="hero-head">
            <span class="hero-name">@Hero.Name</span>
            <span class="tier tag-@TierKey">@Tier</span>
        </div>
        <div class="rar-pips" title="@Tier">
            @for (var i = 0; i < 5; i++)
            {
                <span class="pip @(i <= TierIndex ? "on" : "")"></span>
            }
        </div>
        <div class="chips">
            @if (Hero.FancyTitle is not null)
            {
                <span class="chip" title="Fancy — a rare genome trait combination"
                      style="background:linear-gradient(90deg,#ffd76a,#ff7ac0);color:#1a1030;font-weight:700">✦ @Hero.FancyTitle</span>
            }
            @if (Hero.Generation == 0)
            {
                <span class="chip" title="Founder — a generation-0 original mint (the scarcest lineage)"
                      style="background:linear-gradient(90deg,#8fe3ff,#b98cff);color:#101030;font-weight:700">⚑ Founder</span>
            }
            else if (Provenance.Pedigree(Hero.Generation) is { } pedigree)
            {
                <span class="chip muted" title="Pedigree — this hero's breeding depth (generation @Hero.Generation)">⚜ @pedigree</span>
            }
            <span class="chip">lvl <b>@Hero.Level</b></span>
            <span class="chip">@Hero.Element</span>
            @if (Hero.Rarity is not null)
            {
                <span class="chip">rarity <b>@Hero.Rarity.Score</b></span>
            }
        </div>
        @if (Hero.Rarity is { Expressed.Count: > 0 })
        {
            <div class="trait-badges">
                @foreach (var t in Hero.Rarity.Expressed)
                {
                    <span class="tbadge tag-@t.Tier.ToLowerInvariant()" title="@t.Category · @t.Tier">@Abbrev(t.Category)</span>
                }
            </div>
        }
        <div class="statline mono">
            <span>HP @Hero.Stats.MaxHp</span>
            <span>ATK @Hero.Stats.Attack</span>
            <span>DEF @Hero.Stats.Defense</span>
            <span>SPD @Hero.Stats.Speed</span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public HeroDto Hero { get; set; } = default!;

    /// <summary>Play the dramatic "summon" reveal (a freshly bred/fused hero materialising).</summary>
    [Parameter] public bool Reveal { get; set; }

    /// <summary>Fusion tone — hot-red convergence energy instead of the calm rarity flare.</summary>
    [Parameter] public bool Fuse { get; set; }

    private string Tier => Hero.Rarity?.Tier ?? "Common";
    private string TierKey => Tier.ToLowerInvariant();

    private int TierIndex => Tier switch
    {
        "Legendary" => 4, "Epic" => 3, "Rare" => 2, "Uncommon" => 1, _ => 0,
    };

    private string CardClass =>
        $"hero-card{(Reveal ? " reveal" : "")}{(Fuse ? " fuse" : "")}{(_stage is RevealStage.Sealed ? " crawl-sealed" : "")}";

    // Summon-reveal flare: fusion burns hot-red; a birth glows in the hero's rarity colour.
    private string FlareColor => Fuse ? "var(--danger)" : $"var(--r-{TierKey})";

    // ── The seal ──────────────────────────────────────────────────────────────────────────────────────
    // The summon flare on its own was a flourish, not a reveal: the finished card was already on screen,
    // playing an entrance over a hero the player could read the whole time. Nothing was ever hidden, so
    // there was nothing to uncover. The card now arrives sealed — the shell holds for a beat, splits, and
    // only then does the existing summon play, on a hero you are seeing for the first time.
    private enum RevealStage { Sealed, Opening, Open }

    private const int SealHold = 1000;    // the shell holds, breathing on its seam
    private const int SealCrack = 480;    // matches @keyframes crawl-crack, so the card is uncovered as it blows

    private RevealStage _stage = RevealStage.Open;
    private string? _sealedFor;   // the hero this card has already unsealed — a second breed reuses the instance
    private bool _sealing;
    private int _sealRun;

    private string SealLabel => Fuse ? "FUSING" : "HATCHING";
    private string SealNote => Fuse ? "two burned · one forming" : "genome settling";

    protected override void OnParametersSet()
    {
        if (!Reveal || _sealedFor == Hero.Id) return;
        _sealedFor = Hero.Id;
        _stage = RevealStage.Sealed;
        _sealing = false;
        _sealRun++;               // strands a sequence still running for the previous hero
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Guarded on the stage rather than firstRender: the sprite resolves asynchronously, so this fires
        // again while the shell is still closed, and a second sequence would race the first.
        if (_stage is not RevealStage.Sealed || _sealing) return;
        _sealing = true;
        var run = _sealRun;

        await Task.Delay(SealHold);
        if (run != _sealRun) return;
        _stage = RevealStage.Opening;
        StateHasChanged();

        await Task.Delay(SealCrack);
        if (run != _sealRun) return;
        _stage = RevealStage.Open;
        _sealing = false;
        StateHasChanged();
    }

    // Navigating away mid-seal would otherwise leave a delay to wake up and render into a card that is no
    // longer on the page. Same guard the arena uses for a replay it is torn down in the middle of.
    public void Dispose() => _sealRun++;

    private static string Abbrev(string category) =>
        category.Length <= 3 ? category.ToUpperInvariant() : category[..3].ToUpperInvariant();
}
