@* A single hero, its "portrait" generated deterministically from its genome bytes. *@

<a class="@CardClass" href="@($"heroes/{Hero.Id}")" style="--flare:@FlareColor">
    <div class="hero-tile">
        <HeroSprite Hero="Hero" Size="118" />
        <span class="hero-gen mono">GEN·@Hero.Generation</span>
        @if (Hero.IsSterile)
        {
            <span class="hero-sterile mono" title="sterile — cannot breed">⌀</span>
        }
    </div>
    <div class="hero-body">
        <div class="hero-head">
            <span class="hero-name">@Hero.Name</span>
            <span class="tier tag-@Tier.ToLowerInvariant()">@Tier</span>
        </div>
        <div class="chips">
            <span class="chip">lvl <b>@Hero.Level</b></span>
            <span class="chip">@Hero.Element</span>
            @if (Hero.Rarity is not null)
            {
                <span class="chip">rarity <b>@Hero.Rarity.Score</b></span>
            }
        </div>
        <div class="statline mono">
            <span>HP @Hero.Stats.MaxHp</span>
            <span>ATK @Hero.Stats.Attack</span>
            <span>DEF @Hero.Stats.Defense</span>
            <span>SPD @Hero.Stats.Speed</span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public HeroDto Hero { get; set; } = default!;

    /// <summary>Play the dramatic "summon" reveal (a freshly bred/fused hero materialising).</summary>
    [Parameter] public bool Reveal { get; set; }

    /// <summary>Fusion tone — hot-red convergence energy instead of the calm rarity flare.</summary>
    [Parameter] public bool Fuse { get; set; }

    private string Tier => Hero.Rarity?.Tier ?? "Common";

    private string CardClass => $"hero-card{(Reveal ? " reveal" : "")}{(Fuse ? " fuse" : "")}";

    // The reveal flare colour: fusion burns hot-red; a birth glows in the hero's rarity colour.
    private string FlareColor => Fuse ? "var(--danger)" : $"var(--r-{Tier.ToLowerInvariant()})";
}
