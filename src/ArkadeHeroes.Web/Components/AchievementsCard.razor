@inject GameSession Session
@inject WalletState State
@implements IDisposable
@using ArkadeHeroes.Core.Progression

@* The signed-in player's milestone badges, shown on their roster. Read-only: every value is
   derived server-side from the roster + resolved tournaments (no per-event tracking). Earned state
   is authoritative from the server's Badges list; the counts only drive the "progress to goal" hint. *@
<div class="card">
    <div class="page-head" style="margin:0 0 .5rem">
        <h3 style="margin:0">Achievements</h3>
        @if (_ach is not null)
        {
            @* Denominator counts the badges this card can actually show. Any the server knows about and
               this file doesn't get added on, so the total can never be smaller than the earned count. *@
            <span class="hud">@_ach.Badges.Count / @(Defs.Length + UnknownBadges.Count()) badges</span>
        }
    </div>

    @if (!State.IsSignedIn)
    {
        <p class="muted" style="margin:0">Press <a href="/">Play</a> to summon a roster and start earning badges.</p>
    }
    @* "Still loading" and "the read failed" used to be the same spinner, with the only retry gated on a
       sign-in TRANSITION — which never happens again for a player who was already signed in. This page's
       whole body is this card, so /achievements spun forever with no error and no way out but F5. *@
    else if (_error is not null)
    {
        <div class="status-line"><span class="dot bad"></span> Couldn't tally your achievements.</div>
        <p class="muted" style="margin:.6rem 0 .7rem">@_error</p>
        <button class="btn primary sm" @onclick="LoadAsync" disabled="@_loading">Try again</button>
    }
    else if (_ach is null)
    {
        <div class="status-line"><span class="dot wait"></span> tallying your accomplishments…</div>
    }
    else
    {
        <p class="muted" style="margin:-.2rem 0 .7rem">Milestones you've unlocked across breeding, collecting, and the arena.</p>
        @foreach (var d in Defs)
        {
            var have = d.Have(_ach);
            var earned = _ach.Badges.Contains(d.Key);
            <div class="match-row">
                <span class="@(earned ? "" : "muted")">@d.Icon @d.Label</span>
                <span class="spacer"></span>
                @if (earned)
                {
                    <span class="chip on">✓ earned</span>
                }
                else
                {
                    <span class="chip">@Math.Min(have, d.Target)/@d.Target · @d.Goal</span>
                }
            </div>
        }

        @foreach (var key in UnknownBadges)
        {
            <div class="match-row">
                <span>🏅 @key</span>
                <span class="spacer"></span>
                <span class="chip on">✓ earned</span>
            </div>
        }

        <div class="page-head" style="margin:.9rem 0 .3rem">
            <h4 style="margin:0;font-size:.92rem">Fancy collection</h4>
            <span class="spacer"></span>
            <span class="hud">@_ach.FancySetsOwned.Count / @FancySets.AllTitles.Count sets</span>
        </div>
        <div class="chips">
            @foreach (var title in FancySets.AllTitles)
            {
                var owned = _ach.FancySetsOwned.Contains(title);
                <span class="chip @(owned ? "on" : "muted")" title="@(owned ? "collected" : "breed a genome that hits this set")">@(owned ? "✦" : "○") @title</span>
            }
        </div>

        @if (_ach.FancyEditions.Count > 0)
        {
            <div class="page-head" style="margin:.9rem 0 .3rem">
                <h4 style="margin:0;font-size:.92rem">Editions</h4>
                <span class="spacer"></span>
                <span class="hud">the Nth of its set ever found</span>
            </div>
            @foreach (var e in _ach.FancyEditions)
            {
                <div class="match-row">
                    <span>@(e.Edition == 1 ? "🥇" : "✦") <b>@e.Title</b> #@e.Edition</span>
                    <span class="spacer"></span>
                    <span class="muted">@e.HeroName</span>
                </div>
            }
        }

        <div class="page-head" style="margin:.9rem 0 .3rem">
            <h4 style="margin:0;font-size:.92rem">Trait album</h4>
            <span class="spacer"></span>
            <span class="hud">@_ach.TraitAlbum.Values.Sum() / @(_ach.TraitAlbum.Count * 5) cells</span>
        </div>
        @foreach (var kv in _ach.TraitAlbum)
        {
            <div class="match-row">
                <span class="@(kv.Value > 0 ? "" : "muted")">@kv.Key</span>
                <span class="spacer"></span>
                <span class="chip @(kv.Value == 5 ? "on" : "")">@kv.Value/5 tiers</span>
            </div>
        }
    }
</div>

@code {
    private PlayerAchievementsDto? _ach;
    private bool _wasSignedIn;
    private bool _loading;

    /// <summary>Why the tally is missing, when it is missing because the read failed rather than because it
    /// hasn't happened yet. Null while loading and once loaded.</summary>
    private string? _error;

    // Icon + goal copy per badge. Keys + targets mirror GameService.PlayerAchievements (server is
    // authoritative for the earned/unearned state via Badges; the target is a display hint only).
    private sealed record BadgeDef(string Key, string Icon, string Label, string Goal, int Target, Func<PlayerAchievementsDto, int> Have);

    private static readonly BadgeDef[] Defs =
    {
        new("Collector",     "📦", "Collector",     "own 5 heroes",          5, a => a.HeroesOwned),
        new("Breeder",       "🧬", "Breeder",       "breed 3 heroes",        3, a => a.HeroesBred),
        new("Legend-keeper", "💎", "Legend-keeper", "hold a Legendary",      1, a => a.Legendaries),
        new("Fancier",       "🎀", "Fancier",       "own a Fancy",           1, a => a.Fancies),
        new("Champion",      "🏆", "Champion",      "win a tournament",      1, a => a.TournamentsWon),
        // The server has awarded this since Fancy discovery became a permanent deed, and this list never
        // learned about it: the rarest badge in the game — first ever to breed a named set, credited for
        // good — was earned, returned, and drawn nowhere. The header counted it, so the card read
        // "6 / 5 badges" over five rows. There is no progress COUNT for it in the DTO (it is a one-shot
        // deed, not a tally), so its own earned state is the only thing to show against it.
        new("Trailblazer",   "🚩", "Trailblazer",   "discover a Fancy set first", 1,
            a => a.Badges.Contains("Trailblazer") ? 1 : 0),
    };

    /// <summary>
    /// Badges the SERVER awarded that this file has no definition for. Rendered rather than dropped: the
    /// list above is a client-side constant, and the last time the server grew a badge it simply vanished
    /// here and broke the counter. Now a new one shows up unstyled but present, and the count still adds up.
    /// </summary>
    private IEnumerable<string> UnknownBadges =>
        _ach is null ? [] : _ach.Badges.Where(b => !Defs.Any(d => d.Key == b));

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        _wasSignedIn = State.IsSignedIn;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _ach = null; _error = null; StateHasChanged(); return; }
        _loading = true;
        _error = null;
        StateHasChanged();
        try { _ach = await Session.AchievementsAsync(); }
        catch (Exception ex) { _ach = null; _error = ex.Message; }
        finally { _loading = false; }
        StateHasChanged();
    }

    // Reload when the sign-in token settles (same login-race the other cards handle), else just repaint.
    private void OnState()
    {
        if (State.IsSignedIn != _wasSignedIn)
        {
            _wasSignedIn = State.IsSignedIn;
            InvokeAsync(LoadAsync);
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => State.OnChange -= OnState;
}
