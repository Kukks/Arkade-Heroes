@* Procedural pixel icon for a gear/item id, rendered by wwwroot/js/item-render.js
   (deterministic off the id — the same item always renders identical pixels).
   The item-world companion to HeroSprite. *@
@using Microsoft.JSInterop
@inject IJSRuntime JS

<img class="item-px" style="width:@(Size)px;height:@(Size)px;image-rendering:pixelated;display:block"
     src="@_src" alt="@(ItemId?.Replace('-', ' '))" draggable="false" />

@code {
    [Parameter, EditorRequired] public string ItemId { get; set; } = default!;

    /// <summary>Rendered pixel size (square).</summary>
    [Parameter] public int Size { get; set; } = 40;

    // dataURL cache shared across every icon instance, keyed by id+size.
    private static readonly Dictionary<string, string> _cache = new();
    private static Task<IJSObjectReference>? _module;
    private string? _src;

    /// <summary>Which item+size <see cref="_src"/> currently holds art for.</summary>
    private string? _srcKey;

    protected override async Task OnParametersSetAsync()
    {
        var id = ItemId ?? string.Empty;
        var key = $"{id}:{Size}";
        if (_cache.TryGetValue(key, out var cached)) { _src = cached; _srcKey = key; return; }

        // Drop the old icon BEFORE rendering the new item — see the matching note in HeroSprite. _src was
        // only ever assigned, so a failed render left the previous item's art under the new item's name
        // and price, which on a shop grid is a picture of a thing you are not buying.
        if (_srcKey != key) { _src = null; _srcKey = key; }

        try
        {
            // Never cache a FAULTED import: _module is static, so one failure used to blank every icon in
            // the application for the rest of the session.
            var module = await (_module ??= JS.InvokeAsync<IJSObjectReference>("import", "./js/item-render.js").AsTask());
            var src = await module.InvokeAsync<string>("renderItemDataUrl", id, Size);
            _cache[key] = src;
            _src = src;
        }
        catch
        {
            // Render/module error → blank rather than a broken row, or the wrong row.
            if (_module is { IsFaulted: true }) _module = null;
        }
    }
}
