@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@implements IDisposable

@* The daily engagement loop, shared by the Home banner and the /daily page: today's quests,
   the streak, and a once-a-day sats claim. Signed-out shows the Play nudge.

   Renders nothing at all when the server has the faucet closed, which is how it ships. Offering a
   Claim button that is guaranteed to come back "not available on this server" would be worse than
   silence: it reads as a broken game rather than a feature this operator has not switched on. *@
@if (_faucetOpen)
{
<div class="card">
    <div class="page-head" style="margin:0 0 .5rem">
        <h3 style="margin:0">Daily rewards</h3>
        @if (_status is { Streak: > 0 })
        {
            <span class="hud">🔥 @(_status.Streak)-day streak</span>
        }
    </div>

    @if (!State.IsSignedIn)
    {
        <p class="muted" style="margin:0">Press <a href="/">Play</a> to set up your wallet, then claim daily sats for playing.</p>
    }
    @* "Still loading" and "the read failed" used to be the same spinner, with the only retry gated on a
       sign-in TRANSITION that can never fire again for an already-signed-in player. The nastiest path was
       the success one: a claim LANDS, the reload after it throws, _status goes null — and the card
       collapses into a permanent spinner that also swallows the "+50 sat!" confirmation. This card already
       had an _error field; it was only ever used for claim failures, never for load failures. *@
    else if (_loadError is not null)
    {
        <div class="status-line"><span class="dot bad"></span> Couldn't load today's quests.</div>
        <p class="muted" style="margin:.6rem 0 .7rem;font-size:.85rem">
            @if (_flash is not null)
            {
                <text><b>@_flash</b> — that part did land. </text>
            }
            @_loadError
        </p>
        <button class="btn ghost sm" @onclick="LoadAsync" disabled="@_loading">Try again</button>
    }
    else if (_status is null)
    {
        <div class="status-line"><span class="dot wait"></span> loading today's quests…</div>
    }
    else
    {
        <p class="muted" style="margin:-.2rem 0 .7rem">Finish a quest, claim sats. Resets in @ResetsIn(_status.DayEndsUnix).</p>
        @foreach (var q in _status.Quests)
        {
            <div class="match-row">
                <span class="@(q.Done ? "" : "muted")">@(q.Done ? "✓" : "▢") @q.Title</span>
                <span class="spacer"></span>
                <span class="chip">+@q.BonusSats sat</span>
            </div>
        }
        <div class="btn-row" style="margin-top:.8rem;align-items:center;gap:.8rem">
            @if (_status.ClaimedToday)
            {
                <span class="status-line"><span class="dot ok"></span> Claimed today — come back tomorrow.</span>
            }
            else if (!_status.HasHero)
            {
                <span class="status-line">
                    <span class="dot wait"></span>
                    The daily reward goes to players, not empty wallets — get a hero on the
                    <a href="heroes?mine=1">Heroes</a> page and it is yours to claim.
                </span>
            }
            else
            {
                <button class="btn primary" @onclick="Claim" disabled="@_claiming">
                    @(_claiming ? "Claiming…" : $"Claim {_status.ClaimableNowSats:N0} sat")
                </button>
            }
            @if (_flash is not null)
            {
                <span class="status-line"><span class="dot ok"></span> @_flash</span>
            }
        </div>
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.5rem"><span class="dot bad"></span> @_error</div>
        }
    }
</div>
}

@code {
    private DailyStatusDto? _status;
    private bool _claiming;
    private bool _wasSignedIn;
    private string? _flash;
    private string? _error;
    private bool _loading;

    /// <summary>Why today's quests are missing, when they are missing because the read failed rather than
    /// because it hasn't happened yet. Kept separate from <see cref="_error"/>, which reports a failed
    /// CLAIM and renders inside the loaded card.</summary>
    private string? _loadError;

    /// <summary>Whether this server pays a daily reward at all. Defaults to hidden, so a server we
    /// cannot reach shows nothing rather than a button that cannot work.</summary>
    private bool _faucetOpen;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        _wasSignedIn = State.IsSignedIn;
        try { _faucetOpen = (await Api.Chain.InfoAsync()).Config?.DailyRewardEnabled ?? false; }
        catch { _faucetOpen = false; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!_faucetOpen || !State.IsSignedIn) { _status = null; _loadError = null; StateHasChanged(); return; }
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try { _status = await Session.DailyStatusAsync(); }
        catch (Exception ex) { _status = null; _loadError = ex.Message; }
        finally { _loading = false; }
        StateHasChanged();
    }

    private async Task Claim()
    {
        if (_claiming) return;
        _claiming = true; _error = null; _flash = null;
        try
        {
            var result = await Session.ClaimDailyAsync();
            _flash = $"+{result.AwardedSats:N0} sat! Streak {result.Streak}.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _claiming = false; }
    }

    // Reload when the sign-in token settles (same login-race the other pages handle), else just repaint.
    private void OnState()
    {
        if (State.IsSignedIn != _wasSignedIn)
        {
            _wasSignedIn = State.IsSignedIn;
            InvokeAsync(LoadAsync);
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    static string ResetsIn(long endsAtUnix)
    {
        var left = DateTimeOffset.FromUnixTimeSeconds(endsAtUnix) - DateTimeOffset.UtcNow;
        if (left <= TimeSpan.Zero) return "moments";
        return left.TotalHours >= 1 ? $"{(int)left.TotalHours}h" : $"{(int)left.TotalMinutes}m";
    }

    public void Dispose() => State.OnChange -= OnState;
}
