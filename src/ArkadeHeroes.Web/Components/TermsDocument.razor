@inject HttpClient Http
@inject NavigationManager Nav

@* The Terms of Use, rendered from the copy of docs/TERMS.md the build bundles into wwwroot. Used BOTH
   inside the acceptance modal (so the terms are readable without navigating away and losing progress) and
   on the standalone /terms page, so a player reads exactly the same text before and after accepting. *@

@if (_state == Load.Loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the terms…</div>
}
else if (_state == Load.Missing)
{
    @* Honest about it rather than showing a blank box: a build without the document must not look like a
       build whose terms happen to be empty. *@
    <div class="status-line"><span class="dot bad"></span> The Terms of Use document isn't bundled with this build.</div>
    <p class="muted">
        Read it in the repository at <span class="mono">@Terms.DocumentPath</span> before you accept.
        You are being asked to accept <b>version @Terms.CurrentVersion</b>.
    </p>
}
@* "The fetch failed" and "this build shipped without the document" are different facts with different
   answers, and collapsing them was a hard lockout: the gate fails CLOSED on anything that isn't Ready, has
   no ✕ and no click-outside, and rides the layout on EVERY route — so one timed-out GET of a static file
   left the player unable to accept, unable to dismiss, and told by the gate's own copy to "report it rather
   than working around it". A transient network fault is not a packaging fault; it just needs another go. *@
else if (_state == Load.Failed)
{
    <div class="status-line"><span class="dot bad"></span> Couldn't load the Terms of Use.</div>
    <p class="muted">
        This looks like a network problem rather than a missing document — nothing is wrong with your
        account, and nothing has been recorded. @_error
    </p>
    <button class="btn primary sm" @onclick="RetryAsync" disabled="@(_state == Load.Loading)">Try again</button>
}
else
{
    <div class="terms-doc">@((MarkupString)_html)</div>
}

@code {
    /// <summary><see cref="Missing"/> means the build genuinely didn't ship the document — a packaging
    /// fault, and retrying will not help. <see cref="Failed"/> means the request itself fell over, which
    /// retrying very often does fix. Both keep Accept disabled; only one is worth a button.</summary>
    enum Load { Loading, Ready, Missing, Failed }
    Load _state = Load.Loading;
    string _html = "";
    string? _error;

    /// <summary>
    /// Raised with true once the terms are actually on screen, false while they are loading or couldn't be
    /// loaded at all. The acceptance gate binds its Accept button to this: a player cannot agree to a
    /// document they were never shown, so "we couldn't display the terms" has to mean "you can't accept
    /// them", not "accept them anyway".
    /// </summary>
    [Parameter] public EventCallback<bool> OnLoadStateChanged { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Re-runs the fetch after a failure. Re-raises the load-state event either way, so the gate's
    /// Accept button follows a successful retry without needing to be re-created.</summary>
    async Task RetryAsync()
    {
        _state = Load.Loading;
        _error = null;
        StateHasChanged();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        try
        {
            // Absolute against the APP's own origin: the injected HttpClient points at the game API, and the
            // bundled document is served next to index.html, not by the API.
            var url = new Uri(new Uri(Nav.BaseUri), Terms.BundledDocumentPath);
            var text = await Http.GetStringAsync(url);

            // The dev server answers a missing static file with index.html rather than a 404, so an HTML
            // body here means "not bundled", not "these are your terms".
            var head = text.TrimStart();
            if (head.Length == 0 ||
                head.StartsWith("<!DOCTYPE", StringComparison.OrdinalIgnoreCase) ||
                head.StartsWith("<html", StringComparison.OrdinalIgnoreCase))
            {
                _state = Load.Missing;
                return;
            }

            _html = MarkdownLite.ToHtml(text);
            _state = Load.Ready;
        }
        catch (Exception ex)
        {
            // Deliberately every exception, not just HttpRequestException: a request timeout
            // (TaskCanceledException) or any other fault must be caught rather than escape and strand the
            // component on "loading…" — which, before the gate consulted this state, left a player able to
            // accept a document that was still in flight.
            //
            // But it lands in Failed, not Missing. A thrown request says nothing about whether the file was
            // bundled, and treating it as a packaging fault is what turned a network blip into a permanent,
            // undismissable lockout from the whole application.
            _state = Load.Failed;
            _error = ex.Message;
        }
        finally
        {
            await OnLoadStateChanged.InvokeAsync(_state == Load.Ready);
        }
    }
}
