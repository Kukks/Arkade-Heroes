@inherits LayoutComponentBase
@inject WalletState Wallet
@inject GameWallet GameWallet
@inject GameSession Session
@implements IDisposable

<div class="app">
    <header class="topbar">
        <span class="brand">ARKADE<b>·</b><em>HEROES</em></span>
        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All">Arena</NavLink>
            <NavLink href="heroes">Heroes</NavLink>
            <NavLink href="breed">Breed</NavLink>
            <NavLink href="merge">Merge</NavLink>
            <NavLink href="market">Market</NavLink>
            <NavLink href="leaderboard">Ranks</NavLink>
            <NavLink href="wallet">Wallet</NavLink>
        </nav>
        <span class="spacer"></span>
        <a class="pill @(Wallet.Connected ? "on" : "")" href="wallet" title="@(Wallet.Connected ? Wallet.ActiveAddress : "Create or import a wallet")">
            <span class="dot"></span>
            @if (Wallet.Connected)
            {
                <span class="mono">@Wallet.ShortAddress</span>
                <b class="bal">@Wallet.BalanceSats.ToString("N0") sat</b>
            }
            else
            {
                <span>no wallet</span>
            }
        </a>
    </header>

    <div class="content">
        @Body
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Wallet.OnChange += OnWalletChanged;

        // Bootstrap the pill from any wallet already in the tab's SQLite store, so the
        // shell reflects the real wallet on every page (the Wallet page keeps it fresh).
        if (!Wallet.Connected)
        {
            var wallet = await GameWallet.GetActiveWalletAsync();
            if (wallet is not null)
            {
                var address = await GameWallet.GetReceiveAddressAsync(wallet.Id);
                Wallet.SetActiveWallet(wallet.Id, address);
                Wallet.UpdateBalance(await GameWallet.GetBalanceAsync(wallet.Id));
                // Resume the game session (sign in with the wallet) if it's a registered player.
                await Session.ResumeAsync();
            }
        }
    }

    void OnWalletChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Wallet.OnChange -= OnWalletChanged;
}
