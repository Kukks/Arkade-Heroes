@inherits LayoutComponentBase

<div class="app">
    <header class="topbar">
        <span class="brand">ARKADE<b>·</b><em>HEROES</em></span>
        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All">Arena</NavLink>
            <NavLink href="heroes">Heroes</NavLink>
            <NavLink href="market">Market</NavLink>
            <NavLink href="leaderboard">Ranks</NavLink>
            <NavLink href="wallet">Wallet</NavLink>
        </nav>
        <span class="spacer"></span>
        <span class="pill @(WalletState.Connected ? "on" : "")">
            <span class="dot"></span>
            @(WalletState.Connected ? WalletState.ShortAddress : "no wallet")
        </span>
    </header>

    <div class="content">
        @Body
    </div>
</div>

@code {
    // Placeholder until the in-browser wallet lands (P2). Kept here so the shell
    // already reflects a real connection state rather than a hard-coded string.
    private static class WalletState
    {
        public static bool Connected => false;
        public static string ShortAddress => "";
    }
}
