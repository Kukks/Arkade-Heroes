@inherits LayoutComponentBase
@inject WalletState Wallet
@inject GameWallet GameWallet
@inject GameSession Session
@inject TermsState Acceptance
@inject NavigationManager Nav
@implements IDisposable

<div class="app">
    <header class="topbar">
        <span class="brand">ARKADE<b>·</b><em>HEROES</em></span>
        <nav class="nav">
            @* Game-first: only the three game sections live in the nav. The wallet is a
               lower-level system — it's reachable from the subtle pill on the right, not here. *@
            <NavLink href="" Match="NavLinkMatch.All">Arena</NavLink>
            <a href="heroes" class="@(Section == "heroes" ? "active" : "")">Heroes</a>
            <a href="market" class="@(Section == "market" ? "active" : "")">Market</a>
        </nav>
        <span class="spacer"></span>
        <a class="pill @(Wallet.Connected ? "on" : "")" href="wallet" title="@(Wallet.Connected ? Wallet.ActiveAddress : "Set up automatically when you press Play")">
            <span class="dot"></span>
            @if (Wallet.Connected)
            {
                <span class="mono">@Wallet.ShortAddress</span>
                <b class="bal">@Wallet.BalanceSats.ToString("N0") sat</b>
            }
            else
            {
                <span>no wallet</span>
            }
        </a>
    </header>

    @if (_subnav.Length > 0)
    {
        <nav class="subnav">
            @foreach (var tab in _subnav)
            {
                <NavLink href="@tab.Href" Match="@tab.Match">@tab.Label</NavLink>
            }
        </nav>
    }

    @if (Wallet.BackupPending)
    {
        @* Non-custodial safety: the wallet was auto-created during "Play"; nudge to back it up. *@
        <div class="backup-nudge">
            <span class="dot bad"></span>
            <span>Your account isn't backed up yet — save your recovery phrase so you never lose your heroes.</span>
            <a class="btn ghost sm" href="wallet">Back up now</a>
            <button class="nudge-x" @onclick="() => Wallet.SetBackupPending(false)" title="Dismiss">✕</button>
        </div>
    }

    <div class="content">
        @Body
    </div>

    <footer class="footer">
        <span class="muted">Real bitcoin. Permanent losses. Non-custodial — your keys, your risk.</span>
        <span class="spacer"></span>
        <a href="terms">Terms of Use</a>
    </footer>
</div>

@* Lives in the layout so it covers every route: a signed-in player whose recorded acceptance predates the
   current terms is asked again wherever they are, not only if they happen to pass through the home page. *@
<TermsGate />

@code {
    private string _path = "";
    private (string Label, string Href, NavLinkMatch Match)[] _subnav = [];

    // The active top-level section, so the parent nav item stays lit across its sub-pages.
    private string Section => _path switch
    {
        "" => "arena",
        "market" or "sell" => "market",
        "wallet" => "wallet",
        var p when p == "heroes" || p.StartsWith("heroes/")
                   || p is "spar" or "gauntlet" or "trials" or "duel" or "deathmatch" or "breed" or "merge" or "gear" or "leaderboard" or "daily" or "squad" or "tournaments" => "heroes",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        Wallet.OnChange += OnWalletChanged;
        Nav.LocationChanged += OnLocationChanged;
        UpdateSection();

        // Bootstrap the pill from any wallet already in the tab's SQLite store, so the
        // shell reflects the real wallet on every page (the Wallet page keeps it fresh).
        if (!Wallet.Connected)
        {
            var wallet = await GameWallet.GetActiveWalletAsync();
            if (wallet is not null)
            {
                // The address and the balance both need the Arkade node, and resuming needs the game
                // server. NONE of them may abort this bootstrap. They used to: an unreachable node threw
                // out of OnInitializedAsync, so every line below it was skipped — including
                // Acceptance.HydrateFor, which re-asked players to accept terms they had ALREADY
                // accepted — and Blazor put "A glitch in the arcade" over an otherwise working page.
                // Each failure is already logged by the failing call; here we only degrade the display.
                //
                // VERIFIED with a wallet in storage and the node stopped: no error banner, no console
                // errors, the page renders. NOT verified: that the SESSION survives. With no address the
                // header still reads "no wallet" and the roster showed "2 minted" rather than "2 yours",
                // so something downstream of the address still gates sign-in. Guarding here is strictly
                // better than crashing, but it is not yet a full offline-tolerant boot.
                string? address = null;
                try { address = await GameWallet.GetReceiveAddressAsync(wallet.Id); }
                catch (Exception) { /* header shows the wallet without an address until the node answers */ }

                Wallet.SetActiveWallet(wallet.Id, address);
                Wallet.HydrateBackupPending();   // re-light the backup nudge if this wallet's phrase is still unsaved
                // Read back what THIS wallet accepted, so a returning player isn't re-asked on every page
                // load — and, just as importantly, so a different wallet in the same browser doesn't inherit
                // the previous one's answer. The SERVER record still overrules once they're signed in.
                Acceptance.HydrateFor(wallet.Id);

                try { Wallet.UpdateBalance(await GameWallet.GetBalanceAsync(wallet.Id)); }
                catch (Exception) { /* balance stays unknown rather than taking the shell down with it */ }

                // Resume the game session (sign in with the wallet) if it's a registered player.
                try { await Session.ResumeAsync(); }
                catch (Exception) { /* unreachable server leaves them signed out, not crashed */ }
            }
        }
    }

    private void UpdateSection()
    {
        _path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        _subnav = Section switch
        {
            "heroes" =>
            [
                ("Roster", "heroes", NavLinkMatch.All),
                ("Daily", "daily", NavLinkMatch.Prefix),
                ("Spar", "spar", NavLinkMatch.Prefix),
                ("Gauntlet", "gauntlet", NavLinkMatch.Prefix),
                ("Trials", "trials", NavLinkMatch.Prefix),
                ("Duel", "duel", NavLinkMatch.Prefix),
                ("Squad", "squad", NavLinkMatch.Prefix),
                ("Tournaments", "tournaments", NavLinkMatch.Prefix),
                ("Death-match", "deathmatch", NavLinkMatch.Prefix),
                ("Breed", "breed", NavLinkMatch.Prefix),
                ("Merge", "merge", NavLinkMatch.Prefix),
                ("Gear", "gear", NavLinkMatch.Prefix),
                ("Ranks", "leaderboard", NavLinkMatch.Prefix),
            ],
            "market" =>
            [
                ("Browse", "market", NavLinkMatch.All),
                ("Sell", "sell", NavLinkMatch.Prefix),
            ],
            _ => [],
        };
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(() => { UpdateSection(); StateHasChanged(); });

    void OnWalletChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Wallet.OnChange -= OnWalletChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
