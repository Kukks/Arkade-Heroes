<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!--
      Trimming off. Blazor WASM turns it on for Release publish, and the content pack cannot survive it:
      ContentPackLoader binds items.json / dungeons.json through reflection-based System.Text.Json and then
      REJECTS anything that fails to bind ("unknown field, or broken invariant — bad content must never load
      silently"). Trimming removes the property metadata that binding needs, so the reject fires, throws out
      of ContentPack.Default's initializer, and every static that touches it — Gauntlet.Content among them —
      dies as TypeInitializationException.

      Only in published builds, which is why a local build and the whole unit suite are clean. The cost is a
      larger download; the alternative is a trimmer descriptor listing every content type by hand, which is
      the same guarantee maintained by remembering to update it.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Native WASM build: required for Bit.Besql's in-browser SQLite (the non-custodial
         wallet's EF Core storage, persisted to browser storage / IndexedDB). -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
    <PackageReference Include="Bit.Besql" Version="10.4.3" />
    <!-- Patched native SQLite for CVE-2025-6965 — full reasoning in ArkadeHeroes.Chain.csproj. This is the
         copy that matters most: it is the SQLite the NON-CUSTODIAL WALLET runs on, in the player's own
         browser, holding the keys to their heroes and their sats. Bit.Besql brings the vulnerable native
         library in here independently of EF, so the pin has to be named on this project too.
         3.50.3 ships runtimes/browser-wasm/nativeassets/net9.0/e_sqlite3.a, which is the asset this
         net10.0 WASM build already resolved out of 2.1.11 — neither version ships a net10.0 one. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <!--
    Keep MSBuild out of the browser bundle.

    Cel 0.3.2, reached through NArk.Core, declares Antlr4BuildTasks as an ordinary dependency, but that
    package is an MSBuild task that only runs while Cel itself is built: Cel.dll's assembly references
    are Antlr4.Runtime.Standard 4.13.1 and no other ANTLR assembly. Because the dependency is not marked
    private it flows downstream and brings MSBuild with it, which the IL trimmer will not remove — it
    trims inside assemblies, it does not drop one the closure declares. That is also why the WASM SDK
    warned (WASM0001) about a p/invoke for Microsoft.Build.Framework's GetModuleFileName, a Win32 entry
    point, on a browser target.

    Consuming nothing from them here drops them and their tail from the published bundle. All three need
    naming: ExcludeAssets only drops the assets of the package it is written on, not that package's own
    dependencies, so excluding Antlr4BuildTasks alone leaves MSBuild behind. Pruning the subtree in one
    stroke is something only Cel, as the declaring package, can do.

    Deliberately scoped to this project rather than a root Directory.Build.props: this is the only
    project that publishes to a browser, and ArkadeHeroes.Server legitimately needs a NEWER
    Microsoft.Build.Framework for Microsoft.EntityFrameworkCore.Design's design-time tooling — pinning
    it repo-wide is an NU1605 downgrade there.
  -->
  <ItemGroup>
    <PackageReference Include="Antlr4BuildTasks" Version="12.10.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.3" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.9.5" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Bundle the Terms of Use so the browser can render them inside the acceptance gate and at /terms, without
    the player navigating away to a repo file. docs/TERMS.md stays the single source: this copies it, it does
    not duplicate it, so an edit there is what ships (bump Shared/Terms.CurrentVersion alongside it).

    Conditional on the file existing so a checkout without the document still builds — the acceptance
    mechanism does not depend on the prose being present, and TermsDocument says so plainly when it isn't.
  -->
  <!--
    COPY it into wwwroot rather than Link-ing it. A <Content Include> with a wwwroot Link and
    CopyToOutputDirectory lands the file in bin/**/wwwroot but never registers it as a STATIC WEB ASSET,
    which is what Blazor WASM actually serves from. The result is a 200 with Content-Length 0 at
    /terms.md, TermsDocument correctly reporting "not bundled", and — because the acceptance gate fails
    closed — onboarding blocked entirely. Verified in a browser before and after this change.

    Generated, not committed (see .gitignore): docs/TERMS.md stays the single source, so an edit there is
    what ships. Bump Shared/Terms.CurrentVersion alongside a material edit.

    Conditional on the source existing so a checkout without the document still builds — the acceptance
    mechanism does not depend on the prose being present, and TermsDocument says so plainly when it isn't.
  -->
  <Target Name="BundleTermsDocument"
          BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\docs\TERMS.md')"
          Inputs="$(MSBuildThisFileDirectory)..\..\docs\TERMS.md"
          Outputs="$(MSBuildThisFileDirectory)wwwroot\terms.md">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\docs\TERMS.md"
          DestinationFiles="$(MSBuildThisFileDirectory)wwwroot\terms.md"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ArkadeHeroes.Client.Sdk\ArkadeHeroes.Client.Sdk.csproj" />
    <!-- The full non-custodial NArk wallet, running in the browser (REST transport to arkd, no relay). -->
    <ProjectReference Include="..\..\external\dotnet-sdk\NArk.Core\NArk.Core.csproj" />
    <ProjectReference Include="..\..\external\dotnet-sdk\NArk.Storage.EfCore\NArk.Storage.EfCore.csproj" />
  </ItemGroup>

</Project>
