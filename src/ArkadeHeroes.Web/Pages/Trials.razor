@page "/trials"
@using ArkadeHeroes.Core.Progression
@* This page's component class is itself named `Trials`, which shadows the domain class — alias past it. *@
@using TrialsRules = ArkadeHeroes.Core.Progression.Trials
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Trials · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Trials</h2>
    <span class="hud">endless solo ladder · how deep can you go?</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then take on the Trials.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading your heroes…</div>
}
@* "You have no heroes" and "we never managed to read your roster" are different facts, and this
   branch used to state the first while meaning either. A load that returns early because sign-in has
   not resumed yet, or one that throws and is swallowed, both leave _mine empty — and the page then
   told a player with a full roster to go and claim starters. Only _heroesLoaded distinguishes them. *@
else if (!_heroesLoaded)
{
    <div class="card muted">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your roster.</div>
        <p class="muted" style="margin:.6rem 0 0">
            If you're signed in, reload the page. If not, <a href="wallet">sign in with your wallet</a>.
        </p>
    </div>
}
else if (_mine.Count == 0)
{
    @* ?mine=1: the roster opens on the ALL tab and the recruit card only renders under Mine. *@
    <div class="card muted">You need a hero first — recruit one on the <a href="heroes?mine=1">Heroes</a> page.</div>
}
else
{
    <div class="card">
        <p class="muted" style="margin-top:0">
            An endless ladder of ghost challengers: <b>wave N is a level-N ghost</b>, climbing until one of
            them finally puts your hero down. Your score is how many waves you survive — a straight read of
            how strong your hero really is. <b>Free to enter, run it as often as you like</b>: the Trials
            award no XP, gear, or sats, only a score and a title.
        </p>
        <div class="status-line" style="margin:-.3rem 0 .9rem">
            <span class="dot ok"></span>
            <span><b>This week:</b> @TrialsRules.AffixDescription(_weekAffix)</span>
        </div>
        <label>Champion
            <select @bind="_heroId">
                <option value="">— pick a hero —</option>
                @foreach (var h in _mine)
                {
                    <option value="@h.Id">@h.Name — lvl @h.Level · @(h.Rarity?.Tier ?? "Common")</option>
                }
            </select>
        </label>
        <button class="btn primary" style="margin-top:1.1rem" @onclick="DoRun"
                disabled="@(_running || string.IsNullOrEmpty(_heroId))">
            @(_running ? "Descending…" : "Enter the Trials")
        </button>
        @if (_status is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div>
        }
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div>
        }
    </div>

    @* The descent runs first and alone: the score, the title and the depth the run ended at are all in
       the summary below, so showing it while the hero is still climbing down would answer the only
       question the crawl is asking. *@
    @if (_outcome is not null && _crawling)
    {
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Descending…</h3>
            <span class="hud">under @_outcome.Run.Affix</span>
        </div>
        <CrawlTrack Rungs="_rungs" Focus="_focus" Revealed="_revealed" Label="how deep can you go" OnSkip="SkipCrawl" />
    }
    else if (_outcome is not null)
    {
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">@(_outcome.Run.Title ?? "Run over")</h3>
            <span class="hud">@_outcome.Run.WavesCleared wave@(_outcome.Run.WavesCleared == 1 ? "" : "s") survived</span>
            <span class="hud">under @_outcome.Run.Affix</span>
            <span class="spacer"></span>
            <span class="chip mono">best @_outcome.Run.BestScore</span>
        </div>

        <div class="card">
            <div class="status-line">
                <span class="dot @(_outcome.Run.WavesCleared >= _outcome.Run.BestScore ? "ok" : "wait")"></span>
                <span>
                    <b>@_outcome.Run.WavesCleared</b> survived
                    @if (_outcome.Run.Title is not null)
                    {
                        <span>· earned <b>@_outcome.Run.Title</b></span>
                    }
                    @if (_outcome.Run.WavesCleared >= _outcome.Run.BestScore && _outcome.Run.WavesCleared > 0)
                    {
                        <span> · <b>new personal best!</b></span>
                    }
                </span>
            </div>
            <div class="status-line" style="margin-top:.7rem">
                <span class="dot @(_outcome.FairnessOk ? "ok" : "bad")"></span>
                <span class="mono" style="font-size:.78rem">
                    @(_outcome.FairnessOk ? $"fairness ✓ {_outcome.FairnessDetail}" : $"fairness ✗ server cheated: {_outcome.FairnessDetail}")
                </span>
            </div>
        </div>

        @if (_watching is not null)
        {
            <div class="status-line" style="justify-content:center;gap:.7rem;margin:1.2rem 0 .5rem">
                <span class="chip mono">Wave @_watching.Wave</span>
                <span class="muted">ghost L@(_watching.GhostLevel)</span>
                <button class="btn ghost sm" @onclick="StopWatching">Close ✕</button>
            </div>
            <BattleArena A="_outcome.Run.HeroSnapshot" B="_watching.Ghost" Fight="_watching.Result" />
        }

        <div class="page-head" style="margin-top:1.4rem">
            <h3 style="margin:0">The ladder</h3>
            <span class="hud">click any wave to watch it</span>
        </div>
        @* The same rail the descent ran down, opened out — the shape of the run is the record of it, and a
           grid of identical cards was never that. Every wave keeps its own replay. *@
        <CrawlTrack Rungs="_rungs" Focus="@(_rungs.Count - 1)" Revealed="_rungs.Count" Settled="true" OnWatch="WatchIndex" />
    }
}

@code {
    private List<HeroDto> _mine = new();
    private string _heroId = "";
    private bool _loading = true;
    private bool _running;
    private bool _heroesLoaded;
    private string? _status;
    private string? _error;
    private TrialsOutcome? _outcome;
    private TrialsWaveDto? _watching;   // the wave currently replaying in the arena (null = none)
    private List<CrawlTrack.CrawlRung> _rungs = new();
    private bool _crawling;             // true while the run is descending the rail, before the summary
    private int _focus;                 // the rung the descent is standing on
    private int _revealed;              // rungs whose outcome has been stamped
    private int _crawlId;               // guards a stale descent from stepping a newer run's
    // The affix is a pure function of the clock, so the browser derives this week's rule itself — no extra
    // call. The run's OWN pinned affix (_outcome.Run.Affix) stays authoritative once a run resolves.
    private readonly TrialsAffix _weekAffix = TrialsRules.AffixFor(DateTimeOffset.UtcNow);

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            _heroesLoaded = true;
        }
        catch
        {
            // A swallowed read used to leave the page permanently empty: OnState only re-runs on the NEXT
            // state change, and a server hiccup produces none — so a one-off failure looked exactly like
            // owning no heroes, forever. Retry on our own rather than waiting for an event that may never
            // come. Short backoff; the sign-in path still covers the not-yet-authenticated case.
            await RetryLoadAsync();
        }
        finally { _loading = false; }
    }

    async Task DoRun()
    {
        _running = true;
        _error = null;
        _outcome = null;
        _watching = null;
        _status = "Preparing the ladder…";
        try
        {
            _outcome = await Session.RunTrialsAsync(_heroId, s => { _status = s; StateHasChanged(); });
            _status = null;
            _rungs = _outcome.Run.Waves
                .Select(w => new CrawlTrack.CrawlRung(w.Wave, w.GhostLevel, w.Won)).ToList();
            // Held inside the try so the button stays "Descending…" for the whole descent — a second run
            // started underneath one already running is a race nobody asked for.
            await DescendAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>
    /// The descent. The run is already decided — every wave came back resolved in one call — so this is
    /// pacing, not scoring: rung by rung down the rail, with each outcome landing a beat AFTER the rung
    /// does, so a wave gets a moment of being unresolved instead of arriving pre-answered.
    ///
    /// <para>An endless run can be dozens of waves, which is why the fights are not replayed blow by blow
    /// the way the Gauntlet's five are — the arena is still one click away on any rung.</para>
    /// </summary>
    async Task DescendAsync()
    {
        if (_rungs.Count == 0) return;
        var run = ++_crawlId;

        // Under reduced motion there is nothing left of a descent that is made of waiting.
        if (await Motion.PrefersReducedAsync(JS) || run != _crawlId) { Settle(); return; }

        _crawling = true;
        _focus = 0;
        _revealed = 0;
        StateHasChanged();
        await Task.Delay(420);              // a beat at the mouth of the shaft
        if (run != _crawlId) return;

        for (var i = 0; i < _rungs.Count; i++)
        {
            _focus = i;
            StateHasChanged();
            var (beat, hold) = PaceFor(i, _rungs.Count);
            await Task.Delay(beat);         // the fight, happening in the dark
            if (run != _crawlId) return;
            _revealed = i + 1;              // ...and then its mark
            StateHasChanged();
            await Task.Delay(hold);
            if (run != _crawlId) return;
        }

        _crawling = false;
        StateHasChanged();
    }

    // Quick through the shallows every hero clears, slowing over the last three rungs: a ladder that stops
    // abruptly reads as a glitch, and one that stops slowly reads as a fight the hero nearly won.
    static (int Beat, int Hold) PaceFor(int i, int count)
    {
        var fromEnd = count - 1 - i;
        if (fromEnd == 0) return (700, 850);
        if (fromEnd == 1) return (300, 150);
        if (fromEnd == 2) return (230, 120);
        var beat = Math.Max(60, 175 - i * 7);
        return (beat, Math.Max(40, beat / 2));
    }

    void SkipCrawl() { _crawlId++; Settle(); StateHasChanged(); }

    // Everywhere the descent was going to end up, ended up.
    void Settle()
    {
        _crawling = false;
        _focus = Math.Max(0, _rungs.Count - 1);
        _revealed = _rungs.Count;
    }

    // The rail hands back the rung's index; the wave behind it is the one to replay.
    void WatchIndex(int index)
    {
        if (_outcome is null || index < 0 || index >= _outcome.Run.Waves.Count) return;
        _watching = _outcome.Run.Waves[index];
        StateHasChanged();
    }

    void StopWatching() { _watching = null; StateHasChanged(); }

    void OnState() => InvokeAsync(async () =>
    {
        // On a fresh page load the session resumes after this component inits; reload the
        // roster once we're signed in (the first MineAsync may have raced the login token).
        if (State.IsSignedIn && !_heroesLoaded && !_loading)
            await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        State.OnChange -= OnState;
        _crawlId++;   // strand a descent still in flight when the page goes away
    }

    /// <summary>
    /// Re-attempts the roster read a few times, backing off. Deliberately bounded: past a few seconds the
    /// honest answer is the "couldn't read your roster" card, not a page that spins forever.
    /// </summary>
    async Task RetryLoadAsync()
    {
        foreach (var delay in new[] { 400, 1200, 3000 })
        {
            await Task.Delay(delay);
            if (_heroesLoaded || !State.IsSignedIn) return;
            try
            {
                _mine = await Api.Heroes.MineAsync();
                _heroesLoaded = true;
                StateHasChanged();
                return;
            }
            catch { /* keep backing off; the card below stays honest if we never succeed */ }
        }
    }

}
