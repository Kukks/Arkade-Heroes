@* Dev-only genome studio: renders the pixel creature + holographic card straight
   from a genome hex (no wallet/server). Verifies the full rarity/foil ladder and
   lets you explore any genome. Not in the player nav. *@
@page "/studio"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Studio · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Genome Studio</h2>
    <span class="hud">creature + holo card, straight from the genome — @_status</span>
</div>

<div class="addrow" style="max-width:640px;margin:0 0 1.2rem">
    <input @bind="_hex" placeholder="paste 64-char genome hex → render it" maxlength="64" spellcheck="false"
           style="flex:1;background:#11141d;border:1px solid #262b3a;color:#cfd6e6;font:12px monospace;padding:.6rem .8rem" />
    <button class="btn" @onclick="RenderHex">FORGE</button>
    <button class="btn ghost" @onclick="() => Load(RARITY_LADDER)">Rarity ladder</button>
    <button class="btn ghost" @onclick="() => Load(CREST_FORMS)">Crest forms</button>
    <button class="btn ghost" @onclick="LoadOfferPreviews">Offer cards</button>
</div>

<div class="grid cols">
    @foreach (var c in _cards)
    {
        <div class="hero-card" style="--tier:var(--r-@c.TierKey)">
            <div class="hero-tile tier-@c.TierIndex">
                <img src="@c.Src" style="width:118px;height:118px;image-rendering:pixelated;display:block" alt="creature" />
                <span class="hero-foil"></span>
                <span class="hero-gen mono">@c.Element</span>
            </div>
            <div class="hero-body">
                <div class="hero-head">
                    <span class="hero-name">@c.ClassName</span>
                    <span class="tier tag-@c.TierKey">@c.TierName</span>
                </div>
                <div class="rar-pips">
                    @for (var i = 0; i < 5; i++)
                    {
                        <span class="pip @(i <= c.TierIndex ? "on" : "")"></span>
                    }
                </div>
                <div class="chips"><span class="chip">score <b>@c.Score</b></span></div>
                @if (c.Badges.Count > 0)
                {
                    <div class="trait-badges">
                        @foreach (var b in c.Badges)
                        {
                            <span class="tbadge tag-@b.tierKey" title="@b.name">@b.abbr</span>
                        }
                    </div>
                }
                else
                {
                    <div class="chips"><span class="chip">gen-0 · no traits</span></div>
                }
            </div>
        </div>
    }
</div>

@if (_offers.Count > 0)
{
    <h3 style="margin:1.8rem 0 .8rem;color:#8ea2c6;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase">
        Offer cards — holographic marketplace treatment
    </h3>
    <div class="grid cols">
        @foreach (var o in _offers)
        {
            <OfferCard Offer="o.Offer" Hero="o.Hero" Buyable="true" />
        }
    </div>
    <h3 style="margin:1.8rem 0 .8rem;color:#8ea2c6;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase">
        Equipment rows — item icons on the hero detail
    </h3>
    <div class="card" style="max-width:340px">
        <div class="equip-list">
            @foreach (var (slot, id) in new[] { ("Weapon", "steel-saber"), ("Armor", "covenant-plate"), ("Trinket", "lucky-feather") })
            {
                <div class="equip-row">
                    <ItemSprite ItemId="@id" Size="40" />
                    <div class="equip-meta"><span class="equip-slot">@slot</span><b class="equip-name">@id</b></div>
                </div>
            }
        </div>
    </div>
}

@code {
    private string _status = "loading…";
    private string _hex = "";
    private IJSObjectReference? _mod;
    private readonly List<Card> _cards = new();
    private readonly List<OfferPreview> _offers = new();

    private static readonly string BASE = "40806050300511660a0b0c0d0e003344";
    // one Crest trait (byte 22) at each tier band → card tier climbs Common→Legendary
    private static readonly string[] RARITY_LADDER =
    {
        BASE + "00000000000000000000000000000000", // Common (no traits)
        BASE + "000000000000dc050000000000000000", // Uncommon crest
        BASE + "000000000000f5050000000000000000", // Rare crest
        BASE + "000000000000fe050000000000000000", // Epic crest
        BASE + "000000000000ff050000000000000000", // Legendary crest
    };
    // same Legendary crest tier, recessive byte 0/1/2 → the 3 crest forms (horns/fins/crown)
    private static readonly string[] CREST_FORMS =
    {
        BASE + "000000000000ff000000000000000000",
        BASE + "000000000000ff010000000000000000",
        BASE + "000000000000ff020000000000000000",
    };

    private static readonly string[] TIERKEY = { "common", "uncommon", "rare", "epic", "legendary" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _mod = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hero-render.js");
            await Load(RARITY_LADDER);
        }
        catch (Exception e) { _status = "ERR: " + e.Message; StateHasChanged(); }
    }

    private async Task RenderHex()
    {
        var h = new string((_hex ?? "").Where(Uri.IsHexDigit).ToArray()).ToLowerInvariant();
        if (h.Length == 64) await Load(new[] { h });
    }

    private async Task Load(string[] genomes)
    {
        if (_mod is null) return;
        _cards.Clear();
        foreach (var g in genomes)
        {
            var src = await _mod.InvokeAsync<string>("renderHeroDataUrl", g, 118, "menace");
            var meta = await _mod.InvokeAsync<Meta>("heroMeta", g);
            _cards.Add(new Card(src, meta));
        }
        _status = $"{_cards.Count} rendered";
        StateHasChanged();
    }

    // Synthetic marketplace offers (no server): one hero offer per tier + a tier-less item offer,
    // to eyeball the OfferCard holo treatment (foil tile, tinted frame, pips) without a live market.
    private void LoadOfferPreviews()
    {
        _offers.Clear();
        var band = new (string tier, int score, long ask)[]
        {
            ("Uncommon", 3, 12_000), ("Rare", 8, 45_000), ("Epic", 20, 120_000), ("Legendary", 50, 500_000),
        };
        foreach (var (genome, i) in RARITY_LADDER.Skip(1).Select((g, i) => (g, i)))
        {
            var (tier, score, ask) = band[i];
            _offers.Add(new OfferPreview(FakeOffer(tier, ask, FakeHero(genome, tier, score)), FakeHero(genome, tier, score)));
        }
        // item offers (tier-less path) — real catalog ids so the icon slot/tier resolve
        foreach (var (id, name, ask) in new[]
        {
            ("arkforged-edge", "Arkforged Edge", 10_000L),
            ("chain-hauberk", "Chain Hauberk", 2_500L),
            ("vtxo-charm", "VTXO Charm", 10_000L),
        })
            _offers.Add(new OfferPreview(FakeItemOffer(id, name, ask), null));
        _status = $"{_offers.Count} offer previews";
        StateHasChanged();
    }

    private static OfferDto FakeItemOffer(string itemId, string name, long ask) => new(
        OfferId: "offer-" + itemId, SellerId: "npub1seller0abcd", ItemId: itemId, ItemName: name,
        AskSats: ask, OfferAddress: "tark1qexampleoffer", ItemAssetId: "asset-" + itemId,
        OfferValueSats: 330, RefundAfterUnixSeconds: 0, Status: "active", Kind: "item",
        HeroId: null, RarityTier: null);

    private static HeroDto FakeHero(string genome, string tier, int score) => new(
        Id: "hero-" + tier, Name: "Frost Sentinel", OwnerId: "seller", GenomeHex: genome,
        Generation: 2, Element: "Frost", Level: 7, Xp: 120, XpToNext: 200,
        Stats: new StatsDto(340, 88, 40, 72, 60, 30, 12, 8),
        Skills: new List<SkillDto>(), Equipment: new Dictionary<string, string>(),
        BreedCount: 0, BreedCooldownUntil: null, ParentAId: null, ParentBId: null,
        AssetId: null, MintArkTxId: null, Provenance: null,
        Rarity: new RarityDto(tier, score, new List<TraitDto> { new("Crest", 255, tier) }, new List<TraitDto>()));

    private static OfferDto FakeOffer(string tier, long ask, HeroDto? hero) => new(
        OfferId: "offer-" + (tier.Length == 0 ? "item" : tier), SellerId: "npub1seller0abcd", ItemId: hero?.Id ?? "elixir",
        ItemName: hero is null ? "Elixir of Focus" : "Frost Sentinel", AskSats: ask,
        OfferAddress: "tark1qexampleoffer", ItemAssetId: "asset123", OfferValueSats: 330,
        RefundAfterUnixSeconds: 0, Status: "active", Kind: hero is null ? "item" : "hero",
        HeroId: hero?.Id, RarityTier: hero?.Rarity?.Tier);

    private sealed record OfferPreview(OfferDto Offer, HeroDto? Hero);

    private record Meta(int tier, string tierName, int score, string element, string className, bool gen0, MetaTrait[] expressed);
    private record MetaTrait(int cat, string catName, int tier, int form);

    private sealed class Card
    {
        public string Src { get; }
        public int TierIndex { get; }
        public string TierKey { get; }
        public string TierName { get; }
        public int Score { get; }
        public string Element { get; }
        public string ClassName { get; }
        public List<(string name, string abbr, string tierKey)> Badges { get; } = new();

        public Card(string src, Meta m)
        {
            Src = src; TierIndex = m.tier; TierKey = TIERKEY[m.tier];
            TierName = m.tierName; Score = m.score; Element = m.element; ClassName = m.className;
            foreach (var t in m.expressed)
                Badges.Add((t.catName, t.catName.Length <= 3 ? t.catName.ToUpper() : t.catName[..3].ToUpper(), TIERKEY[t.tier]));
        }
    }
}
