@page "/spar"
@using ArkadeHeroes.Core.Combat
@using ArkadeHeroes.Core.Genetics
@using ArkadeHeroes.Core.Heroes
@using NBitcoin
@inject ArkadeHeroesClient Api
@inject WalletState State
@implements IDisposable

<PageTitle>Spar · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Spar</h2>
    <span class="hud">a friendly duel · the real engine, replayed in your browser</span>
</div>

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the roster…</div>
}
else if (_error is not null)
{
    <div class="card"><div class="status-line"><span class="dot bad"></span> @_error</div></div>
}
else if (_heroes.Count < 2)
{
    <div class="card muted">The arena needs at least two minted heroes — claim starters (or breed) to fill the roster.</div>
}
else
{
    <div class="card">
        <p class="muted" style="margin-top:0">
            No stakes, nothing burned — a sparring match. It runs the exact deterministic battle engine
            right here in your browser and replays it blow by blow. Same maths as a ranked bout, minus the wager.
            Pick any two heroes on the ladder and watch them go.
        </p>
        <div class="breed-picks">
            <label>Red corner
                <select @bind="_aId" @bind:after="Stage" disabled="@_fighting">
                    <option value="">— pick —</option>
                    @foreach (var h in _heroes)
                    {
                        <option value="@h.Id">@h.Name — lvl @h.Level · @(h.Rarity?.Tier ?? "Common")</option>
                    }
                </select>
            </label>
            <span class="breed-plus vs-plus">VS</span>
            <label>Blue corner
                <select @bind="_bId" @bind:after="Stage" disabled="@_fighting">
                    <option value="">— pick —</option>
                    @foreach (var h in _heroes)
                    {
                        <option value="@h.Id">@h.Name — lvl @h.Level · @(h.Rarity?.Tier ?? "Common")</option>
                    }
                </select>
            </label>
        </div>
        <div class="spar-actions">
            <button class="btn primary" @onclick="DoFight"
                    disabled="@(_fighting || string.IsNullOrEmpty(_aId) || string.IsNullOrEmpty(_bId) || _aId == _bId)">
                @(_fighting ? "Fighting…" : _done ? "Rematch" : "Fight!")
            </button>
            @if (_aId == _bId && !string.IsNullOrEmpty(_aId))
            {
                <span class="mini">pick any two — a hero may even face itself</span>
            }
        </div>
    </div>

    @if (_a is not null && _b is not null)
    {
        <BattleArena A="_a" B="_b" Fight="_fight" OnFinished="OnReplayDone" />
    }
}

@code {
    [SupplyParameterFromQuery(Name = "a")] public string? PreA { get; set; }
    [SupplyParameterFromQuery(Name = "b")] public string? PreB { get; set; }

    private List<HeroDto> _heroes = new();
    private bool _loading = true;
    private string? _error;

    private string _aId = "";
    private string _bId = "";
    private HeroDto? _a;
    private HeroDto? _b;

    private BattleResultDto? _fight;   // the resolved fight handed to the arena to replay (null = staged)
    private bool _fighting;
    private bool _done;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();

        // Deep-link: /spar?a=<heroId>&b=<heroId> pre-selects the fighters (e.g. from a hero page).
        if (!string.IsNullOrEmpty(PreA) && _heroes.Any(h => h.Id == PreA)) _aId = PreA;
        if (!string.IsNullOrEmpty(PreB) && _heroes.Any(h => h.Id == PreB)) _bId = PreB;
        if (_aId.Length > 0 || _bId.Length > 0) Stage();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _heroes = await Api.Heroes.AllAsync();
        }
        catch
        {
            _error = "Couldn't reach the arena — start the server and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    // Stage the two fighters (the arena shows them at full HP) the moment both are picked, so the
    // matchup shows before the bell; a fresh pick resets any finished bout.
    void Stage()
    {
        _a = _heroes.FirstOrDefault(h => h.Id == _aId);
        _b = _heroes.FirstOrDefault(h => h.Id == _bId);
        _fight = null;
        _done = false;
    }

    // Run the deterministic fight locally and hand the result to the arena as a fresh instance — the
    // shared BattleArena component detects the new Fight and replays it blow by blow.
    void DoFight()
    {
        if (_a is null || _b is null || _aId == _bId) return;
        _fighting = true;
        _done = false;
        try
        {
            var seed = RandomUtils.GetBytes(32);
            _fight = ToReplay(BattleEngine.Fight(ToHero(_a), ToHero(_b), seed));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _fighting = false;
        }
    }

    // The arena fires this once its replay finishes.
    void OnReplayDone()
    {
        _fighting = false;
        _done = true;
        StateHasChanged();
    }

    static Hero ToHero(HeroDto d) => new()
    {
        Id = d.Id,
        OwnerId = d.OwnerId,
        Name = d.Name,
        Genome = Genome.FromHex(d.GenomeHex),
        Level = d.Level,
    };

    // Map the locally-computed result to the same wire DTO the server sends for a duel / death-match,
    // so all four surfaces (spar, duel, death-match, gauntlet) replay through one component.
    static BattleResultDto ToReplay(BattleResult r) => new(
        r.WinnerId, r.LoserId, r.Turns,
        r.Events.Select(e => new BattleEventDto(
            e.Turn, e.ActorId, e.TargetId, e.Kind.ToString(), e.SkillId,
            e.Damage, e.Crit, e.Healed, e.TargetHpAfter, e.Note, e.Effect.ToString())).ToList(),
        r.WinnerRemainingHp, r.WinnerMaxHp);

    void OnState() => InvokeAsync(async () =>
    {
        if (!_fighting) await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;
}
