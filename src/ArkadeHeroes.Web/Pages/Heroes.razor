@page "/heroes"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject GameWallet WalletSvc
@inject WalletState State
@implements IDisposable

<PageTitle>Heroes · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Heroes</h2>
    <span class="hud">every hero is an Arkade asset</span>
    <span class="spacer"></span>
    @if (State.IsSignedIn)
    {
        <div class="toggle">
            <button class="chip as-btn @(_mine ? "" : "on")" @onclick="() => Show(false)">All</button>
            <button class="chip as-btn @(_mine ? "on" : "")" @onclick="() => Show(true)">Mine</button>
        </div>
    }
    @if (!_loading && !_error)
    {
        <span class="chip mono">@_heroes.Count @(_mine ? "yours" : "minted")</span>
    }
</div>

@* The badges moved to /achievements — a card wedged above the roster pushed the actual heroes down
   the page, by however many you happened to own. *@

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the roster…</div>
}
else if (_error)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't reach the arena.</div>
        <p class="muted" style="margin:.7rem 0 0">Start the server: <span class="mono">dotnet run --project src/ArkadeHeroes.Server</span></p>
    </div>
}
else
{
    @if (_heroes.Count == 0)
    {
        <div class="card muted">
            @if (_mine)
            {
                <text>You don't have any heroes yet — recruit your first one below.</text>
            }
            else if (State.IsSignedIn)
            {
                <text>No heroes minted yet — switch to <b>Mine</b> and recruit one.</text>
            }
            else
            {
                @* href="/" — an EMPTY href resolves to the current document, so the one call to action a
                   signed-out visitor gets on an empty server used to re-navigate to /heroes. *@
                <text>No heroes yet — <a href="/">start playing</a> to summon your first heroes.</text>
            }
        </div>
    }
    else
    {
        <div class="grid cols">
            @foreach (var h in _heroes)
            {
                <HeroCard Hero="h" />
            }
        </div>
        @if (_hasMore)
        {
            <div style="text-align:center;margin-top:1.4rem">
                <button class="btn ghost" @onclick="LoadMore" disabled="@_loadingMore">
                    @(_loadingMore ? "Loading…" : "Load more heroes")
                </button>
            </div>
        }
    }

    @* Recruiting used to live on /wallet, two clicks from the roster it fills — so the page that says
       "you have no heroes" could only point somewhere else. It buys a hero, so it belongs with the heroes,
       and it sits BELOW the roster for the same reason the badges left: nothing gets to push your own
       creatures down the page. *@
    @if (_mine && State.IsSignedIn)
    {
        <div class="card" style="margin-top:1.4rem">
            <h3 style="margin-top:0">Recruit a hero</h3>
            @* The price is stated up front because it is real money leaving the wallet, and recruits are
               buyable as often as you can pay for them — so this is never "one-time" and never goes away. *@
            <p class="muted" style="margin:.2rem 0 .9rem">
                @if (_heroes.Count == 0)
                {
                    <text>Recruits are the bottom of the barrel — no traits, weak stats — but it's yours, and it can breed. Buy as many as you want.</text>
                }
                else
                {
                    <text>Another one, the cheapest way there is — and it shows: no traits, weak stats. Recruit as many as you like.</text>
                }
            </p>
            <button class="btn primary" @onclick="Recruit" disabled="@(_claiming || !CanAffordClaim)">
                @if (_claiming)
                {
                    <text>@(_claimStep ?? "Recruiting…")</text>
                }
                else if (_claimFeeSats is null)
                {
                    <text>Recruit a hero</text>
                }
                else
                {
                    <text>Recruit a hero — @_claimFeeSats.Value.ToString("N0") sats</text>
                }
            </button>
            @if (!CanAffordClaim && _claimFeeSats is not null)
            {
                <div class="status-line" style="margin-top:.7rem">
                    <span class="dot bad"></span>
                    You have @State.BalanceSats.ToString("N0") sats; recruiting costs @_claimFeeSats.Value.ToString("N0").
                    <a href="wallet">Top up your wallet →</a>
                </div>
            }
            @if (_claimMsg is not null)
            {
                <div class="status-line" style="margin-top:.7rem"><span class="dot ok"></span> @_claimMsg</div>
            }
            @if (_claimError is not null)
            {
                <div class="status-line" style="margin-top:.7rem"><span class="dot bad"></span> @_claimError</div>
            }
        </div>
    }
}

@code {
    private List<HeroDto> _heroes = new();
    private bool _loading = true;
    private bool _error;
    private bool _mine;

    /// <summary>?mine=1 (e.g. right after Play claims your starters) opens the "Mine" tab first.</summary>
    [SupplyParameterFromQuery(Name = "mine")] public string? MineParam { get; set; }

    /// <summary>
    /// The link asked for Mine and we have not been able to honour it yet.
    ///
    /// <para>There is no "mine" to show while signed out, so the query string alone cannot open that tab —
    /// it needs a session. On a COLD WASM boot the shell resumes sign-in after this page has already
    /// initialised, so the condition was false at exactly the moment the link was read, and the answer was
    /// then thrown away: <c>/heroes?mine=1</c> opened on All, showing a grid of other people's creatures
    /// with no recruit card, which is the one thing the link exists to reach. Navigating to the same URL
    /// inside the app always worked, because by then the session was up — the tell that this was a startup
    /// ORDER problem and not a routing one.</para>
    ///
    /// <para>So the intent is held rather than discarded, and spent the moment sign-in lands. Spent
    /// exactly once: <see cref="ArkadeHeroes.Web.Wallet.WalletState"/> raises OnChange for every balance
    /// refresh and VTXO arrival, and an intent that re-applied on each of those would drag the tab back
    /// under the player's cursor for the rest of the session.</para>
    /// </summary>
    private bool _minePending;

    private const int PageSize = 24;   // server-side page; "Load more" fetches the next
    private bool _hasMore;
    private bool _loadingMore;

    // ── Recruiting ───────────────────────────────────────────────────────────
    /// <summary>The server's own price for a claim, so the button can state it before the player commits.
    /// Read from published config rather than computed locally — a compiled-in guess would be wrong the
    /// moment an operator changes the breed fee. Null until it loads (or if the read fails).</summary>
    private long? _claimFeeSats;
    private string? _claimStep;
    private string? _claimMsg;
    private string? _claimError;
    private bool _claiming;

    /// <summary>Whether the wallet covers a claim. Unknown price (config read failed) counts as affordable —
    /// better to let the server refuse than to grey out a button over a missing number.</summary>
    private bool CanAffordClaim => _claimFeeSats is not { } fee || State.BalanceSats >= fee;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        _minePending = !string.IsNullOrEmpty(MineParam);
        if (_minePending && State.IsSignedIn) { _mine = true; _minePending = false; }
        if (_mine) await LoadRecruitContextAsync();
        await LoadAsync();
    }

    async Task Show(bool mine)
    {
        // Whatever the link wanted, the player has now said otherwise — and they get the last word.
        _minePending = false;
        if (_mine == mine) return;
        _mine = mine;
        // Raised HERE, not just inside LoadAsync: the price read below awaits first, and without this the
        // render in between shows the tab you just left — the other list, counted as "yours", under a
        // recruit button that hasn't learned its price yet.
        _loading = true;
        if (_mine) await LoadRecruitContextAsync();
        await LoadAsync();
    }

    /// <summary>
    /// The two numbers the recruit button quotes. Read on the way INTO the Mine view rather than once at
    /// startup: only that view can recruit, so someone browsing every hero in the game never pays for a
    /// quote they can't use — and, more importantly, the numbers can't go stale. Reading them at init
    /// would miss the ordinary case where the shell's sign-in resumes AFTER this page has loaded, leaving
    /// a button that can spend sats but never learned what it costs.
    /// </summary>
    async Task LoadRecruitContextAsync()
    {
        // A plain read — no invoice is created here, so opening the roster never bills anything.
        try { _claimFeeSats = (await Api.Chain.InfoAsync()).Config?.StarterClaimFeeSats; }
        catch { /* price unknown — the button still works, it just can't quote up front */ }
        await RefreshBalanceAsync();
    }

    /// <summary>
    /// Which roster read is the current one — the page keeps whichever was ISSUED last, not whichever
    /// happens to RETURN last.
    ///
    /// <para>Two are now genuinely in flight at once, and it is the deep-link path that puts them there:
    /// a cold boot starts an ALL read while still signed out, then sign-in lands and starts a MINE read
    /// before the first has come back. Whichever answered last used to win, so a slow ALL response would
    /// drop other people's heroes into the page under the "Mine" tab — the exact confusion
    /// <c>?mine=1</c> exists to prevent, arrived at from the other direction.</para>
    /// </summary>
    private int _rosterSeq;

    async Task LoadAsync()
    {
        var seq = ++_rosterSeq;
        _loading = true;
        _error = false;
        _hasMore = false;
        try
        {
            var heroes = _mine ? await Api.Heroes.MineAsync(0, PageSize) : await Api.Heroes.AllAsync(0, PageSize);
            if (seq != _rosterSeq) return;          // superseded in flight; the newer read owns the page
            _heroes = heroes;
            _hasMore = heroes.Count == PageSize;    // a full page suggests there may be more
        }
        catch
        {
            if (seq != _rosterSeq) return;          // a superseded read's failure is not this page's news
            _error = true;
        }
        finally
        {
            // Only the newest read may clear the spinner. An older one finishing later would otherwise
            // declare the page loaded while the list it is showing is still on the wire.
            if (seq == _rosterSeq) _loading = false;
        }
    }

    async Task LoadMore()
    {
        _loadingMore = true;
        try
        {
            var next = _mine ? await Api.Heroes.MineAsync(_heroes.Count, PageSize)
                             : await Api.Heroes.AllAsync(_heroes.Count, PageSize);
            _heroes.AddRange(next);
            _hasMore = next.Count == PageSize;
        }
        catch { /* keep what's already loaded */ }
        finally
        {
            _loadingMore = false;
        }
    }

    async Task Recruit()
    {
        _claiming = true;
        _claimError = null;
        _claimMsg = null;
        try
        {
            // Paying takes a moment and costs real sats, so say which step is running rather than
            // leaving a dead button while a spend is in flight.
            var heroes = await Session.ClaimStartersAsync(step =>
            {
                _claimStep = step;
                StateHasChanged();
            });
            _claimMsg = $"Recruited {heroes.Count} hero{(heroes.Count == 1 ? "" : "es")} — recruit another any time.";
            await LoadAsync();          // the new heroes belong in the roster you are already looking at
            await RefreshBalanceAsync();  // the fee left the wallet; the affordability line must follow it
        }
        catch (Exception ex)
        {
            _claimError = ex.Message;
        }
        finally
        {
            _claiming = false;
            _claimStep = null;
        }
    }

    /// <summary>
    /// Re-reads the wallet balance so "you have N sats" is a fresh fact rather than whatever the shell
    /// last cached. The shell's own read is best-effort and leaves the balance at zero when the Arkade
    /// node is unreachable — which would grey out the recruit button and blame the player's funds for it.
    /// </summary>
    async Task RefreshBalanceAsync()
    {
        try
        {
            if (await WalletSvc.GetActiveWalletAsync() is { } w)
                State.UpdateBalance(await WalletSvc.GetBalanceAsync(w.Id));
        }
        catch { /* balance stays at its last known value rather than taking the roster down with it */ }
    }

    void OnStateChanged() => InvokeAsync(async () =>
    {
        // The cold boot's second half: sign-in has landed, so the tab the link asked for is finally
        // showable. Show() spends the intent, so this runs once however many times OnChange fires after.
        if (_minePending && State.IsSignedIn)
            await Show(true);
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnStateChanged;
}
