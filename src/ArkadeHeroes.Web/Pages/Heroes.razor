@page "/heroes"
@inject ArkadeHeroesClient Api
@inject WalletState State
@implements IDisposable

<PageTitle>Heroes · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Heroes</h2>
    <span class="hud">every hero is an Arkade asset</span>
    <span class="spacer"></span>
    @if (State.IsSignedIn)
    {
        <div class="toggle">
            <button class="chip as-btn @(_mine ? "" : "on")" @onclick="() => Show(false)">All</button>
            <button class="chip as-btn @(_mine ? "on" : "")" @onclick="() => Show(true)">Mine</button>
        </div>
    }
    @if (!_loading && !_error)
    {
        <span class="chip mono">@_heroes.Count @(_mine ? "yours" : "minted")</span>
    }
</div>

@* The badges moved to /achievements — a card wedged above the roster pushed the actual heroes down
   the page, by however many you happened to own. *@

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the roster…</div>
}
else if (_error)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't reach the arena.</div>
        <p class="muted" style="margin:.7rem 0 0">Start the server: <span class="mono">dotnet run --project src/ArkadeHeroes.Server</span></p>
    </div>
}
else if (_heroes.Count == 0)
{
    <div class="card muted">
        @* Recruiting costs sats and needs the wallet, so it lives in one place — with the price on it and
           the balance next to it. A second button here could only be a worse copy of that one. *@
        @if (_mine)
        {
            <p style="margin:0 0 .8rem">You don't have any heroes yet.</p>
            <a class="btn primary" href="wallet">Recruit one from your account</a>
        }
        else if (State.IsSignedIn)
        {
            <text>No heroes minted yet — <a href="wallet">recruit one from your account</a>.</text>
        }
        else
        {
            <text>No heroes yet — <a href="">start playing</a> to summon your first heroes.</text>
        }
    </div>
}
else
{
    <div class="grid cols">
        @foreach (var h in _heroes)
        {
            <HeroCard Hero="h" />
        }
    </div>
    @if (_hasMore)
    {
        <div style="text-align:center;margin-top:1.4rem">
            <button class="btn ghost" @onclick="LoadMore" disabled="@_loadingMore">
                @(_loadingMore ? "Loading…" : "Load more heroes")
            </button>
        </div>
    }
}

@code {
    private List<HeroDto> _heroes = new();
    private bool _loading = true;
    private bool _error;
    private bool _mine;

    /// <summary>?mine=1 (e.g. right after Play claims your starters) opens the "Mine" tab first.</summary>
    [SupplyParameterFromQuery(Name = "mine")] public string? MineParam { get; set; }

    private const int PageSize = 24;   // server-side page; "Load more" fetches the next
    private bool _hasMore;
    private bool _loadingMore;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        if (!string.IsNullOrEmpty(MineParam) && State.IsSignedIn) _mine = true;
        await LoadAsync();
    }

    async Task Show(bool mine)
    {
        if (_mine == mine) return;
        _mine = mine;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        _hasMore = false;
        try
        {
            _heroes = _mine ? await Api.Heroes.MineAsync(0, PageSize) : await Api.Heroes.AllAsync(0, PageSize);
            _hasMore = _heroes.Count == PageSize;   // a full page suggests there may be more
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    async Task LoadMore()
    {
        _loadingMore = true;
        try
        {
            var next = _mine ? await Api.Heroes.MineAsync(_heroes.Count, PageSize)
                             : await Api.Heroes.AllAsync(_heroes.Count, PageSize);
            _heroes.AddRange(next);
            _hasMore = next.Count == PageSize;
        }
        catch { /* keep what's already loaded */ }
        finally
        {
            _loadingMore = false;
        }
    }


    void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= OnStateChanged;
}
