@page "/squad"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@implements IDisposable

<PageTitle>Squad · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Squad 3v3</h2>
    <span class="hud">staked team PvP · positional best-of-3 · winner takes the pot</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then field a squad.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the arena…</div>
}
@* "You have 0 heroes" and "we never managed to read your roster" are different facts, and this branch
   used to state the first while meaning either — printing an invented count as fact. Only _heroesLoaded
   tells them apart. Same fix as /duel, /deathmatch, /gauntlet and /trials already carry. *@
else if (!_heroesLoaded)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your roster.</div>
        <p class="muted" style="margin:.6rem 0 0">
            This is not the same as owning too few heroes — we simply couldn't look. @_loadError
        </p>
        <button class="btn primary sm" style="margin-top:.7rem" @onclick="Retry" disabled="@_loading">Try again</button>
    </div>
}
else if (_mine.Count < 3)
{
    <div class="card muted">A squad needs 3 heroes — breed or recruit more on the <a href="heroes?mine=1">Heroes</a> page (you have @_mine.Count).</div>
}
else
{
    <div class="card">
        <h3 style="margin-top:0">Field a squad</h3>
        <p class="muted" style="margin-top:0">
            Pick three distinct heroes in order. Slot 1 fights their slot 1, slot 2 their slot 2, slot 3 their slot 3 —
            win two of three to take the pot. Both sides stake into a covenant escrow; the emulator sweeps it to the winner.
        </p>
        <div class="lineup-picks">
            @for (var i = 0; i < 3; i++)
            {
                var slot = i;
                <label>Slot @(slot + 1)
                    <select value="@Slot(slot)" @onchange="e => SetSlot(slot, e.Value?.ToString() ?? string.Empty)">
                        <option value="">— pick —</option>
                        @foreach (var h in _mine)
                        {
                            <option value="@h.Id">@h.Name — lvl @h.Level</option>
                        }
                    </select>
                </label>
            }
        </div>
        @if (!LineupValid && MyLineup.Any(x => !string.IsNullOrEmpty(x)))
        {
            <div class="status-line muted" style="margin-top:.4rem">Pick three <b>distinct</b> heroes.</div>
        }

        <div class="muted" style="margin:1rem 0 .4rem;font-size:.82rem">
            Opponent squad@(AnyScored ? " (closest match first)" : ""):
        </div>
        @if (_loadingOpps)
        {
            <div class="status-line"><span class="dot wait"></span> reading the matchups…</div>
        }
        @if (!Opponents.Any())
        {
            <div class="status-line muted">No opponents yet — another player needs three heroes.</div>
        }
        else
        {
            <div class="oppgrid">
                @foreach (var o in Opponents)
                {
                    <button class="oppcard @(o.Owner == _oppOwner ? "sel" : "")" @onclick="() => _oppOwner = o.Owner">
                        <div class="oppcard-head">
                            <b>Rival squad</b>
                            @if (SquadFavor(o.Heroes) is { } favor)
                            {
                                <span class="chip @(favor == "favored" ? "ok" : "")">@favor</span>
                            }
                        </div>
                        @for (var i = 0; i < o.Heroes.Count; i++)
                        {
                            <div class="mono oppcard-stats">@SlotLine(i, o.Heroes[i])</div>
                        }
                        @if (XpSwing(o.Heroes) is { } xp)
                        {
                            <div class="mono oppcard-xp">
                                win all 3 <b class="pos">+@xp.Win</b> / lose all 3 <b class="neg">-@xp.Lose</b> xp
                            </div>
                        }
                    </button>
                }
            </div>
            @if (!LineupValid)
            {
                <div class="muted" style="margin:.2rem 0 0;font-size:.78rem">
                    Fill all three slots to read each pairing — how far apart the two heroes are in power,
                    and who the fight favours.
                </div>
            }
        }

        <label style="margin-top:1rem">Wager (sats, each side stakes this)
            <input type="number" min="1" step="100" @bind="_wager" />
        </label>
        @* The wager was the only number on screen, but BOTH sides also pay a match fee on top of it — at
           open and again at accept. Money that leaves the wallet gets said out loud. *@
        @if (MatchFee is { } fee)
        {
            <p class="muted" style="margin:.5rem 0 0;font-size:.85rem">
                Plus a <b>@fee.ToString("N0") sat</b> match fee per side, scaled to your top hero's level —
                so this costs you <b>@((_wager + fee).ToString("N0")) sats</b> in total.
            </p>
        }
        <button class="btn primary" style="margin-top:1rem" @onclick="DoOpen"
                disabled="@(_busy || !LineupValid || string.IsNullOrEmpty(_oppOwner) || _wager < 1 || !CanAffordOpen)">
            @(_busy ? "Working…" : "Challenge squad")
        </button>
        @* The page already computed the total two lines up; before this it would still let you commit to it
           with an empty wallet and answer with a rejection. Same treatment /gauntlet and /heroes use. *@
        @if (!CanAffordOpen && _wager >= 1 && LineupValid)
        {
            <div class="status-line" style="margin-top:.7rem">
                <span class="dot bad"></span>
                You have @State.BalanceSats.ToString("N0") sats; @OpenShortfall.
                <a href="wallet">Top up your wallet →</a>
            </div>
        }
        @if (_status is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div>
        }
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div>
        }
    </div>

    <div class="page-head" style="margin-top:1.8rem">
        <h3 style="margin:0">Your squad matches</h3>
        <span class="spacer"></span>
        <button class="btn ghost sm" @onclick="Reload" disabled="@_busy">Refresh</button>
    </div>
    @if (!ToAccept.Any() && !ToResolve.Any() && !Waiting.Any() && !AwaitingOpponent.Any() && !History.Any())
    {
        <div class="card muted">No open squad matches. Challenge a rival above — or wait to be challenged.</div>
    }
    else
    {
        @if (ToAccept.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Your turn — accept &amp; stake</div>
                @foreach (var m in ToAccept)
                {
                    <div class="match-row">
                        <span>A rival squad challenges yours · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        @if (!CanAffordAccept(m))
                        {
                            <span class="hud">you have @State.BalanceSats.ToString("N0") sats — <a href="wallet">top up →</a></span>
                        }
                        <button class="btn primary sm" @onclick="() => DoAccept(m.MatchId)"
                                disabled="@(_busy || !CanAffordAccept(m))">Accept</button>
                    </div>
                }
            </div>
        }
        @if (ToResolve.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Ready — resolve the best-of-3</div>
                @foreach (var m in ToResolve)
                {
                    <div class="match-row">
                        <span>Your squad vs a rival · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <button class="btn primary sm" @onclick="() => DoResolve(m.MatchId)" disabled="@_busy">Fight!</button>
                    </div>
                }
            </div>
        }
        @* Accepted, and I am the DEFENDER — the bucket that did not exist. ToAccept is open+defender and
           ToResolve is accepted+CHALLENGER, so the instant a defender accepted (and their stake and match
           fee left their wallet) the match belonged to no bucket and vanished from their page, under a
           message inviting them to challenge someone. Accepting looked like it had done nothing. Read-only
           on purpose: only the challenger may resolve a squad match. *@
        @if (AwaitingOpponent.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Staked — waiting for the challenger to fight</div>
                @foreach (var m in AwaitingOpponent)
                {
                    <div class="match-row muted">
                        <span>Your squad vs a rival · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <span class="chip">accepted</span>
                    </div>
                }
            </div>
        }
        @if (Waiting.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Waiting for the opponent to accept</div>
                @foreach (var m in Waiting)
                {
                    <div class="match-row muted">
                        <span>Your squad vs a rival · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <span class="chip">open</span>
                    </div>
                }
            </div>
        }
        @* What already happened. A resolved squad match dropped out of every bucket, so the page went back
           to looking like nothing had occurred — even though the pot had moved. *@
        @if (History.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Past squad matches</div>
                @foreach (var m in History)
                {
                    <div class="match-row muted">
                        <span>Your squad vs a rival · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        @* The row was a bare "resolved" chip, on BOTH sides — so the player who did not press
                           "Fight!" was never told the score, who won, or that a replay existed. Every one of
                           those facts was already on the SquadMatchDto this row is drawn from; nothing read
                           past .Status. Same treatment /duel's History row already gives m.Result. *@
                        @if (IWon(m) is { } won)
                        {
                            <span class="mono" style="font-size:.82rem">@Score(m)</span>
                            <span class="chip @(won ? "ok" : "bad")">@(won ? "won" : "lost")</span>
                            <button class="btn ghost sm" @onclick="() => Watch(m)">Watch</button>
                        }
                        else
                        {
                            @* Over, but the server attached no result — say only what is known. *@
                            <span class="chip">resolved</span>
                        }
                    </div>
                }
            </div>
        }
    }

    @* Driven by _view, which either the resolve response OR a row of the match list can fill — the block
       itself no longer cares which. Guarded on a non-empty duel list because a list-sourced result is not
       one this browser just produced: indexing straight into Duels[0] on the strength of a status was a
       crash waiting for the first result the server records without them. *@
    @if (_view is { } view && view.Result.Duels.Count > 0)
    {
        var r = view.Result;
        var duel = r.Duels[Math.Min(_duelIndex, r.Duels.Count - 1)];
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Squad match — duel @(_duelIndex + 1) of @r.Duels.Count</h3>
            @* Stated from the viewer's own side. The DTO speaks challenger/defender, which reads backwards
               for a defender — and half the audience for this block is now the defender. *@
            <span class="hud">best of 3 · @view.MyWins–@view.TheirWins</span>
        </div>
        <BattleArena A="duel.Challenger" B="duel.Defender" Fight="duel.Result" OnFinished="NextDuel" />
        @if (_duelIndex >= r.Duels.Count - 1)
        {
            <div class="card" style="margin-top:1.2rem">
                <div class="status-line"><span class="dot ok"></span>
                    <span><b>@(view.IWon ? "Your squad" : "The rival squad")</b> wins the best-of-3 (@view.MyWins–@view.TheirWins)@(view.WinnerPayoutSats is { } payout ? $" — {payout:N0} sats to the winner" : "")</span>
                </div>
                @* A fairness audit is something THIS browser ran while resolving; a replay pulled out of the
                   match list has not had one. Saying so beats an absent line that reads as a silent pass. *@
                @if (view.FairnessOk is { } fair)
                {
                    <div class="status-line" style="margin-top:.7rem">
                        <span class="dot @(fair ? "ok" : "bad")"></span>
                        <span class="mono" style="font-size:.78rem">@(fair ? $"fairness ✓ {view.FairnessDetail}" : $"fairness ✗ server cheated: {view.FairnessDetail}")</span>
                    </div>
                }
                else
                {
                    <div class="status-line muted" style="margin-top:.7rem">
                        <span class="mono" style="font-size:.78rem">replayed from your match list — no fairness audit ran in this browser</span>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private List<HeroDto> _mine = new();
    private List<HeroDto> _all = new();
    private List<SquadMatchDto> _matches = new();
    private string _slot0 = "", _slot1 = "", _slot2 = "";
    private string _oppOwner = "";
    private long _wager = 1000;
    private bool _loading = true, _busy, _heroesLoaded, _loadingOpps;

    /// <summary>Matchmaking reads keyed by MY hero, then by the opponent it was scored against. A squad
    /// match is three positional duels, so one squad's read is three of these — one per slot.</summary>
    private readonly Dictionary<string, Dictionary<string, OpponentSuggestionDto>> _reads = new();

    private string? _status, _error, _loadError;
    private GameConfigDto? _config;

    /// <summary>The per-side match fee this lineup will be charged ON TOP of the wager, at open and again
    /// at accept — the server prices it off the lineup's TOP level. Null until the config is read.</summary>
    private long? MatchFee => MyLineup.All(x => !string.IsNullOrEmpty(x)) && TopLevel is { } lvl
        ? Pricing.MatchFee(_config, lvl)
        : null;

    /// <summary>What opening this challenge takes out of the wallet: the stake plus the per-side match fee.
    /// With the fee unread this is the WAGER ALONE — a strict lower bound, so the gate below can only ever
    /// under-block. Greying out a real spend over a number we failed to read is the worse error, and it is
    /// the rule /gauntlet and /heroes already follow.</summary>
    private long OpenCost => _wager + (MatchFee ?? 0);

    private bool CanAffordOpen => State.BalanceSats >= OpenCost;

    /// <summary>Says which number the gate is quoting, so an unread fee never reads as the whole price.</summary>
    private string OpenShortfall => MatchFee is null
        ? $"the wager alone stakes {OpenCost:N0}, and a match fee is charged on top"
        : $"this costs {OpenCost:N0} in total";

    /// <summary>Whether the wallet covers ACCEPTING <paramref name="m"/>. Gated on the wager only: the
    /// accepting side is charged a match fee too, but that fee is priced off the DEFENDER's lineup, which
    /// this form does not hold — so the wager is the honest lower bound rather than a fee guessed off the
    /// challenger's heroes. A wallet short of the bare stake cannot cover the real total either.</summary>
    private bool CanAffordAccept(SquadMatchDto m) => State.BalanceSats >= m.WagerSats;

    private int? TopLevel
    {
        get
        {
            var picked = _mine.Where(h => MyLineup.Contains(h.Id)).ToList();
            return picked.Count == 0 ? null : picked.Max(h => h.Level);
        }
    }
    /// <summary>
    /// The finished squad match currently on screen, from whichever side is looking at it.
    ///
    /// <para>This used to be the <see cref="SquadOutcome"/> straight off <c>ResolveSquadAsync</c>, and only
    /// the CHALLENGER ever gets one — so the defender's whole experience of a staked 3v3 ending was their
    /// row turning into the word "resolved". The score, the winner and all three fights were sitting in
    /// <c>SquadMatchDto.Result</c> on the list the row was already drawn from.</para>
    /// </summary>
    private SquadView? _view;
    private int _duelIndex;

    /// <summary>
    /// A finished 3v3 plus the two things only the resolving browser can know, both nullable so the block
    /// can state what it has instead of implying what it hasn't: the payout (the list DTO carries the wager,
    /// not the settlement) and the fairness verdict (an audit this browser ran, not a fact it was told).
    /// </summary>
    private sealed record SquadView(
        string MatchId, SquadResultDto Result, bool IAmChallenger,
        long? WinnerPayoutSats, bool? FairnessOk, string FairnessDetail)
    {
        public bool IWon => IAmChallenger == Result.ChallengerWon;
        public int MyWins => IAmChallenger ? Result.ChallengerWins : Result.DefenderWins;
        public int TheirWins => IAmChallenger ? Result.DefenderWins : Result.ChallengerWins;
    }

    private string? MyOwnerId => _mine.FirstOrDefault()?.OwnerId;
    private List<string> MyLineup => new() { _slot0, _slot1, _slot2 };
    private bool LineupValid => MyLineup.All(x => !string.IsNullOrEmpty(x)) && MyLineup.Distinct().Count() == 3;
    private string Slot(int i) => i == 0 ? _slot0 : i == 1 ? _slot1 : _slot2;

    async Task SetSlot(int i, string v)
    {
        if (i == 0) _slot0 = v; else if (i == 1) _slot1 = v; else _slot2 = v;
        await LoadReadsAsync(v);
    }

    /// <summary>Cached per hero: re-picking a slot must not re-ask for an answer that cannot have changed.</summary>
    async Task LoadReadsAsync(string heroId)
    {
        if (string.IsNullOrEmpty(heroId) || _reads.ContainsKey(heroId)) return;
        _loadingOpps = true;
        try
        {
            var read = await Api.Matches.MatchmakingAsync(heroId);
            _reads[heroId] = read.GroupBy(s => s.Hero.Id).ToDictionary(g => g.Key, g => g.First());
        }
        catch
        {
            // Guidance sits on top of a picker that works without it, so a failed read leaves cards bare.
        }
        finally { _loadingOpps = false; }
    }

    /// <summary>Null when the slot is empty, or that opponent fell outside the capped page of suggestions.</summary>
    private OpponentSuggestionDto? Read(int slot, string oppHeroId) =>
        Slot(slot) is { Length: > 0 } mine
        && _reads.TryGetValue(mine, out var byOpponent)
        && byOpponent.TryGetValue(oppHeroId, out var read) ? read : null;

    private string SlotLine(int slot, HeroDto opp)
    {
        var who = $"S{slot + 1} {opp.Name} L{opp.Level}";
        return Read(slot, opp.Id) is not { } r ? who
            : $"{who} · pow {r.PowerScore} (Δ{r.PowerGapPercent}%) · {r.Favor}";
    }

    /// <summary>Null unless ALL three are scored — the aggregates below never speak for an unscored slot.</summary>
    private List<OpponentSuggestionDto>? Reads(List<HeroDto> heroes)
    {
        if (heroes.Count < 3) return null;
        var reads = new List<OpponentSuggestionDto>(3);
        for (var i = 0; i < 3; i++)
        {
            if (Read(i, heroes[i].Id) is not { } r) return null;
            reads.Add(r);
        }
        return reads;
    }

    /// <summary>How the best-of-3 leans: the majority of the three positional reads, because two slots take
    /// the pot. Not a new threshold — <c>Matchmaking.Favor</c> still classifies each pairing.</summary>
    private string? SquadFavor(List<HeroDto> heroes) =>
        Reads(heroes) is not { } reads ? null
            : reads.Count(r => r.Favor == "favored") >= 2 ? "favored"
            : reads.Count(r => r.Favor == "underdog") >= 2 ? "underdog"
            : "even";

    /// <summary>The extremes of a swing the server settles PER SLOT — sweep all three, or drop all three.</summary>
    private (long Win, long Lose)? XpSwing(List<HeroDto> heroes) =>
        Reads(heroes) is not { } reads ? null : (reads.Sum(r => r.XpIfYouWin), reads.Sum(r => r.XpIfYouLose));

    /// <summary>Ranking key, so the closest fights sit first the way /duel's server-ranked list does.</summary>
    private double? MeanGap(List<HeroDto> heroes) =>
        Reads(heroes) is not { } reads ? null : reads.Average(r => (double)r.PowerGapPercent);

    // Opponents: other owners holding >=3 heroes; the defender lineup is their first three.
    private IEnumerable<(string Owner, List<HeroDto> Heroes)> Opponents =>
        _all.Where(h => h.OwnerId != MyOwnerId).GroupBy(h => h.OwnerId).Where(g => g.Count() >= 3)
            .Select(g => (Owner: g.Key, Heroes: g.Take(3).ToList()))
            .OrderBy(o => MeanGap(o.Heroes) ?? double.MaxValue)
            .ThenBy(o => o.Owner, StringComparer.Ordinal);

    private bool AnyScored => Opponents.Any(o => MeanGap(o.Heroes) is not null);
    private List<string> OppLineup =>
        Opponents.FirstOrDefault(o => o.Owner == _oppOwner).Heroes?.Select(h => h.Id).ToList() ?? new();

    private HashSet<string> MineIds => _mine.Select(h => h.Id).ToHashSet();
    private bool Mine(SquadMatchDto m) => m.ChallengerLineup.Any(MineIds.Contains) || m.DefenderLineup.Any(MineIds.Contains);

    private IEnumerable<SquadMatchDto> ToAccept => _matches.Where(m => m.Status == "open" && m.DefenderLineup.Any(MineIds.Contains));
    private IEnumerable<SquadMatchDto> ToResolve => _matches.Where(m => m.Status == "accepted" && m.ChallengerLineup.Any(MineIds.Contains));
    private IEnumerable<SquadMatchDto> Waiting => _matches.Where(m => m.Status == "open" && m.ChallengerLineup.Any(MineIds.Contains));

    /// <summary>Accepted matches where I am the DEFENDER — staked, and nothing for me to do but watch.</summary>
    private IEnumerable<SquadMatchDto> AwaitingOpponent =>
        _matches.Where(m => m.Status == "accepted" && m.DefenderLineup.Any(MineIds.Contains));

    /// <summary>
    /// Squad matches of mine that already ran. The server's status vocabulary is exactly
    /// open | accepted | resolved, so between the four live buckets and this one every combination of
    /// (status × my role) now renders somewhere — which is the property that was missing, not any one row.
    /// </summary>
    private IEnumerable<SquadMatchDto> History => _matches.Where(m => m.Status == "resolved" && Mine(m));

    /// <summary>Which side of a match is mine. A match only reaches this page because one of my heroes is in
    /// it, so "not on the challenger lineup" means the defender. A match of mine against myself is read as
    /// the challenger — the same tie-break the server's own payout takes.</summary>
    private bool IAmChallenger(SquadMatchDto m) => m.ChallengerLineup.Any(MineIds.Contains);

    /// <summary>Did MY squad take the pot? Null while the server has attached no result — "over" and "over,
    /// and here is who won" are different facts and the row says only the one it has.</summary>
    private bool? IWon(SquadMatchDto m) =>
        m.Result is not { } r ? null : IAmChallenger(m) == r.ChallengerWon;

    /// <summary>The best-of-3 from MY side of the table, mine first.</summary>
    private string Score(SquadMatchDto m) =>
        m.Result is not { } r ? ""
            : IAmChallenger(m) ? $"{r.ChallengerWins}–{r.DefenderWins}" : $"{r.DefenderWins}–{r.ChallengerWins}";

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            _all = await Api.Heroes.AllAsync();
            _matches = await Api.Squad.ListAsync();
            _heroesLoaded = true;
            _loadError = null;
            // A resolve moves XP and therefore power, and this runs straight after one. The cached
            // reads were scored against the PRE-fight rosters, and LoadReadsAsync skips a hero it has
            // already seen — so without dropping them the picker keeps quoting the old fight.
            _reads.Clear();
            foreach (var slot in MyLineup)
                await LoadReadsAsync(slot);
        }
        catch (Exception ex)
        {
            // RECORDED, not swallowed. OnState only re-runs on the NEXT wallet event and a server hiccup
            // produces none, so an already-signed-in player whose read failed would otherwise sit forever
            // on a page insisting they own too few heroes to play.
            _loadError = ex.Message;
        }
        finally { _loading = false; }

        // A nice-to-have, kept out of the load's own try so a config blip can't cost you the roster.
        try { _config ??= (await Api.Chain.InfoAsync()).Config; }
        catch { /* price unknown — the page says so rather than quoting a zero */ }
    }

    /// <summary>Manual retry, because the automatic one depends on an event that may never fire.</summary>
    async Task Retry()
    {
        _error = null;
        await LoadAsync();
    }

    async Task DoOpen() => await RunAction("Opening the squad match…", async () =>
    {
        await Session.OpenSquadAsync(MyLineup, OppLineup, _wager, s => { _status = s; StateHasChanged(); });
        _oppOwner = "";
    });

    async Task DoAccept(string id) =>
        await RunAction("Accepting…", () => Session.AcceptSquadAsync(id, s => { _status = s; StateHasChanged(); }));

    async Task DoResolve(string id) => await RunAction("Resolving…", async () =>
    {
        var outcome = await Session.ResolveSquadAsync(id, s => { _status = s; StateHasChanged(); });
        // Only the challenger may resolve (see ToResolve), so this side is mine by construction.
        _view = new SquadView(id, outcome.Result.Result, IAmChallenger: true,
            outcome.Result.WinnerPayoutSats, outcome.FairnessOk, outcome.FairnessDetail);
        _duelIndex = 0;
    });

    /// <summary>
    /// Play a finished match back from the row. Entirely local — the duels, both lineups' snapshots and
    /// every blow ride along on <see cref="SquadMatchDto.Result"/>, so there is no fetch here and therefore
    /// no read to race against the poll-less loads this page already does.
    /// </summary>
    void Watch(SquadMatchDto m)
    {
        if (m.Result is not { } r) return;
        _view = new SquadView(m.MatchId, r, IAmChallenger(m),
            WinnerPayoutSats: null, FairnessOk: null, FairnessDetail: "");
        _duelIndex = 0;
    }

    void NextDuel()
    {
        if (_view is not null && _duelIndex < _view.Result.Duels.Count - 1)
        {
            _duelIndex++;
            StateHasChanged();
        }
    }

    async Task RunAction(string initial, Func<Task> action)
    {
        // Claimed BEFORE the first await. disabled="@_busy" only takes effect at the next render, which
        // happens at that first await — so a second click dispatched in the window between it ran the
        // whole action again, staking a second wager on a second match.
        if (_busy) return;
        _busy = true; _error = null; _status = initial;
        try { await action(); _status = null; }
        catch (Exception ex) { _error = ex.Message; _status = null; }
        // Reload even when the action threw: open/accept create the match on the SERVER first and pay the
        // wager second, so a failed payment still leaves a real match behind — reloading only on success
        // hid it behind an error message, which is the state the player most needs to see.
        finally { await LoadAsync(); _busy = false; }
    }

    async Task Reload()
    {
        _busy = true;
        try { _matches = await Api.Squad.ListAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    void OnState() => InvokeAsync(async () =>
    {
        if (State.IsSignedIn && !_heroesLoaded && !_loading) await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;
}
