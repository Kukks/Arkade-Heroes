@page "/leaderboard"
@inject ArkadeHeroesClient Api

<PageTitle>Ranks · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Ranks</h2>
    <span class="hud">recomputed from signed receipts</span>
</div>

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> tallying the boards…</div>
}
else if (_error)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't reach the arena.</div>
        <p class="muted" style="margin:.7rem 0 0">Start the server: <span class="mono">dotnet run --project src/ArkadeHeroes.Server</span></p>
    </div>
}
else
{
    <div class="card" style="margin-bottom:1.6rem">
        <h3>Top champions</h3>
        @if (_top.Count == 0)
        {
            <p class="muted">Ranked bouts are coming — <a href="spar">spar</a> to test your lineup.</p>
        }
        else
        {
            <p class="muted" style="margin:-.3rem 0 .8rem">ranked by wins, then level — a win tally only ever climbs</p>
            <table class="board">
                <thead>
                    <tr><th>#</th><th>Hero</th><th class="num">Wins</th><th class="num">Lvl</th><th class="num">Matches</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in _top)
                    {
                        <tr>
                            <td class="rank">@e.Rank</td>
                            <td>@e.Name</td>
                            <td class="num">@e.Wins</td>
                            <td class="num">@e.Level</td>
                            <td class="num">@e.Matches</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="page-head">
        <h3 style="margin:0">Recent bouts</h3>
        <span class="hud">watch + verify any fight — no login</span>
    </div>
    @if (_recent.Count == 0)
    {
        <div class="card muted" style="margin-bottom:1.6rem">No bouts yet — <a href="spar">spar</a> or <a href="duel">duel</a> to fill the feed.</div>
    }
    else
    {
        <div class="card" style="margin-bottom:1.6rem">
            @foreach (var m in _recent.Take(8))
            {
                var winner = m.Result!.WinnerId;
                var loser = winner == m.ChallengerHeroId ? m.DefenderHeroId : m.ChallengerHeroId;
                <div class="match-row">
                    <span><b>@Name(winner)</b> defeated <b>@Name(loser)</b>@(m.WagerSats > 0 ? $" · {m.WagerSats:N0} sats" : "")</span>
                    <span class="spacer"></span>
                    <a class="btn ghost sm" href="watch/@m.MatchId">Watch ↗</a>
                </div>
            }
        </div>
    }

    <div class="page-head">
        <h3 style="margin:0">Rarest heroes</h3>
        <span class="hud">genome-derived, trustless</span>
    </div>
    @if (_rarest.Count == 0)
    {
        <div class="card muted">No heroes minted yet.</div>
    }
    else
    {
        <div class="grid cols">
            @foreach (var h in _rarest)
            {
                <HeroCard Hero="h" />
            }
        </div>
    }
}

@code {
    private List<LeaderboardEntryDto> _top = new();
    private List<HeroDto> _rarest = new();
    private List<MatchDto> _recent = new();
    private readonly Dictionary<string, string> _names = new();
    private bool _loading = true;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var top = Api.Leaderboard.TopAsync();
            var rarest = Api.Leaderboard.RarestAsync();
            var recent = Api.Matches.ListAsync("resolved");   // public — no auth needed to browse the feed
            var all = Api.Heroes.AllAsync();                   // for hero-id → name resolution
            await Task.WhenAll(top, rarest, recent, all);
            _top = await top;
            _rarest = await rarest;
            _recent = (await recent).Where(m => m.Result is not null).ToList();
            foreach (var h in await all) _names[h.Id] = h.Name;
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private string Name(string? heroId) =>
        heroId is not null && _names.TryGetValue(heroId, out var n) ? n : "a hero";
}
