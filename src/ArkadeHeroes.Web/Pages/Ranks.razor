@page "/leaderboard"
@inject ArkadeHeroesClient Api

<PageTitle>Ranks · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Ranks</h2>
    <span class="hud">recomputed from signed receipts</span>
</div>

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> tallying the boards…</div>
}
else if (_error)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't reach the arena.</div>
        <p class="muted" style="margin:.7rem 0 0">Start the server: <span class="mono">dotnet run --project src/ArkadeHeroes.Server</span></p>
    </div>
}
else
{
    @if (_economy is not null)
    {
        <div class="card" style="margin-bottom:1.6rem">
            <div class="page-head" style="margin:0 0 .3rem">
                <h3 style="margin:0">Treasury</h3>
                <span class="hud">the finite, fee-funded pot — sats are real BTC</span>
                <span class="spacer"></span>
                <span class="chip mono">@_economy.TreasuryBalanceSats.ToString("N0") sat</span>
            </div>
            <p class="muted" style="margin:-.1rem 0 .7rem">spendable balance · @_economy.SeasonAccrualSats.ToString("N0") sat accrued to season pots</p>
            @if (_economy.TotalInflowSats > 0)
            {
                <p class="muted" style="margin:0 0 .3rem">fees captured — @_economy.TotalInflowSats.ToString("N0") sat</p>
                @foreach (var kv in _economy.InflowByTag.OrderByDescending(k => k.Value))
                {
                    <div class="match-row">
                        <span>@FlowLabel(kv.Key)</span>
                        <span class="spacer"></span>
                        <span class="chip">+@kv.Value.ToString("N0") sat</span>
                    </div>
                }
            }
            @if (_economy.TotalOutflowSats > 0)
            {
                <p class="muted" style="margin:0 0 .3rem">paid out to date — @_economy.TotalOutflowSats.ToString("N0") sat total</p>
                @foreach (var kv in _economy.OutflowByTag.OrderByDescending(k => k.Value))
                {
                    <div class="match-row">
                        <span>@FlowLabel(kv.Key)</span>
                        <span class="spacer"></span>
                        <span class="chip">−@kv.Value.ToString("N0") sat</span>
                    </div>
                }
            }
            else
            {
                <p class="muted" style="margin:0">No treasury payouts yet.</p>
            }
        </div>
    }

    @if (_season is not null)
    {
        <div class="card" style="margin-bottom:1.6rem">
            <div class="page-head" style="margin:0 0 .3rem">
                <h3 style="margin:0">Season @_season.SeasonNumber</h3>
                <span class="hud">@ResetsIn(_season.EndsAtUnix)</span>
                <span class="hud">🏆 pot @_season.PotSats.ToString("N0") sat</span>
            </div>
            @if (_season.Standings.Count == 0)
            {
                <p class="muted">No ranked wins yet this season — <a href="duel">duel</a> for a staked win to open the board.</p>
            }
            else
            {
                <p class="muted" style="margin:-.1rem 0 .8rem">ranked by staked-match wins this season</p>
                <table class="board">
                    <thead><tr><th>#</th><th>Hero</th><th class="num">Wins</th><th class="num">Lvl</th></tr></thead>
                    <tbody>
                        @foreach (var e in _season.Standings)
                        {
                            <tr><td class="rank">@e.Rank</td><td>@e.Name</td><td class="num">@e.Wins</td><td class="num">@e.Level</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (_season?.LastSettlement is { } settled)
    {
        <div class="card" style="margin-bottom:1.6rem">
            <h3 style="margin:0 0 .5rem">Season @settled.SeasonNumber champions</h3>
            <p class="muted" style="margin:-.2rem 0 .7rem">@settled.PotSats.ToString("N0") sat pot, paid out</p>
            @foreach (var w in settled.Winners)
            {
                <div class="match-row">
                    <span><b>#@w.Rank</b> @w.Name</span>
                    <span class="spacer"></span>
                    <span class="chip">@w.AwardSats.ToString("N0") sat</span>
                </div>
            }
        </div>
    }

    @if (TournChamps.Any())
    {
        <div class="card" style="margin-bottom:1.6rem">
            <h3 style="margin:0 0 .5rem">Tournament champions</h3>
            <p class="muted" style="margin:-.2rem 0 .7rem">winners of resolved brackets</p>
            @foreach (var t in TournChamps.Take(8))
            {
                <div class="match-row">
                    <span>🏆 <b>@Champ(t.ChampionHeroId)</b> · @t.Size-hero bracket</span>
                    <span class="spacer"></span>
                    <span class="chip">@t.ChampionPrizeSats.ToString("N0") sat</span>
                </div>
            }
        </div>
    }

    <div class="card" style="margin-bottom:1.6rem">
        <h3>Top champions</h3>
        @if (_top.Count == 0)
        {
            <p class="muted">Ranked bouts are coming — <a href="spar">spar</a> to test your lineup.</p>
        }
        else
        {
            <p class="muted" style="margin:-.3rem 0 .8rem">ranked by wins, then level — a win tally only ever climbs</p>
            <table class="board">
                <thead>
                    <tr><th>#</th><th>Hero</th><th class="num">Wins</th><th class="num">Lvl</th><th class="num">Matches</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in _top)
                    {
                        <tr>
                            <td class="rank">@e.Rank</td>
                            <td>@e.Name</td>
                            <td class="num">@e.Wins</td>
                            <td class="num">@e.Level</td>
                            <td class="num">@e.Matches</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="page-head">
        <h3 style="margin:0">Recent bouts</h3>
        <span class="hud">watch + verify any fight — no login</span>
    </div>
    @if (_recent.Count == 0)
    {
        <div class="card muted" style="margin-bottom:1.6rem">No bouts yet — <a href="spar">spar</a> or <a href="duel">duel</a> to fill the feed.</div>
    }
    else
    {
        <div class="card" style="margin-bottom:1.6rem">
            @foreach (var m in _recent.Take(8))
            {
                var winner = m.Result!.WinnerId;
                var loser = winner == m.ChallengerHeroId ? m.DefenderHeroId : m.ChallengerHeroId;
                <div class="match-row">
                    <span><b>@Name(winner)</b> defeated <b>@Name(loser)</b>@(m.WagerSats > 0 ? $" · {m.WagerSats:N0} sats" : "")</span>
                    <span class="spacer"></span>
                    <a class="btn ghost sm" href="watch/@m.MatchId">Watch ↗</a>
                </div>
            }
        </div>
    }

    <div class="page-head">
        <h3 style="margin:0">Rarest heroes</h3>
        <span class="hud">genome-derived, trustless</span>
    </div>
    @if (_rarest.Count == 0)
    {
        <div class="card muted">No heroes minted yet.</div>
    }
    else
    {
        <div class="grid cols">
            @foreach (var h in _rarest)
            {
                <HeroCard Hero="h" />
            }
        </div>
    }

    <div class="page-head">
        <h3 style="margin:0">Fancy heroes</h3>
        <span class="hud">named genome sets — a breeding target</span>
    </div>
    @if (_fancies.Count == 0)
    {
        <div class="card muted">No fancy heroes yet — breed toward a named set.</div>
    }
    else
    {
        <div class="grid cols">
            @foreach (var h in _fancies)
            {
                <HeroCard Hero="h" />
            }
        </div>
    }

    <div class="page-head">
        <h3 style="margin:0">Founder heroes</h3>
        <span class="hud">generation-0 originals — the scarcest lineage</span>
    </div>
    @if (_founders.Count == 0)
    {
        <div class="card muted">No founders yet — the first minted heroes appear here.</div>
    }
    else
    {
        <div class="grid cols">
            @foreach (var h in _founders)
            {
                <HeroCard Hero="h" />
            }
        </div>
    }
}

@code {
    private SeasonLeaderboardDto? _season;
    private EconomyHealthDto? _economy;
    private List<LeaderboardEntryDto> _top = new();
    private List<HeroDto> _rarest = new();
    private List<HeroDto> _fancies = new();
    private List<HeroDto> _founders = new();
    private List<TournamentDto> _tournaments = new();
    private List<MatchDto> _recent = new();
    private readonly Dictionary<string, string> _names = new();
    private bool _loading = true;
    private bool _error;

    private IEnumerable<TournamentDto> TournChamps => _tournaments.Where(t => t.Status == "resolved" && t.ChampionHeroId is not null);
    private string Champ(string? id) => id is not null && _names.TryGetValue(id, out var n) ? n : "a champion";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var top = Api.Leaderboard.TopAsync();
            var season = Api.Leaderboard.SeasonAsync();
            var rarest = Api.Leaderboard.RarestAsync();
            var fancies = Api.Leaderboard.FanciesAsync();
            var tournaments = Api.Tournament.ListAsync();
            var recent = Api.Matches.ListAsync("resolved");   // public — no auth needed to browse the feed
            var all = Api.Heroes.AllAsync();                   // for hero-id → name resolution
            var economy = Api.Economy.HealthAsync();           // treasury-health telemetry (public)
            var founders = Api.Leaderboard.FoundersAsync();    // generation-0 originals
            await Task.WhenAll(top, season, rarest, fancies, tournaments, recent, all, economy, founders);
            _top = await top;
            _season = await season;
            _rarest = await rarest;
            _fancies = await fancies;
            _tournaments = await tournaments;
            _recent = (await recent).Where(m => m.Result is not null).ToList();
            _economy = await economy;
            _founders = await founders;
            foreach (var h in await all) _names[h.Id] = h.Name;
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    // Countdown to the season reset, from the server-supplied end instant.
    static string ResetsIn(long endsAtUnix)
    {
        var left = DateTimeOffset.FromUnixTimeSeconds(endsAtUnix) - DateTimeOffset.UtcNow;
        if (left <= TimeSpan.Zero) return "resetting…";
        return left.TotalDays >= 1
            ? $"resets in {(int)left.TotalDays} day{((int)left.TotalDays == 1 ? "" : "s")}"
            : $"resets in {(int)left.TotalHours}h";
    }

    private string Name(string? heroId) =>
        heroId is not null && _names.TryGetValue(heroId, out var n) ? n : "a hero";

    // Friendly label for a treasury flow category tag (matches the GameStore inflow/outflow tags).
    private static string FlowLabel(string tag) => tag switch
    {
        "daily" => "Daily rewards",
        "season" => "Season prizes",
        "tournament" => "Tournament prizes",
        "wager" => "Wager payouts",
        "squad" => "Squad payouts",
        "item" => "Item sales",
        "rename" => "Hero renames",
        "listing" => "Listing fees",
        "gauntlet" => "Gauntlet entries",
        _ => tag,
    };
}
