@page "/deathmatch"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@implements IDisposable

<PageTitle>Death-match · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Death-match</h2>
    <span class="hud">winner takes all · the loser's hero BURNS forever</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then stake a hero to the death.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the arena…</div>
}
@* "You have no heroes" and "we never managed to read your roster" are different facts, and this
   branch used to state the first while meaning either. A load that returns early because sign-in has
   not resumed yet, or one that throws and is swallowed, both leave _mine empty — and the page then
   told a player with a full roster to go and claim starters. Only _heroesLoaded distinguishes them. *@
else if (!_heroesLoaded)
{
    <div class="card muted">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your roster.</div>
        <p class="muted" style="margin:.6rem 0 0">
            If you're signed in, reload the page. If not, <a href="wallet">sign in with your wallet</a>.
        </p>
    </div>
}
else if (_mine.Count == 0)
{
    @* ?mine=1: the roster opens on the ALL tab and the recruit card only renders under Mine, so a bare
       link landed a hero-less player on a grid of other people's creatures with nothing to press. *@
    <div class="card muted">You need a hero first — recruit one on the <a href="heroes?mine=1">Heroes</a> page.</div>
}
else
{
    <div class="card">
        <h3 style="margin-top:0">Challenge to the death</h3>
        <p class="muted" style="margin-top:0">
            Both fighters stake their <b>hero + equipped gear</b> into one covenant escrow. The deterministic
            duel is resolved by the challenger; the emulator routes the winner's hero and <b>all</b> staked gear
            to the winner and <b>burns the loser's hero on-chain — permanently</b>. No XP, no take-backs.
        </p>

        <label>Your champion
            <select @bind="_myHeroId" @bind:after="OnHeroPicked" disabled="@_busy">
                <option value="">— pick a hero —</option>
                @foreach (var h in _mine)
                {
                    <option value="@h.Id">@HeroLabels.Option(h, _mine)</option>
                }
            </select>
        </label>

        @if (!string.IsNullOrEmpty(_myHeroId))
        {
            @if (_loadingOpps)
            {
                <div class="status-line" style="margin-top:.8rem"><span class="dot wait"></span> finding opponents…</div>
            }
            else if (_opponents.Count == 0)
            {
                <div class="status-line muted" style="margin-top:.8rem">No opponents yet — other players need heroes to challenge.</div>
            }
            else
            {
                <div class="muted" style="margin:.9rem 0 .4rem;font-size:.82rem">Pick your victim (or your executioner):</div>
                <div class="oppgrid">
                    @foreach (var o in _opponents)
                    {
                        <button class="oppcard @(o.Hero.Id == _oppId ? "sel" : "")" @onclick="() => Select(o.Hero.Id)" disabled="@_busy">
                            <div class="oppcard-head">
                                <b>@o.Hero.Name</b>
                                <span class="chip @(o.Favor == "favored" ? "ok" : o.Favor == "underdog" ? "" : "")">@o.Favor</span>
                            </div>
                            @* Parens are load-bearing: a bare L@o.Hero.Level trips Razor's email-address
                               heuristic (letter, @, dotted chain) and renders VERBATIM. *@
                            <div class="mono oppcard-stats">L@(o.Hero.Level) · pow @o.PowerScore (Δ@(o.PowerGapPercent)%)</div>
                        </button>
                    }
                </div>
            }
        }

        <label class="dm-absorb" style="margin-top:.9rem">
            <input type="checkbox" @bind="_absorb" disabled="@_busy" />
            Absorb mode — on a win, your hero may re-mint absorbing one of the loser's traits
        </label>

        @if (!_pendingConfirm)
        {
            <button class="btn danger" style="margin-top:1rem" @onclick="() => _pendingConfirm = true"
                    disabled="@(_busy || string.IsNullOrEmpty(_myHeroId) || string.IsNullOrEmpty(_oppId))">
                Open death-match…
            </button>
        }
        else
        {
            <div class="card err" style="margin-top:1rem; display:block">
                <div class="status-line"><span class="dot bad"></span>
                    <span><b>PERMADEATH.</b> If <b>@MyHeroLabel</b> loses, it burns forever and you forfeit its staked gear.
                    You are the <b>@(Opp?.Favor ?? "even")</b> here.</span>
                </div>
                <div style="margin-top:.8rem; display:flex; gap:.6rem">
                    <button class="btn danger" @onclick="DoOpen" disabled="@_busy">Stake @MyHeroLabel &amp; commit</button>
                    <button class="btn ghost" @onclick="() => _pendingConfirm = false" disabled="@_busy">Cancel</button>
                </div>
            </div>
        }

        @if (_status is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div>
        }
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div>
        }
    </div>

    <div class="page-head" style="margin-top:1.8rem">
        <h3 style="margin:0">Your death-matches</h3>
        <span class="spacer"></span>
        <button class="btn ghost sm" @onclick="Reload" disabled="@_busy">Refresh</button>
    </div>

    @if (!ToAccept.Any() && !ToSettle.Any() && !Waiting.Any() && !AwaitingOpponent.Any() && !History.Any())
    {
        <div class="card muted">No open death-matches. Challenge a rival above — or wait for one to come for you.</div>
    }
    else
    {
        @if (ToAccept.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Someone wants your hero dead — accept &amp; stake</div>
                @foreach (var d in ToAccept)
                {
                    <div class="match-row">
                        <span>Their <b>@Name(d.ChallengerHeroId)</b> vs your <b>@Name(d.DefenderHeroId)</b>@(d.Absorb ? " · absorb" : "")</span>
                        <span class="spacer"></span>
                        <button class="btn danger sm" @onclick="() => DoAccept(d.DeathMatchId)" disabled="@_busy">Accept to the death</button>
                    </div>
                }
            </div>
        }
        @if (ToSettle.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Both staked — resolve it</div>
                @foreach (var d in ToSettle)
                {
                    <div class="match-row">
                        <span>Your <b>@Name(d.ChallengerHeroId)</b> vs <b>@Name(d.DefenderHeroId)</b>@(d.Absorb ? " · absorb" : "")</span>
                        <span class="spacer"></span>
                        <button class="btn danger sm" @onclick="() => DoSettle(d.DeathMatchId)" disabled="@_busy">Settle</button>
                    </div>
                }
            </div>
        }
        @if (AwaitingOpponent.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Staked to the death — waiting for the challenger to fight</div>
                @foreach (var d in AwaitingOpponent)
                {
                    <div class="match-row muted">
                        <span>Your <b>@Name(d.DefenderHeroId)</b> vs <b>@Name(d.ChallengerHeroId)</b>@(d.Absorb ? " · absorb" : "")</span>
                        <span class="spacer"></span>
                        <span class="chip">accepted</span>
                    </div>
                }
            </div>
        }
        @if (Waiting.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Waiting for your opponent to accept</div>
                @foreach (var d in Waiting)
                {
                    <div class="match-row muted">
                        <span>Your <b>@Name(d.ChallengerHeroId)</b> vs <b>@Name(d.DefenderHeroId)</b>@(d.Absorb ? " · absorb" : "")</span>
                        <span class="spacer"></span>
                        <span class="chip">open</span>
                    </div>
                }
            </div>
        }
        @* The graveyard. A settled death-match used to leave no trace here at all — the page went straight
           back to "No open death-matches" over a hero that had been destroyed forever. *@
        @if (History.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Settled — a hero died</div>
                @foreach (var d in History)
                {
                    <div class="match-row muted">
                        <span>
                            <b>@Name(d.ChallengerHeroId)</b> vs <b>@Name(d.DefenderHeroId)</b>@(d.Absorb ? " · absorb" : "")
                            @if (d.WinnerHeroId is { } w)
                            {
                                <text> · ☠ <b>@Name(d.ChallengerHeroId == w ? d.DefenderHeroId : d.ChallengerHeroId)</b> burned</text>
                            }
                        </span>
                        <span class="spacer"></span>
                        @if (IWon(d) is { } won)
                        {
                            <span class="chip @(won ? "ok" : "bad")">@(won ? "you won" : "you lost")</span>
                        }
                        <a class="btn ghost sm" href="watch/@d.DeathMatchId">Replay ↗</a>
                    </div>
                }
            </div>
        }
    }

    @if (_dm is not null)
    {
        var s = _dm.Settle;
        var winnerName = s.WinnerHeroId == s.ChallengerSnapshot.Id ? s.ChallengerSnapshot.Name : s.DefenderSnapshot.Name;
        var loserName = s.LoserHeroId == s.ChallengerSnapshot.Id ? s.ChallengerSnapshot.Name : s.DefenderSnapshot.Name;
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Death-match resolved</h3>
            <span class="hud">winner takes the spoils</span>
        </div>
        <BattleArena A="s.ChallengerSnapshot" B="s.DefenderSnapshot" Fight="s.Result" />
        <div class="card" style="margin-top:1.2rem">
            <div class="status-line"><span class="dot bad"></span> <span>☠ <b>@loserName</b> is dead — burned on-chain.</span></div>
            <div class="status-line" style="margin-top:.4rem"><span class="dot ok"></span> <span><b>@winnerName</b> takes the win and all staked gear (@s.Result.Turns turns).</span></div>
            @if (_dm.Settle.Minted)
            {
                <div class="status-line" style="margin-top:.4rem"><span class="dot ok"></span>
                    <span>✦ <b>@winnerName</b> absorbed <b>@s.TraitsAbsorbed</b> trait(s) and re-minted as a new hero.</span>
                </div>
            }
            <div class="status-line" style="margin-top:.7rem">
                <span class="dot @(_dm.FairnessOk ? "ok" : "bad")"></span>
                <span class="mono" style="font-size:.78rem">@(_dm.FairnessOk ? $"fairness ✓ {_dm.FairnessDetail}" : $"fairness ✗ server cheated: {_dm.FairnessDetail}")</span>
            </div>
            @if (_resolvedId is not null)
            {
                <div class="status-line" style="margin-top:.8rem">
                    <a class="btn ghost sm" href="watch/@_resolvedId">Share replay ↗</a>
                    <span class="muted" style="font-size:.78rem">anyone can watch this permakill — no login</span>
                </div>
            }
            @if (_dm.AbsorbOk is not null)
            {
                <div class="status-line" style="margin-top:.4rem">
                    <span class="dot @(_dm.AbsorbOk == true ? "ok" : "bad")"></span>
                    <span class="mono" style="font-size:.78rem">@(_dm.AbsorbOk == true ? $"absorb ✓ {_dm.AbsorbDetail}" : $"absorb ✗ server cheated: {_dm.AbsorbDetail}")</span>
                </div>
            }
        </div>
    }
}

@code {
    private List<HeroDto> _mine = new();
    private List<DeathMatchDto> _dms = new();
    private List<OpponentSuggestionDto> _opponents = new();
    private readonly Dictionary<string, string> _names = new();
    private string _myHeroId = "";
    private string _oppId = "";
    private bool _absorb;
    private bool _pendingConfirm;
    private bool _loading = true;
    private bool _loadingOpps;
    private bool _busy;
    private bool _heroesLoaded;
    private string? _status;
    private string? _error;
    private DeathMatchOutcome? _dm;
    private string? _resolvedId;   // the just-settled death-match, for the shareable replay link

    private HeroDto? MyHero => _mine.FirstOrDefault(h => h.Id == _myHeroId);

    /// <summary>Disambiguated, because this names the hero about to be staked to permadeath.</summary>
    private string? MyHeroLabel => MyHero is { } h ? HeroLabels.Name(h, _mine) : null;
    private OpponentSuggestionDto? Opp => _opponents.FirstOrDefault(o => o.Hero.Id == _oppId);

    private HashSet<string> MineIds => _mine.Select(h => h.Id).ToHashSet();

    /// <summary>Every hero id that has been in my roster since this page loaded. A death-match BURNS the
    /// loser, so the live roster stops being able to name the player it happened to at exactly the moment
    /// it matters — this remembers.</summary>
    private readonly HashSet<string> _everMine = new();
    private IEnumerable<DeathMatchDto> ToAccept => _dms.Where(d => d.Status == "open" && MineIds.Contains(d.DefenderHeroId));
    private IEnumerable<DeathMatchDto> ToSettle => _dms.Where(d => d.Status == "accepted" && MineIds.Contains(d.ChallengerHeroId));
    private IEnumerable<DeathMatchDto> Waiting => _dms.Where(d => d.Status == "open" && MineIds.Contains(d.ChallengerHeroId));

    /// <summary>
    /// Accepted, with me as the DEFENDER: staked to the death and waiting on the challenger, who is the
    /// only one who may settle. ToAccept is open+defender and ToSettle is accepted+CHALLENGER, so the
    /// instant a defender accepted, their death-match belonged to no bucket and disappeared — accepting a
    /// challenge to the death looked like it had done nothing at all.
    /// </summary>
    private IEnumerable<DeathMatchDto> AwaitingOpponent =>
        _dms.Where(d => d.Status == "accepted" && MineIds.Contains(d.DefenderHeroId));

    /// <summary>
    /// Death-matches that already happened. The server's vocabulary is exactly open | accepted | resolved,
    /// and NOTHING rendered the last of those: a settled death-match dropped out of every bucket, so the
    /// page went back to reading "No open death-matches" — over a hero that had been burned on-chain,
    /// permanently. The loser never even runs Settle, so for them this was the only place the outcome could
    /// ever have appeared, and it never did.
    ///
    /// <para>Matched against <see cref="_everMine"/>, not the live roster. The LOSER's hero is burned, so it
    /// is gone from <c>MineIds</c> the moment the thing worth telling them about happens — matching on the
    /// current roster would have shown this row to the winner and to nobody else.</para>
    ///
    /// <para>KNOWN LIMIT, stated rather than papered over: <c>_everMine</c> only spans this page's lifetime.
    /// A player who loses a hero and comes back in a new tab still cannot see that death-match here,
    /// because <c>DeathMatchDto</c> carries hero ids and no owner — attributing a burned hero to its former
    /// owner needs a field the server does not publish. Their own settle panel and /account still show it.</para>
    /// </summary>
    private IEnumerable<DeathMatchDto> History =>
        _dms.Where(d => d.Status == "resolved"
                     && (_everMine.Contains(d.ChallengerHeroId) || _everMine.Contains(d.DefenderHeroId)));

    /// <summary>Did MY hero win it? Null when the row names neither side as a winner yet.</summary>
    private bool? IWon(DeathMatchDto d) =>
        d.WinnerHeroId is not { } w ? null : MineIds.Contains(w);

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            foreach (var h in _mine) { _names[h.Id] = h.Name; _everMine.Add(h.Id); }
            await LoadDeathMatchesAsync();
            _heroesLoaded = true;
        }
        catch
        {
            // A swallowed read used to leave the page permanently empty: OnState only re-runs on the NEXT
            // state change, and a server hiccup produces none — so a one-off failure looked exactly like
            // owning no heroes, forever. Retry on our own rather than waiting for an event that may never
            // come. Short backoff; the sign-in path still covers the not-yet-authenticated case.
            await RetryLoadAsync();
        }
        finally { _loading = false; }
    }

    async Task LoadDeathMatchesAsync()
    {
        _dms = await Api.DeathMatch.ListAsync();
        var mineIds = _mine.Select(h => h.Id).ToHashSet();
        var needed = _dms
            .Where(d => mineIds.Contains(d.ChallengerHeroId) || mineIds.Contains(d.DefenderHeroId))
            .SelectMany(d => new[] { d.ChallengerHeroId, d.DefenderHeroId })
            .Where(id => !_names.ContainsKey(id))
            .Distinct();
        foreach (var id in needed)
        {
            try { _names[id] = (await Api.Heroes.GetAsync(id)).Name; } catch { /* best-effort (a burned hero 404s) */ }
        }
    }

    async Task OnHeroPicked()
    {
        _oppId = "";
        _pendingConfirm = false;
        _opponents = new();
        if (string.IsNullOrEmpty(_myHeroId)) return;
        _loadingOpps = true;
        try { _opponents = await Api.Matches.MatchmakingAsync(_myHeroId); }
        catch { _opponents = new(); }
        finally { _loadingOpps = false; }
    }

    void Select(string heroId) { _oppId = heroId; _pendingConfirm = false; }

    async Task DoOpen()
    {
        _pendingConfirm = false;
        await RunAction("Opening the death-match…", async () =>
        {
            await Session.OpenDeathMatchAsync(_myHeroId, _oppId, _absorb, s => { _status = s; StateHasChanged(); });
            _oppId = "";
        });
    }

    async Task DoAccept(string id) =>
        await RunAction("Accepting…", () => Session.AcceptDeathMatchAsync(id, s => { _status = s; StateHasChanged(); }));

    async Task DoSettle(string id) =>
        await RunAction("Resolving…", async () =>
        {
            _resolvedId = id;
            _dm = await Session.SettleDeathMatchAsync(id, s => { _status = s; StateHasChanged(); });
        });

    async Task RunAction(string initial, Func<Task> action)
    {
        // Claimed BEFORE the first await. disabled="@_busy" only takes effect at the next render, which
        // happens at that first await — so a second click dispatched in the window between it ran the
        // whole action again. On this page that means staking a second hero to the death.
        if (_busy) return;
        _busy = true;
        _error = null;
        _status = initial;
        try
        {
            await action();
            _status = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        // Reload even when the action threw: open/accept create the death-match on the SERVER first and
        // stake the hero + fee second, so a failed payment still leaves a real match behind — reloading
        // only on success hid it behind an error message, which is the state the player most needs to see.
        finally
        {
            await LoadAsync();
            _busy = false;
        }
    }

    async Task Reload()
    {
        _busy = true;
        try { await LoadDeathMatchesAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string Name(string heroId) =>
        _names.TryGetValue(heroId, out var n) ? n : heroId[..Math.Min(8, heroId.Length)];

    void OnState() => InvokeAsync(async () =>
    {
        if (State.IsSignedIn && !_heroesLoaded && !_loading)
            await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;

    /// <summary>
    /// Re-attempts the roster read a few times, backing off. Deliberately bounded: past a few seconds the
    /// honest answer is the "couldn't read your roster" card, not a page that spins forever.
    /// </summary>
    async Task RetryLoadAsync()
    {
        foreach (var delay in new[] { 400, 1200, 3000 })
        {
            await Task.Delay(delay);
            if (_heroesLoaded || !State.IsSignedIn) return;
            try
            {
                _mine = await Api.Heroes.MineAsync();
                _heroesLoaded = true;
                StateHasChanged();
                return;
            }
            catch { /* keep backing off; the card below stays honest if we never succeed */ }
        }
    }

}
