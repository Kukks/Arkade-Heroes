@page "/duel"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@implements IDisposable

<PageTitle>Duel · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Duel</h2>
    <span class="hud">staked PvP · covenant-escrowed · winner takes the pot</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then challenge a rival.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the arena…</div>
}
@* "You have no heroes" and "we never managed to read your roster" are different facts, and this
   branch used to state the first while meaning either. A load that returns early because sign-in has
   not resumed yet, or one that throws and is swallowed, both leave _mine empty — and the page then
   told a player with a full roster to go and claim starters. Only _heroesLoaded distinguishes them. *@
else if (!_heroesLoaded)
{
    <div class="card muted">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your roster.</div>
        <p class="muted" style="margin:.6rem 0 0">
            If you're signed in, reload the page. If not, <a href="wallet">sign in with your wallet</a>.
        </p>
    </div>
}
else if (_mine.Count == 0)
{
    @* ?mine=1: the roster opens on the ALL tab and the recruit card only renders under Mine, so a bare
       link landed a hero-less player on a grid of other people's creatures with nothing to press. *@
    <div class="card muted">You need a hero first — recruit one on the <a href="heroes?mine=1">Heroes</a> page.</div>
}
else
{
    <div class="card">
        <h3 style="margin-top:0">Challenge a rival</h3>
        @* "An underdog risks nothing" was false and this page already knew it. Matchmaking.Favor calls a
           hero "underdog" from THREE levels down, while XpIfLose only reaches zero at four — so an
           underdog by the chip's own definition can still be charged XP for losing. The freeShot flag
           below is the honest test (Favor == underdog AND XpIfYouLose == 0); the prose now defers to it
           instead of stating the strong version of what it means. *@
        <p class="muted" style="margin-top:0">
            @* "a small match fee" — the page is about to state the number, and it is not the page's place
               to call someone else's money small. *@
            Both of you stake the wager into your own covenant escrow and pay a match fee. The
            deterministic duel is resolved by the challenger; the emulator sweeps the whole pot to the
            winner. XP is a conserved transfer: beating a higher hero takes a lot off it, and beating a
            much weaker one takes nothing. Past a wide enough gap losing costs the underdog no XP at
            all — the opponents below say <b>free shot</b> when that is actually true of them.
        </p>
        <label>Your champion
            <select @bind="_myHeroId" @bind:after="OnHeroPicked">
                <option value="">— pick a hero —</option>
                @foreach (var h in _mine)
                {
                    <option value="@h.Id">@h.Name — lvl @h.Level · @(h.Rarity?.Tier ?? "Common")</option>
                }
            </select>
        </label>

        @if (!string.IsNullOrEmpty(_myHeroId))
        {
            @if (_loadingOpps)
            {
                <div class="status-line" style="margin-top:.8rem"><span class="dot wait"></span> finding opponents…</div>
            }
            else if (_opponents.Count == 0)
            {
                <div class="status-line muted" style="margin-top:.8rem">No opponents yet — other players need heroes to challenge.</div>
            }
            else
            {
                <div class="muted" style="margin:.9rem 0 .4rem;font-size:.82rem">Pick an opponent (closest match first):</div>
                <div class="oppgrid">
                    @foreach (var o in _opponents)
                    {
                        var freeShot = o.Favor == "underdog" && o.XpIfYouLose == 0;
                        <button class="oppcard @(o.Hero.Id == _oppId ? "sel" : "")" @onclick="() => _oppId = o.Hero.Id">
                            <div class="oppcard-head">
                                <b>@o.Hero.Name</b>
                                <span class="chip @(freeShot ? "ok" : "")">@(freeShot ? "free shot" : o.Favor)</span>
                            </div>
                            <div class="mono oppcard-stats">
                                @* Parens are load-bearing: a bare L@o.Hero.Level trips Razor's email-address
                                   heuristic (letter, @, dotted chain) and renders VERBATIM. *@
                                L@(o.Hero.Level) · pow @o.PowerScore (Δ@(o.PowerGapPercent)%)
                            </div>
                            <div class="mono oppcard-xp">win <b class="pos">+@o.XpIfYouWin</b> / lose <b class="neg">-@o.XpIfYouLose</b> xp</div>
                        </button>
                    }
                </div>
            }
        }

        <label style="margin-top:1rem">Wager (sats, each side stakes this)
            <input type="number" min="1" step="100" @bind="_wager" />
        </label>

        @* "A small match fee" was the whole disclosure. It is real money, it scales with your hero's level,
           and both sides pay it — so it gets a number. *@
        @if (MatchFee is { } fee)
        {
            <p class="muted" style="margin:.5rem 0 0;font-size:.85rem">
                Plus a <b>@fee.ToString("N0") sat</b> match fee, scaled to your hero's level — so a challenge
                costs you <b>@((_wager + fee).ToString("N0")) sats</b> up front. Your opponent pays the same
                against their own level when they accept.
            </p>
        }

        <button class="btn primary" style="margin-top:1rem" @onclick="DoChallenge"
                disabled="@(_busy || string.IsNullOrEmpty(_myHeroId) || string.IsNullOrEmpty(_oppId) || _wager < 1)">
            @(_busy ? "Working…" : "Challenge")
        </button>
        @if (_status is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div>
        }
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div>
        }
    </div>

    <div class="page-head" style="margin-top:1.8rem">
        <h3 style="margin:0">Your matches</h3>
        <span class="spacer"></span>
        <button class="btn ghost sm" @onclick="Reload" disabled="@_busy">Refresh</button>
    </div>

    @* "We couldn't read your matches" must not render as "you have none": the reload path can recover the
       roster while leaving the match list empty, and this page then states the absence of a duel you are
       staked into as fact. *@
    @if (!_matchesLoaded)
    {
        <div class="card">
            <div class="status-line"><span class="dot bad"></span> Couldn't read your matches.</div>
            <p class="muted" style="margin:.6rem 0 0">
                This is not the same as having none — any duel you have opened or accepted is still live.
                @_matchesError
            </p>
            <button class="btn primary sm" style="margin-top:.7rem" @onclick="Reload" disabled="@_busy">Try again</button>
        </div>
    }
    else if (!ToAccept.Any() && !ToResolve.Any() && !Waiting.Any() && !AwaitingOpponent.Any()
         && !History.Any() && !Expired.Any())
    {
        <div class="card muted">No open matches. Challenge a rival above — or wait for someone to challenge you.</div>
    }
    else
    {
        @if (ToAccept.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Your turn — accept &amp; stake</div>
                @foreach (var m in ToAccept)
                {
                    <div class="match-row">
                        <span>Their <b>@Name(m.ChallengerHeroId)</b> challenges your <b>@Name(m.DefenderHeroId)</b> · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <button class="btn primary sm" @onclick="() => DoAccept(m.MatchId)" disabled="@_busy">Accept</button>
                    </div>
                }
            </div>
        }
        @if (ToResolve.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Ready — resolve the duel</div>
                @foreach (var m in ToResolve)
                {
                    <div class="match-row">
                        <span>Your <b>@Name(m.ChallengerHeroId)</b> vs <b>@Name(m.DefenderHeroId)</b> · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <button class="btn primary sm" @onclick="() => DoDuel(m.MatchId)" disabled="@_busy">Duel!</button>
                    </div>
                }
            </div>
        }
        @* Both sides can now see an accepted duel. The defender's copy is read-only — the challenger
           runs the fight — but it exists, which is the part that was missing. *@
        @if (AwaitingOpponent.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Accepted — waiting for the challenger to fight</div>
                @foreach (var m in AwaitingOpponent)
                {
                    <div class="match-row muted">
                        <span>Your <b>@Name(m.DefenderHeroId)</b> vs <b>@Name(m.ChallengerHeroId)</b> · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <span class="chip">accepted</span>
                    </div>
                }
            </div>
        }

        @* Abandoned. Says where the money went and points at the page that can get it back — an expired
           match used to render nowhere, which made a stranded stake invisible from the page that took it. *@
        @if (Expired.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Abandoned — the match never completed</div>
                @foreach (var m in Expired)
                {
                    <div class="match-row muted">
                        <span><b>@Name(m.ChallengerHeroId)</b> vs <b>@Name(m.DefenderHeroId)</b> · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <span class="chip bad">expired</span>
                        <a class="btn ghost sm" href="reclaim">Recover your stake ↗</a>
                    </div>
                }
            </div>
        }

        @* What happened before. A resolved duel used to leave no trace on this page at all. *@
        @if (History.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Past duels</div>
                @foreach (var m in History)
                {
                    <div class="match-row muted">
                        <span>
                            <b>@Name(m.ChallengerHeroId)</b> vs <b>@Name(m.DefenderHeroId)</b>
                            · <b class="mono">@m.WagerSats.ToString("N0")</b> sats
                        </span>
                        <span class="spacer"></span>
                        @if (IWon(m) is { } won)
                        {
                            <span class="chip @(won ? "ok" : "bad")">@(won ? "won" : "lost")</span>
                        }
                        <a class="btn ghost sm" href="watch/@m.MatchId">Replay ↗</a>
                    </div>
                }
            </div>
        }

        @if (Waiting.Any())
        {
            <div class="card">
                <div class="hud" style="margin-bottom:.6rem">Waiting for your opponent to accept</div>
                @foreach (var m in Waiting)
                {
                    <div class="match-row muted">
                        <span>Your <b>@Name(m.ChallengerHeroId)</b> vs <b>@Name(m.DefenderHeroId)</b> · <b class="mono">@m.WagerSats.ToString("N0")</b> sats</span>
                        <span class="spacer"></span>
                        <span class="chip">open</span>
                    </div>
                }
            </div>
        }
    }

    @if (_duel is not null)
    {
        var f = _duel.Fight;
        var challengerWon = f.Result.WinnerId == f.ChallengerSnapshot.Id;
        var winner = challengerWon ? f.ChallengerSnapshot : f.DefenderSnapshot;
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Duel resolved</h3>
            <span class="hud">the pot swept to the winner</span>
        </div>
        <BattleArena A="f.ChallengerSnapshot" B="f.DefenderSnapshot" Fight="f.Result" />
        <div class="card" style="margin-top:1.2rem">
            <div class="status-line">
                <span class="dot ok"></span>
                <span><b>@winner.Name</b> wins — <b class="mono">@f.WinnerPayoutSats.ToString("N0")</b> sats to the winner’s wallet</span>
            </div>
            <div class="status-line" style="margin-top:.5rem">
                <span class="mono" style="font-size:.82rem">
                    @f.ChallengerSnapshot.Name <b class="@(challengerWon ? "pos" : "neg")">@Signed(f.ChallengerXpAward)</b> xp ·
                    @f.DefenderSnapshot.Name <b class="@(challengerWon ? "neg" : "pos")">@Signed(f.DefenderXpAward)</b> xp ·
                    @f.Result.Turns turns
                </span>
            </div>
            <div class="status-line" style="margin-top:.7rem">
                <span class="dot @(_duel.FairnessOk ? "ok" : "bad")"></span>
                <span class="mono" style="font-size:.78rem">@(_duel.FairnessOk ? $"fairness ✓ {_duel.FairnessDetail}" : $"fairness ✗ server cheated: {_duel.FairnessDetail}")</span>
            </div>
            @if (_resolvedMatchId is not null)
            {
                <div class="status-line" style="margin-top:.8rem">
                    <a class="btn ghost sm" href="watch/@_resolvedMatchId">Share replay ↗</a>
                    <span class="muted" style="font-size:.78rem">anyone can watch + verify this fight — no login</span>
                </div>
            }
        </div>
    }
}

@code {
    private List<HeroDto> _mine = new();
    private List<MatchDto> _matches = new();
    private List<OpponentSuggestionDto> _opponents = new();
    private readonly Dictionary<string, string> _names = new();
    private string _myHeroId = "";
    private string _oppId = "";
    private long _wager = 1000;
    private bool _loading = true;
    private bool _loadingOpps;
    private bool _busy;
    private bool _heroesLoaded;

    /// <summary>The match list read succeeded. Distinct from "you have no matches": a matches read that
    /// threw used to leave this page confidently announcing "No open matches" over a staked, live duel —
    /// the roster retry below only re-reads HEROES, so nothing else would ever have said otherwise.</summary>
    private bool _matchesLoaded;
    private string? _status;
    private string? _error;
    private string? _matchesError;
    private GameConfigDto? _config;

    /// <summary>What a challenge with the picked hero costs on top of the wager. Null until a hero is
    /// chosen and the config is read — an unknown price is stated as unknown, never as zero.</summary>
    private long? MatchFee => _mine.FirstOrDefault(h => h.Id == _myHeroId) is { } h
        ? Pricing.MatchFee(_config, h.Level)
        : null;

    private DuelOutcome? _duel;
    private string? _resolvedMatchId;   // the just-resolved match, for the shareable replay link

    /// <summary>
    /// How often the match list re-reads itself while this page is open.
    ///
    /// <para>A duel is resolved by the CHALLENGER, so the defender's copy of it changes because of
    /// something that happens in someone else's browser. Drawn once, it could never be right again: the
    /// challenger pressed "Duel!", the pot moved, and the defender kept reading "Accepted — waiting for
    /// the challenger to fight" until they refreshed by hand. Polled rather than pushed, and for the same
    /// reason <see cref="ArkadeHeroes.Web.Components.ChallengeAlert"/> polls — there is no live channel to
    /// the server, and one built for this would be a lot of machinery for a fact that can be seconds
    /// stale without hurting anyone.</para>
    ///
    /// <para>Tighter than the alert's thirty seconds because the audiences differ: that is a background
    /// badge telling you something is waiting, this is a player watching a staked fight they cannot start.</para>
    ///
    /// <para>A parameter only so a test does not have to wait out the live cadence. The router never sets
    /// it — <c>/duel</c> takes no route values — and nothing else does either.</para>
    /// </summary>
    [Parameter] public TimeSpan PollEvery { get; set; } = TimeSpan.FromSeconds(15);

    // Match categorisation, by whether my roster holds the challenger/defender hero.
    private HashSet<string> MineIds => _mine.Select(h => h.Id).ToHashSet();
    private IEnumerable<MatchDto> ToAccept => _matches.Where(m => m.Status == "open" && MineIds.Contains(m.DefenderHeroId));
    private IEnumerable<MatchDto> ToResolve => _matches.Where(m => m.Status == "accepted" && MineIds.Contains(m.ChallengerHeroId));
    private IEnumerable<MatchDto> Waiting => _matches.Where(m => m.Status == "open" && MineIds.Contains(m.ChallengerHeroId));

    /// <summary>
    /// Accepted matches where I am the DEFENDER — the bucket that did not exist.
    ///
    /// <para>ToAccept covers open+defender and ToResolve covers accepted+CHALLENGER, so the instant a
    /// defender accepted, their match belonged to no bucket and vanished from their page while the
    /// challenger kept it and gained the "duel" button. Accepting appeared to do nothing, and the two
    /// players saw different games.</para>
    ///
    /// <para>Read-only on purpose: the challenger runs the fight, so the defender's job here is to see
    /// that their acceptance landed and what it staked.</para>
    /// </summary>
    private IEnumerable<MatchDto> AwaitingOpponent =>
        _matches.Where(m => m.Status == "accepted" && MineIds.Contains(m.DefenderHeroId));

    /// <summary>
    /// Matches the server has given up on. Every match this page opens is a COVENANT match, and
    /// <c>ReconcileAbandonedMatchesAsync</c> marks one "expired" once its refund window passes with a stake
    /// missing — so this is a real, reachable status with no <c>Result</c>.
    ///
    /// <para>It matched none of the four live buckets and none of History (which keys off Result), so it
    /// fell through the page entirely: a match you had staked into simply stopped existing here, while the
    /// sats sat in an escrow only /reclaim knows about. Exactly the fall-through that broke duels once
    /// before, one status further along.</para>
    /// </summary>
    private IEnumerable<MatchDto> Expired =>
        _matches.Where(m => m.Status == "expired"
                         && (MineIds.Contains(m.ChallengerHeroId) || MineIds.Contains(m.DefenderHeroId)));

    /// <summary>
    /// Duels of mine that already happened. Nothing recorded what a player had been through — a resolved
    /// match dropped out of every bucket and the page went back to looking like nothing had occurred, even
    /// though sats had moved and the replay was on the server the whole time.
    ///
    /// <para>Read from the same list the live buckets use, so no new endpoint and nothing to keep in sync.
    /// The server already returns matches newest-first and capped.</para>
    /// </summary>
    /// <para>Matched on the STATUS as well as the presence of a result. Keying off Result alone left the
    /// page's bucket set silently coupled to the two moving together on the server: a match marked
    /// "resolved" whose result had not been attached would have matched no bucket at all, which is the
    /// failure mode this whole set of buckets exists to avoid.</para>
    private IEnumerable<MatchDto> History =>
        _matches.Where(m => (m.Result is not null || m.Status == "resolved")
                         && (MineIds.Contains(m.ChallengerHeroId) || MineIds.Contains(m.DefenderHeroId)));

    /// <summary>Did MY hero win it? Null when the result names neither of mine.</summary>
    private bool? IWon(MatchDto m) =>
        m.Result is not { } r ? null : MineIds.Contains(r.WinnerId);

    private Timer? _poll;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
        _poll = new Timer(_ => _ = PollTickAsync(), null, PollEvery, PollEvery);
    }

    /// <summary>
    /// The timer's own callback, and the reason it is not simply <c>async _ => await InvokeAsync(...)</c>
    /// the way <see cref="ArkadeHeroes.Web.Components.ChallengeAlert"/> writes it.
    ///
    /// <para>That component rides the shell and is never disposed while the app is running. This is a
    /// PAGE, so navigating away disposes it — and a tick already queued at that moment reaches
    /// <c>InvokeAsync</c> after the renderer has gone and throws <see cref="ObjectDisposedException"/>.
    /// From a <c>TimerCallback</c> that exception is unobserved: nothing awaits it, so it surfaces as a
    /// console error on a player who did nothing but leave the page — and the browser walk suite asserts
    /// zero console errors.</para>
    ///
    /// <para>Swallowed rather than guarded with a flag, because the teardown is a race no flag closes: the
    /// component can be disposed after the check and before the dispatch. There is nothing to report here
    /// anyway — the page this would have redrawn no longer exists.</para>
    /// </summary>
    async Task PollTickAsync()
    {
        try { await InvokeAsync(PollAsync); }
        catch (ObjectDisposedException) { /* navigated away mid-tick; nothing left to refresh */ }
    }

    /// <summary>
    /// Re-reads the match list on a timer so a duel resolved in the OTHER player's browser lands here too.
    ///
    /// <para>Matches only — not the roster, not the config. Those change when this player does something,
    /// and this page already reloads them when they do; the match list is the one thing on the screen that
    /// a stranger can change.</para>
    ///
    /// <para>Stands down while an action is in flight: <see cref="RunAction"/> reloads everything itself
    /// when it finishes, and a poll landing mid-challenge would swap the list out from under a staking
    /// player for no gain.</para>
    /// </summary>
    async Task PollAsync()
    {
        if (_busy || _loading || !State.IsSignedIn || !_heroesLoaded) return;
        try { await LoadMatchesAsync(); }
        catch
        {
            // A dropped poll is not news. _matchesLoaded keeps whatever it already was, so a single failed
            // re-read cannot turn a correct screen into "Couldn't read your matches" — which would be a
            // worse page than the stale one this poll exists to replace.
        }
        StateHasChanged();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            foreach (var h in _mine) _names[h.Id] = h.Name;
            await LoadMatchesAsync();
            _heroesLoaded = true;
        }
        catch
        {
            // A swallowed read used to leave the page permanently empty: OnState only re-runs on the NEXT
            // state change, and a server hiccup produces none — so a one-off failure looked exactly like
            // owning no heroes, forever. Retry on our own rather than waiting for an event that may never
            // come. Short backoff; the sign-in path still covers the not-yet-authenticated case.
            await RetryLoadAsync();
        }
        finally { _loading = false; }

        try { _config ??= (await Api.Chain.InfoAsync()).Config; }
        catch { /* price unknown — the fee line stays off rather than quoting a zero */ }
    }

    /// <summary>
    /// Which match read is the current one — same discipline as the roster's <c>_rosterSeq</c> on the
    /// Heroes page, and needed here for the same reason the poll exists.
    ///
    /// <para>Adding a timer means a read can still be on the wire when the next tick fires, or when an
    /// action finishes and reloads. Keeping whichever RETURNED last rather than whichever was ISSUED last
    /// lets an older list land on top of a newer one — which would put the duel back to "accepted" after
    /// the resolution had already arrived. That is precisely the staleness the poll was added to remove,
    /// so leaving the race open would have made the fix its own defect.</para>
    /// </summary>
    private int _matchesSeq;

    async Task LoadMatchesAsync()
    {
        var seq = ++_matchesSeq;
        var matches = await Api.Matches.ListAsync();
        if (seq != _matchesSeq) return;   // superseded in flight; a newer read already owns the page
        _matches = matches;
        _matchesLoaded = true;
        _matchesError = null;
        // Resolve the opponent heroes' names for display (my own are already cached from the roster).
        var mineIds = _mine.Select(h => h.Id).ToHashSet();
        var needed = _matches
            .Where(m => mineIds.Contains(m.ChallengerHeroId) || mineIds.Contains(m.DefenderHeroId))
            .SelectMany(m => new[] { m.ChallengerHeroId, m.DefenderHeroId })
            .Where(id => !_names.ContainsKey(id))
            .Distinct();
        foreach (var id in needed)
        {
            try { _names[id] = (await Api.Heroes.GetAsync(id)).Name; } catch { /* best-effort */ }
        }
    }

    async Task OnHeroPicked()
    {
        _oppId = "";
        _opponents = new();
        if (string.IsNullOrEmpty(_myHeroId)) return;
        _loadingOpps = true;
        try { _opponents = await Api.Matches.MatchmakingAsync(_myHeroId); }
        catch { _opponents = new(); }
        finally { _loadingOpps = false; }
    }

    async Task DoChallenge()
    {
        await RunAction("Preparing the challenge…", async () =>
        {
            await Session.ChallengeAsync(_myHeroId, _oppId, _wager, s => { _status = s; StateHasChanged(); });
            _oppId = "";
        });
    }

    async Task DoAccept(string matchId) =>
        await RunAction("Accepting…", () => Session.AcceptMatchAsync(matchId, s => { _status = s; StateHasChanged(); }));

    async Task DoDuel(string matchId) =>
        await RunAction("Resolving…", async () =>
        {
            _resolvedMatchId = matchId;
            _duel = await Session.DuelAsync(matchId, s => { _status = s; StateHasChanged(); });
        });

    // Shared action wrapper: busy-gate, run, reload the roster + matches, surface errors.
    async Task RunAction(string initial, Func<Task> action)
    {
        // Claimed BEFORE the first await. disabled="@_busy" only takes effect at the next render, which
        // happens at that first await — so a second click dispatched in the window between it ran the
        // whole action again. Challenge and Accept both stake real sats and are not idempotent.
        if (_busy) return;
        _busy = true;
        _error = null;
        _status = initial;
        try
        {
            await action();
            _status = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        // Reload even when the action threw: open/accept create the match on the SERVER first and pay the
        // stake + fee second, so a failed payment still leaves a real match behind — reloading only on
        // success hid it behind an error message, which is the state the player most needs to see.
        finally
        {
            await LoadAsync();
            _busy = false;
        }
    }

    async Task Reload()
    {
        _busy = true;
        try { await LoadMatchesAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string Name(string heroId) =>
        _names.TryGetValue(heroId, out var n) ? n : heroId[..Math.Min(8, heroId.Length)];

    private static string Signed(long n) => n > 0 ? $"+{n}" : n.ToString();

    void OnState() => InvokeAsync(async () =>
    {
        if (State.IsSignedIn && !_heroesLoaded && !_loading)
            await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        State.OnChange -= OnState;
        _poll?.Dispose();
    }

    /// <summary>
    /// Re-attempts the roster read a few times, backing off. Deliberately bounded: past a few seconds the
    /// honest answer is the "couldn't read your roster" card, not a page that spins forever.
    /// </summary>
    async Task RetryLoadAsync()
    {
        foreach (var delay in new[] { 400, 1200, 3000 })
        {
            await Task.Delay(delay);
            if (_heroesLoaded || !State.IsSignedIn) return;
            try
            {
                _mine = await Api.Heroes.MineAsync();
                _heroesLoaded = true;
                // The matches too. This retried only the ROSTER, so a failure whose cause was the MATCH
                // read left _matches empty behind a page that had recovered — and the arena then said
                // "No open matches" over a staked duel. _matchesLoaded is what keeps that honest.
                try { await LoadMatchesAsync(); }
                catch (Exception mex) { _matchesError = mex.Message; }
                StateHasChanged();
                return;
            }
            catch { /* keep backing off; the card below stays honest if we never succeed */ }
        }
    }

}
