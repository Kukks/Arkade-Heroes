@page "/"
@inject ArkadeHeroesClient Api
@inject HttpClient Http
@inject NavigationManager Nav
@inject WalletState State
@inject GameSession Session
@inject TermsState Acceptance
@implements IDisposable

<PageTitle>Arkade Heroes</PageTitle>

<section class="hero-panel">
    <div>
        <div class="hud">Breed · Battle · Trade</div>
        <h1>Raise a champion.<br /><span class="neon">Take on all comers.</span></h1>
        <p>
            Every hero is one of a kind — its look, its stats and its bloodline all come from a
            genome no two creatures share. Breed them, level them, send them into the arena,
            and trade the ones you can bear to part with.
        </p>
        @* The chain is real and load-bearing, but it is not the pitch. One quiet line, below the
           fold of the eye, for the people who care that "yours" is more than a database row. *@
        <p class="muted chain-note">Heroes are yours on Bitcoin — not entries in our database.</p>

        @if (State.IsSignedIn)
        {
            <div class="btn-row">
                <button class="btn primary" @onclick="@(() => Nav.NavigateTo("heroes?mine=1"))">Enter the arena</button>
                <button class="btn ghost" @onclick="@(() => Nav.NavigateTo("market"))">Browse the market</button>
            </div>
        }
        else
        {
            @* Game-first onboarding: pick a name and play. The wallet is provisioned behind the scenes. *@
            <div class="play-box">
                <input class="wallet-input" @bind="_name" @bind:event="oninput" @onkeydown="OnKey"
                       placeholder="your arena name" aria-label="Arena name" maxlength="24" disabled="@_starting" />
                <button class="btn primary" @onclick="Play" disabled="@(_starting || string.IsNullOrWhiteSpace(_name))">
                    @(_starting ? "Summoning…" : "Play →")
                </button>
            </div>
            <p class="muted play-note">No signup, no email. Pick a name and your first two heroes are summoned.</p>
        }
        @* Outside the signed-in/out branch: a partial-failure (registered, but the starter
           mint didn't land) flips IsSignedIn, so the error must survive that switch. *@
        @if (_playError is not null)
        {
            <div class="status-line" style="margin-top:.6rem"><span class="dot bad"></span> @_playError</div>
        }
    </div>
    @* Real creatures, not a placeholder. These are drawn by the SAME genome renderer the rest of the
       game uses, from fixed genomes held below — so the first thing a visitor sees is the actual art,
       and it needs no network call, no account and no server that is awake yet. *@
    <div class="hero-art">
        <div class="showcase">
            @foreach (var (genome, name) in Showcase)
            {
                <div class="showcase-hero">
                    <HeroSprite Genome="@genome" Name="@name" Size="96" />
                    <span class="hud">@name</span>
                </div>
            }
        </div>
        <span class="hud showcase-note">every hero is one of a kind</span>
    </div>
</section>

@if (State.IsSignedIn)
{
    <DailyCard />
}

<div class="card @(_state == Conn.Ok ? "glow" : "")">
    <div class="status-line">
        <span class="dot @(_state switch { Conn.Ok => "ok", Conn.Fail => "bad", _ => "wait" })"></span>
        @(_state switch {
            Conn.Ok       => "Arena online",
            Conn.Fail     => "Arena unreachable",
            _             => "Connecting to the arena…" })
    </div>

    @if (_state == Conn.Ok && _info is not null)
    {
        <div class="chips" style="margin-top:1rem">
            <span class="chip">mode <b>@_info.Mode</b></span>
            <span class="chip">network <b>@_info.Network</b></span>
            @if (!string.IsNullOrEmpty(_info.SpeciesAssetId))
            {
                <span class="chip">species <b class="mono">@Short(_info.SpeciesAssetId)</b></span>
            }
            <span class="chip">breed fee <b>@(_info.Config?.BreedingFeeSats ?? 0) sat</b></span>
            <span class="chip">absorb odds <b>@Pct(_info.AbsorbChance)</b></span>
        </div>
    }
    else if (_state == Conn.Fail)
    {
        <p class="muted" style="margin:.8rem 0 0">
            Couldn't reach the game server. Start it with
            <span class="mono">dotnet run --project src/ArkadeHeroes.Server</span>
            (expected at <span class="mono">@_apiBase</span>).
        </p>
    }
</div>

@* Static, server-independent, and the answer to "what actually IS this?" — so it sits high,
   above the live roster strip that needs a warm backend to say anything at all. *@
<GenomeCodex />

@if (_featured.Count > 0)
{
    <div class="page-head" style="margin-top:2rem">
        <h2 style="margin:0">Featured heroes</h2>
        <span class="hud">the rarest on the ladder</span>
        <span class="spacer"></span>
        <a class="btn ghost" href="spar">Enter the arena →</a>
    </div>
    <div class="grid cols">
        @foreach (var h in _featured)
        {
            <HeroCard Hero="h" />
        }
    </div>
}

@code {
    // Fixed showcase genomes for the landing art, shared with the codex explainer via LandingGenomes.
    // Fixed on purpose: the renderer is deterministic, so these draw the same three creatures for every
    // visitor, with no API call, no account and no dependency on the server being up — the page still
    // looks like a game when the backend is cold. Their trait block [16..31] is filled rather than
    // zeroed, so the art shows the variety a real bred hero has and a gen-0 starter does not.
    private static readonly (string Genome, string Name)[] Showcase =
    [
        (LandingGenomes.Ember, "Emberfang"),
        (LandingGenomes.Tide, "Tidecaller"),
        (LandingGenomes.Glimmer, "Glimmerhusk"),
    ];

    enum Conn { Connecting, Ok, Fail }
    Conn _state = Conn.Connecting;
    ChainInfoDto? _info;
    string _apiBase = "";
    List<HeroDto> _featured = new();

    string _name = "";
    bool _starting;
    string? _playError;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        _apiBase = Http.BaseAddress?.ToString() ?? "";
        try
        {
            _info = await Api.Chain.InfoAsync();
            _state = Conn.Ok;
        }
        catch
        {
            _state = Conn.Fail;
        }

        // Showcase the rarest heroes on the ladder (best-effort — a stat, not a gate).
        try
        {
            _featured = (await Api.Heroes.AllAsync())
                .OrderByDescending(h => h.Rarity?.Score ?? 0)
                .ThenByDescending(h => h.Level)
                .Take(4).ToList();
        }
        catch { /* no roster yet — the strip just stays hidden */ }
    }

    async Task Play()
    {
        if (_starting || string.IsNullOrWhiteSpace(_name)) return;
        // Claim the re-entrancy guard BEFORE the first await. The terms prompt suspends here for as long as
        // the player takes to read, and a second Play in that window would otherwise sail past this check
        // and register (and claim starters) twice off the one acceptance.
        _starting = true;
        _playError = null;
        try
        {
            // THE GATE. Nothing irreversible has happened yet — no wallet exists, no player is registered,
            // no starter has been minted. StartPlayingAsync does all three, so the terms have to be accepted
            // here, before it is called at all. Declining just returns: the player is where they started.
            if (!await Acceptance.RequestAcceptanceAsync(State.Player)) return;

            await Session.StartPlayingAsync(_name.Trim());
            Nav.NavigateTo("heroes?mine=1");
        }
        catch (Exception ex)
        {
            // Registered but the starter mint may not have landed (e.g. treasury syncing) — the
            // player can retry from the Heroes page; surface the reason without losing the session.
            _playError = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Play();
    }

    static string Short(string s) => s.Length <= 12 ? s : $"{s[..6]}…{s[^4..]}";
    static string Pct(byte chance) => $"{(int)Math.Round(chance / 256.0 * 100)}%";

    void OnState() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChange -= OnState;
}
