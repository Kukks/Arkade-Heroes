@page "/gauntlet"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Gauntlet · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Gauntlet</h2>
    <span class="hud">solo PvE · @ArkadeHeroes.Core.Progression.Gauntlet.WaveCount escalating ghost waves</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then run the gauntlet.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading your heroes…</div>
}
@* "You have no heroes" and "we never managed to read your roster" are different facts, and this
   branch used to state the first while meaning either. A load that returns early because sign-in has
   not resumed yet, or one that throws and is swallowed, both leave _mine empty — and the page then
   told a player with a full roster to go and claim starters. Only _heroesLoaded distinguishes them. *@
else if (!_heroesLoaded)
{
    <div class="card muted">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your roster.</div>
        <p class="muted" style="margin:.6rem 0 0">
            If you're signed in, reload the page. If not, <a href="wallet">sign in with your wallet</a>.
        </p>
    </div>
}
else if (_mine.Count == 0)
{
    @* ?mine=1: the roster opens on the ALL tab and the recruit card only renders under Mine. *@
    <div class="card muted">You need a hero first — recruit one on the <a href="heroes?mine=1">Heroes</a> page.</div>
}
else
{
    <div class="card">
        <p class="muted" style="margin-top:0">
            Send a hero through @ArkadeHeroes.Core.Progression.Gauntlet.WaveCount escalating ghost waves. A full clear wins a piece of gear,
            and every wave banks XP — <b>capped at level @ArkadeHeroes.Core.Progression.Gauntlet.PveXpLevelCap</b>, so the gauntlet trains up a newcomer but can't be farmed.
            An entry fee applies, scaled to the hero's level (nothing to lose but the fee — the ghosts don't stake back).
        </p>
        <label>Champion
            <select @bind="_heroId">
                <option value="">— pick a hero —</option>
                @foreach (var h in _mine)
                {
                    <option value="@h.Id">@HeroLabels.Option(h, _mine)</option>
                }
            </select>
        </label>

        @* "A small entry fee applies" was the entire disclosure on the one action here that spends real
           bitcoin, and the fee scales with level. Now the number is on the button. *@
        @* Fully qualified: this page's own generated class is also called Gauntlet, so a bare reference
           resolves to the page rather than to Core's rules. *@
        @if (Picked is { } hero && hero.Level >= ArkadeHeroes.Core.Progression.Gauntlet.PveXpLevelCap)
        {
            @* Said BEFORE the spend, not after. The page already prints "this hero has outgrown the
               gauntlet" — but only once the fee has been paid and the run is over. *@
            <div class="status-line" style="margin-top:.9rem">
                <span class="dot bad"></span>
                @* The drop needs a FULL clear (dungeons.json dropRequiresFullClear). Measured full-clear
                   rate AT THIS LEVEL: recruit 0.0%, bred 2.9%, bred+best-gear 20.9% — so for the hero this
                   is shown to, the levels are already spent and only gear and breeding are left. *@
                <span>
                    <b>@hero.Name</b> has reached level @ArkadeHeroes.Core.Progression.Gauntlet.PveXpLevelCap,
                    so this run banks <b>no XP</b> — only the gear drop is left, and that needs a
                    <b>full clear</b>. At this level, gear and breeding are what decide one.
                </span>
            </div>
        }
        @* The most-hit refusal of a new player's first session, and until now the only way to learn it
           was to press Run and take the 400 — the server enforced the rest but never sent it. *@
        @if (Resting is { } until)
        {
            <div class="status-line" style="margin-top:.9rem">
                <span class="dot"></span>
                <span><b>@Picked?.Name</b> is resting after its last run — ready @until.ToLocalTime().ToString("HH:mm:ss").</span>
            </div>
        }
        <button class="btn primary" style="margin-top:1.1rem" @onclick="DoRun"
                disabled="@(_running || string.IsNullOrEmpty(_heroId) || !CanAfford || Resting is not null)">
            @if (_running)
            {
                <text>Running…</text>
            }
            else if (Fee is { } f)
            {
                <text>Enter the gauntlet — @f.ToString("N0") sats</text>
            }
            else
            {
                <text>Enter the gauntlet</text>
            }
        </button>
        @if (!CanAfford && Fee is { } need)
        {
            <div class="status-line" style="margin-top:.7rem">
                <span class="dot bad"></span>
                You have @State.BalanceSats.ToString("N0") sats; entry costs @need.ToString("N0").
                <a href="wallet">Top up your wallet →</a>
            </div>
        }
        @if (_status is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div>
        }
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div>
        }
    </div>

    @* The verdict waits for the descent. This heading used to sit above the wave-by-wave replay saying
       "Run over · 3 / 5 waves", which answered the whole cinematic before its first bell rang. *@
    @if (_outcome is not null && _replaying && _waveIndex < _outcome.Run.Waves.Count)
    {
        var w = _outcome.Run.Waves[_waveIndex];
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Descending…</h3>
            <span class="hud">@ArkadeHeroes.Core.Progression.Gauntlet.WaveCount escalating ghost waves</span>
        </div>
        <CrawlTrack Rungs="_rungs" Focus="_waveIndex" Revealed="_revealed" Total="@ArkadeHeroes.Core.Progression.Gauntlet.WaveCount"
                    Label="five waves down" OnSkip="SkipReplay" />
        <div class="crawl-stage">
            <BattleArena A="_outcome.Run.HeroSnapshot" B="w.Ghost" Fight="w.Result" OnFinished="NextWave" />
            @if (_descending)
            {
                <div class="crawl-veil">
                    <b>DESCENDING</b>
                    <span>wave @_descendTo · deeper</span>
                </div>
            }
        </div>
    }
    else if (_outcome is not null)
    {
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">@(_outcome.Run.WavesCleared == ArkadeHeroes.Core.Progression.Gauntlet.WaveCount ? "Gauntlet cleared!" : "Run over")</h3>
            <span class="hud">@_outcome.Run.WavesCleared / @ArkadeHeroes.Core.Progression.Gauntlet.WaveCount waves</span>
        </div>

        <div class="grid cols">
            @foreach (var wv in _outcome.Run.Waves)
            {
                <div class="card" style="text-align:center">
                    <div class="chip mono">Wave @wv.Wave</div>
                    <div style="margin:.45rem 0 .3rem">ghost L@(wv.GhostLevel)</div>
                    <div class="status-line" style="justify-content:center">
                        <span class="dot @(wv.Won ? "ok" : "bad")"></span> @(wv.Won ? "cleared" : "defeated")
                    </div>
                </div>
            }
        </div>

        <div class="card" style="margin-top:1.2rem">
            <div class="status-line">
                <span class="dot ok"></span>
                <span><b>@_outcome.Run.WavesCleared / @ArkadeHeroes.Core.Progression.Gauntlet.WaveCount</b> cleared · <b>+@_outcome.Run.XpAwarded</b> xp · now level <b>@_outcome.Run.NewLevel</b></span>
            </div>
            @if (_outcome.Run.XpAwarded == 0 && _outcome.Run.WavesCleared > 0)
            {
                <p class="muted" style="margin:.4rem 0 0;font-size:.82rem">This hero has outgrown the gauntlet — no XP is awarded past level @ArkadeHeroes.Core.Progression.Gauntlet.PveXpLevelCap.</p>
            }
            @if (_outcome.Run.ItemAwarded is not null)
            {
                <div class="gear-tile" style="margin:.9rem auto 0;max-width:140px"><ItemSprite ItemId="@_outcome.Run.ItemAwarded" Size="104" /></div>
                <div class="status-line" style="justify-content:center;margin-top:.4rem">
                    <span class="dot ok"></span> Full clear! Won <b>@_outcome.Run.ItemAwarded</b> — equip it from a hero's page.
                </div>
            }
            <div class="status-line" style="margin-top:.7rem">
                <span class="dot @(_outcome.FairnessOk ? "ok" : "bad")"></span>
                <span class="mono" style="font-size:.78rem">
                    @(_outcome.FairnessOk ? $"fairness ✓ {_outcome.FairnessDetail}" : $"fairness ✗ server cheated: {_outcome.FairnessDetail}")
                </span>
            </div>
        </div>
    }
}

@code {
    private List<HeroDto> _mine = new();
    private string _heroId = "";
    private bool _loading = true;
    private bool _running;
    private bool _heroesLoaded;
    private string? _status;
    private string? _error;

    /// <summary>The server's published fee knobs, so the button can state what entry costs BEFORE the
    /// player commits. Entry is deliberately priced above the best item a run can drop, which makes
    /// "a small entry fee applies" — the page's only previous disclosure — the wrong thing to say.</summary>
    private GameConfigDto? _config;

    private HeroDto? Picked => _mine.FirstOrDefault(h => h.Id == _heroId);
    private long? Fee => Picked is { } h ? Pricing.GauntletFee(_config, h.Level) : null;

    /// <summary>An unknown price counts as affordable — better to let the server refuse than to grey out a
    /// button over a number we failed to read. Same rule the recruit button on /heroes uses.</summary>
    private bool CanAfford => Fee is not { } fee || State.BalanceSats >= fee;

    /// <summary>When the picked hero is still on gauntlet cooldown, else null. A cooldown that has
    /// already lapsed reads as ready, so a stale roster fetch cannot lock the button shut.</summary>
    private DateTimeOffset? Resting =>
        Picked?.GauntletCooldownUntil is { } until && until > DateTimeOffset.UtcNow ? until : null;

    private GauntletOutcome? _outcome;
    private int _waveIndex;      // the wave currently animating in the arena
    private bool _replaying;     // true while the run replays wave-by-wave, before the summary reveals
    private int _revealed;       // rungs of the rail whose outcome has been stamped
    private bool _descending;    // the beat between two waves, while the veil carries the player down
    private int _descendTo;      // the wave number the veil is carrying them to
    private int _replayId;       // guards a stale descent beat from stepping a newer run's replay
    private List<CrawlTrack.CrawlRung> _rungs = new();

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            _heroesLoaded = true;
        }
        catch
        {
            // A swallowed read used to leave the page permanently empty: OnState only re-runs on the NEXT
            // state change, and a server hiccup produces none — so a one-off failure looked exactly like
            // owning no heroes, forever. Retry on our own rather than waiting for an event that may never
            // come. Short backoff; the sign-in path still covers the not-yet-authenticated case.
            await RetryLoadAsync();
        }
        finally { _loading = false; }

        try { _config ??= (await Api.Chain.InfoAsync()).Config; }
        catch { /* price unknown — the button drops the number rather than quoting a zero */ }
    }

    async Task DoRun()
    {
        _running = true;
        _error = null;
        _outcome = null;
        _status = "Preparing the gauntlet…";
        try
        {
            _outcome = await Session.RunGauntletAsync(_heroId, s => { _status = s; StateHasChanged(); });
            _status = null;
            _replayId++;
            _waveIndex = 0;
            _revealed = 0;
            _descending = false;
            _rungs = _outcome.Run.Waves
                .Select(w => new CrawlTrack.CrawlRung(w.Wave, w.GhostLevel, w.Won)).ToList();
            _replaying = _outcome.Run.Waves.Count > 0;   // cinematic wave-by-wave replay before the summary
            await LoadAsync();   // the hero may have leveled up — refresh the roster
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        finally
        {
            _running = false;
        }
    }

    // The arena fires this when a wave's replay finishes: stamp the wave on the rail, then take the beat
    // that carries the player down to the next one — or, after the last, reveal the summary + rewards.
    // The wait is what sells the descent, so it is the first thing a reduced-motion player loses.
    async Task NextWave()
    {
        if (_outcome is null || !_replaying) return;
        var run = _replayId;
        _revealed = _waveIndex + 1;
        StateHasChanged();

        var still = !await Motion.PrefersReducedAsync(JS);
        if (run != _replayId) return;

        if (_waveIndex + 1 >= _outcome.Run.Waves.Count)
        {
            if (still) await Task.Delay(760);   // let the last mark land before the summary takes the page
            if (run != _replayId) return;
            _replaying = false;
            StateHasChanged();
            return;
        }

        if (!still)
        {
            _waveIndex++;
            StateHasChanged();
            return;
        }

        _descendTo = _outcome.Run.Waves[_waveIndex + 1].Wave;
        _descending = true;
        StateHasChanged();
        await Task.Delay(620);                  // the veil is across; swap the fight behind it
        if (run != _replayId) return;
        _waveIndex++;
        StateHasChanged();
        await Task.Delay(480);                  // ...and it wipes clear on the next wave's opening bell
        if (run != _replayId) return;
        _descending = false;
        StateHasChanged();
    }

    void SkipReplay()
    {
        _replayId++;                            // strand any descent beat still in flight
        _revealed = _outcome?.Run.Waves.Count ?? 0;
        _descending = false;
        _replaying = false;
        StateHasChanged();
    }

    void OnState() => InvokeAsync(async () =>
    {
        // On a fresh page load the session resumes after this component inits; reload the
        // roster once we're signed in (the first MineAsync may have raced the login token).
        if (State.IsSignedIn && !_heroesLoaded && !_loading)
            await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        State.OnChange -= OnState;
        _replayId++;   // strand any descent beat still in flight when the page goes away
    }

    /// <summary>
    /// Re-attempts the roster read a few times, backing off. Deliberately bounded: past a few seconds the
    /// honest answer is the "couldn't read your roster" card, not a page that spins forever.
    /// </summary>
    async Task RetryLoadAsync()
    {
        foreach (var delay in new[] { 400, 1200, 3000 })
        {
            await Task.Delay(delay);
            if (_heroesLoaded || !State.IsSignedIn) return;
            try
            {
                _mine = await Api.Heroes.MineAsync();
                _heroesLoaded = true;
                StateHasChanged();
                return;
            }
            catch { /* keep backing off; the card below stays honest if we never succeed */ }
        }
    }

}
