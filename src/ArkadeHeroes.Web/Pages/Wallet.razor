@page "/wallet"
@inject GameWallet WalletSvc
@inject WalletState State
@inject GameSession Session
@inject ArkadeHeroesClient Api
@inject IJSRuntime JS
@inject FaucetService Faucet
@inject WalletCredentialStore Credentials
@implements IDisposable

<PageTitle>Wallet · Arkade Heroes</PageTitle>

<section class="wallet-head">
    <div class="hud">Non-custodial · keys stay in this browser</div>
    <h1>Your <span class="neon">wallet</span></h1>
</section>

@if (_view == View.Loading)
{
    <div class="card">
        <div class="status-line"><span class="dot wait"></span> Opening your wallet…</div>
    </div>
}
else if (_view == View.NoWallet)
{
    <div class="wallet-grid">
        <div class="card">
            <h3>Create a new wallet</h3>
            <p class="muted">
                Generates a fresh 12-word recovery phrase in this browser. It is the ONLY
                key to your heroes and funds — we never see it. Write it down before you fund it.
            </p>
            <button class="btn primary" @onclick="CreateAsync" disabled="@_busy">
                @(_busy ? "Creating…" : "Create new wallet")
            </button>
        </div>

        <div class="card">
            <h3>Import a recovery phrase</h3>
            <p class="muted">Restore an existing wallet from its 12 or 24 words.</p>
            <textarea class="wallet-input" rows="3" placeholder="word one word two word three…"
                      @bind="_importText" @bind:event="oninput" disabled="@_busy"></textarea>
            <button class="btn ghost" @onclick="ImportAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_importText))">
                @(_busy ? "Importing…" : "Import wallet")
            </button>

            @* The other half of "your wallet is your account": if the phrase was saved to this browser,
               coming back on a new device is picking it out of the password manager. *@
            @if (_credentialsSupported)
            {
                <p class="muted" style="margin:1rem 0 .6rem">Or, if you saved it to your browser before:</p>
                <button class="btn ghost" @onclick="RestoreFromBrowserAsync" disabled="@_credentialBusy">
                    @(_credentialBusy ? "Looking…" : "Restore from this browser")
                </button>
                @if (_credentialNote is not null)
                {
                    <div class="status-line" style="margin-top:.6rem">
                        <span class="dot @(_credentialOk ? "ok" : "bad")"></span> @_credentialNote
                    </div>
                }
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="card err"><span class="dot bad"></span> @_error</div>
    }
}
else if (_view == View.ShowMnemonic)
{
    <div class="card glow">
        <div class="status-line"><span class="dot ok"></span> Wallet created — back up your recovery phrase</div>
        <p class="muted" style="margin:.6rem 0 1rem">
            These 12 words restore your wallet on any device. Anyone with them controls your heroes.
            Store them offline — this is the only time they're shown by default.
        </p>
        <div class="seed-grid">
            @for (var i = 0; i < _freshWords.Length; i++)
            {
                <div class="seed-word"><span class="idx">@(i + 1)</span> @_freshWords[i]</div>
            }
        </div>
        <div class="btn-row" style="margin-top:1.2rem">
            <button class="btn ghost" @onclick="CopyMnemonic">@(_copied ? "Copied ✓" : "Copy phrase")</button>
            <button class="btn primary" @onclick="ConfirmBackup">I've saved it — continue</button>
        </div>
    </div>
}
else // Ready
{
    <div class="wallet-grid">
        <div class="card">
            <h3>Receive address</h3>
            <p class="muted">Send heroes and funds here.</p>
            <div class="addr-box">
                <span class="mono addr">@(_address ?? "…")</span>
                <button class="btn ghost sm" @onclick="CopyAddress" disabled="@(_address is null)">
                    @(_copied ? "Copied ✓" : "Copy")
                </button>
            </div>
        </div>

        <div class="card balance-card">
            <h3>Balance</h3>
            <div class="balance"><b>@State.BalanceSats.ToString("N0")</b> <span>sats</span></div>
            @if (_assets.Count > 0)
            {
                <button class="asset-line" @onclick="() => _showAssets = true">
                    …and @_assets.Count asset@(_assets.Count == 1 ? "" : "s") →
                </button>
            }
            <div class="chips" style="margin-top:.8rem">
                <span class="chip">@_vtxoCount VTXO@(_vtxoCount == 1 ? "" : "s")</span>
                <button class="chip as-btn" @onclick="RefreshAsync" disabled="@_busy">
                    @(_busy ? "…" : "↻ refresh")
                </button>
            </div>
            @* Test coins, on the networks that have a faucet. Never on mainnet — see FaucetPolicy. *@
            @if (Faucet.Available)
            {
                <button class="btn ghost" style="margin-top:.8rem;width:100%"
                        @onclick="RequestFaucetAsync" disabled="@_faucetBusy">
                    @(_faucetBusy ? "Asking the faucet…" : "Get test sats")
                </button>
                @if (_faucetNote is not null)
                {
                    <div class="status-line" style="margin-top:.6rem">
                        <span class="dot @(_faucetOk ? "ok" : "bad")"></span> @_faucetNote
                    </div>
                }
            }
        </div>
    </div>

@* Nothing to send is not a state worth rendering a form for — it can only fail. The faucet button and
   the receive address are the useful things at zero, and both are above. *@
@if (State.BalanceSats > 0)
{
    <div class="card" style="margin-bottom:1.1rem">
        <h3>Send</h3>
        <p class="muted">Move sats to another Arkade address — the spend is built and signed in this browser.</p>
        <div class="send-form">
            <input class="wallet-input" @bind="_sendTo" @bind:event="oninput" placeholder="tark1… destination address" disabled="@_sending" />
            <div class="send-row">
                <input class="wallet-input amt" type="number" min="1" @bind="_sendAmount" @bind:event="oninput" placeholder="sats" disabled="@_sending" />
                <button class="btn primary" @onclick="Send" disabled="@(_sending || string.IsNullOrWhiteSpace(_sendTo) || _sendAmount <= 0)">
                    @(_sending ? "Sending…" : "Send")
                </button>
            </div>
        </div>
        @if (_sendResult is not null)
        {
            <div class="status-line" style="margin-top:.7rem"><span class="dot ok"></span> Sent — tx <span class="mono">@Short(_sendResult)</span></div>
        }
        @if (_sendError is not null)
        {
            <div class="status-line" style="margin-top:.7rem"><span class="dot bad"></span> @_sendError</div>
        }
    </div>
}

    <div class="card" style="margin-bottom:1.1rem">
        <h3>Game identity</h3>
        @if (State.IsSignedIn)
        {
            <div class="status-line"><span class="dot ok"></span> Signed in as <b>@State.Player!.Name</b></div>
            @* Recruits are buyable as often as you can pay for them, so this is never "one-time" and never
               goes away — the price is stated up front because it is real money leaving the wallet. *@
            <p class="muted" style="margin:.6rem 0 .2rem">
                @if (State.Player.StarterClaimed)
                {
                    <text>Recruit @StarterPolicy.HeroCount more heroes — the cheapest way to get one, and it shows: they roll no traits and weak stats.</text>
                }
                else
                {
                    <text>Recruit @StarterPolicy.HeroCount heroes to enter the arena. They're the bottom of the barrel — no traits, weak stats — but they're yours, and they can breed.</text>
                }
            </p>
            <button class="btn primary" style="margin-top:.6rem" @onclick="ClaimStarters" disabled="@(_busy || !CanAffordClaim)">
                @if (_busy)
                {
                    <text>@(_claimStep ?? "Recruiting…")</text>
                }
                else if (_claimFeeSats is null)
                {
                    <text>Recruit @StarterPolicy.HeroCount heroes</text>
                }
                else
                {
                    <text>Recruit @StarterPolicy.HeroCount heroes — @_claimFeeSats.Value.ToString("N0") sats</text>
                }
            </button>
            @if (!CanAffordClaim && _claimFeeSats is not null)
            {
                <div class="status-line" style="margin-top:.6rem">
                    <span class="dot bad"></span>
                    You have @State.BalanceSats.ToString("N0") sats; recruiting costs @_claimFeeSats.Value.ToString("N0").
                    @if (Faucet.Available)
                    {
                        <text> Use "Get test sats" above.</text>
                    }
                </div>
            }
            @if (_myHeroCount > 0)
            {
                <p class="muted" style="margin:.6rem 0 0">
                    @_myHeroCount hero@(_myHeroCount == 1 ? "" : "es") in your roster.
                    <a href="heroes">View your heroes →</a>
                </p>
            }
            @if (_claimMsg is not null)
            {
                <div class="status-line" style="margin-top:.7rem"><span class="dot ok"></span> @_claimMsg</div>
            }
        }
        else
        {
            <p class="muted">Sign in with your wallet — no email, no password. Pick a name to register your address and login key.</p>
            <div class="addr-box" style="margin-top:.5rem">
                <input class="wallet-input" @bind="_name" @bind:event="oninput" placeholder="your arena name" disabled="@_busy" />
                <button class="btn primary sm" @onclick="Register" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">
                    @(_busy ? "…" : "Enter the arena")
                </button>
            </div>
        }
        @if (_idError is not null)
        {
            <div class="status-line" style="margin-top:.7rem"><span class="dot bad"></span> @_idError</div>
        }
    </div>

    <div class="card">
        <h3>Recovery phrase</h3>
        @if (!_revealed)
        {
            <p class="muted">Your 12 words — the only way to recover this wallet. Keep them offline.</p>
            <button class="btn ghost" @onclick="RevealAsync">Reveal recovery phrase</button>
        }
        else
        {
            <div class="seed-grid">
                @for (var i = 0; i < _freshWords.Length; i++)
                {
                    <div class="seed-word"><span class="idx">@(i + 1)</span> @_freshWords[i]</div>
                }
            </div>
            <button class="btn ghost" style="margin-top:1rem" @onclick="() => _revealed = false">Hide</button>
        }

        @* Your wallet IS your account, so the phrase is the thing worth making portable. This hands it to
           the browser's password manager — which is also the honest risk, stated rather than glossed. *@
        @if (_credentialsSupported)
        {
            <div style="margin-top:1.2rem;border-top:1px solid var(--line);padding-top:1rem">
                <p class="muted" style="margin:0 0 .7rem">
                    Save it to this browser and it goes wherever your browser passwords go — including
                    your other devices, if you sync them. That convenience is also the risk: anyone who
                    reaches that account reaches this wallet. It doesn't replace writing the words down.
                </p>
                <button class="btn ghost" @onclick="SaveToBrowserAsync" disabled="@_credentialBusy">
                    @(_credentialBusy ? "Saving…" : "Save phrase to this browser")
                </button>
                @if (_credentialNote is not null)
                {
                    <div class="status-line" style="margin-top:.6rem">
                        <span class="dot @(_credentialOk ? "ok" : "bad")"></span> @_credentialNote
                    </div>
                }
            </div>
        }
    </div>

    @if (_showAssets)
    {
        <div class="modal-backdrop" @onclick="() => _showAssets = false">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <h3>Your assets</h3>
                    <button class="modal-x" @onclick="() => _showAssets = false" aria-label="Close">✕</button>
                </div>
                <p class="muted" style="margin:0 0 .9rem">
                    On-chain assets carried by your VTXOs — each is covenant-enforced, not held by the server.
                </p>
                <div class="asset-list">
                    @foreach (var a in _assets)
                    {
                        <div class="asset-row">
                            <span class="asset-name">@AssetLabel(a.AssetId)</span>
                            <span class="mono asset-id">@ShortId(a.AssetId)</span>
                            <span class="asset-amt">×@a.Amount</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    enum View { Loading, NoWallet, ShowMnemonic, Ready }
    View _view = View.Loading;

    bool _busy;
    bool _copied;
    bool _revealed;
    string? _error;
    string _importText = "";

    string? _activeId;
    string? _address;
    string[] _freshWords = [];
    int _vtxoCount;

    // The wallet's distinct on-chain assets (heroes/XP/items) for the "…and X assets" breakdown modal.
    IReadOnlyList<(string AssetId, ulong Amount)> _assets = [];
    Dictionary<string, string> _assetNames = new();  // assetId → hero name, when we can resolve it
    bool _showAssets;

    string _name = "";
    string? _idError;
    string? _claimMsg;
    int _myHeroCount;

    string _sendTo = "";
    long _sendAmount;
    bool _sending;
    string? _sendResult;
    string? _sendError;
    bool _resumeTried;

    // ── Recruiting ───────────────────────────────────────────────────────────
    /// <summary>The server's own price for a claim, so the button can state it before the player commits.
    /// Read from published config rather than computed locally — a compiled-in guess would be wrong the
    /// moment an operator changes the breed fee. Null until it loads (or if the read fails).</summary>
    long? _claimFeeSats;
    string? _claimStep;

    /// <summary>Whether the wallet covers a claim. Unknown price (config read failed) counts as affordable —
    /// better to let the server refuse than to grey out a button over a missing number.</summary>
    bool CanAffordClaim => _claimFeeSats is not { } fee || State.BalanceSats >= fee;

    // ── Faucet ───────────────────────────────────────────────────────────────
    bool _faucetBusy;
    bool _faucetOk;
    string? _faucetNote;

    // ── Browser credential manager ───────────────────────────────────────────
    bool _credentialsSupported;
    bool _credentialBusy;
    bool _credentialOk;
    string? _credentialNote;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        // Asked once, up front: the buttons only exist where the browser can actually honour them
        // (Chromium, over https). Everywhere else the phrase is still shown for manual backup.
        _credentialsSupported = await Credentials.IsSupportedAsync();
        // A plain read — no invoice is created here, so opening the page never bills anything.
        try { _claimFeeSats = (await Api.Chain.InfoAsync()).Config?.StarterClaimFeeSats; }
        catch { /* price unknown — the button still works, it just can't quote up front */ }
        await LoadAsync();
    }

    async Task RequestFaucetAsync()
    {
        _faucetBusy = true;
        _faucetNote = null;
        try
        {
            var sats = await Faucet.RequestAsync();
            _faucetOk = true;
            _faucetNote = $"Asked for {sats:N0} sats — they'll appear once the network confirms them.";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            // Surface the faucet's own words: "try again" is useless when the real answer is a rate limit.
            _faucetOk = false;
            _faucetNote = ex.Message;
        }
        finally
        {
            _faucetBusy = false;
        }
    }

    async Task SaveToBrowserAsync()
    {
        _credentialBusy = true;
        _credentialNote = null;
        try
        {
            // Every exit from here says something. The first version could return in silence (no active
            // wallet) or throw past its own try/finally (GetMnemonicAsync), and a button that does nothing
            // visible is indistinguishable from a broken one — which is exactly how it was reported.
            if (_activeId is null)
            {
                _credentialOk = false;
                _credentialNote = "No wallet is loaded in this tab.";
                return;
            }
            _credentialOk = await Credentials.SaveAsync(_activeId);
            _credentialNote = _credentialOk
                ? "Saved. Your browser can now restore this wallet — treat it like any other saved password."
                : "Your browser declined to save it (some block this, and it needs https). Write the words down instead.";
        }
        catch (Exception ex)
        {
            _credentialOk = false;
            _credentialNote = $"Couldn't save it: {ex.Message}";
        }
        finally
        {
            _credentialBusy = false;
        }
    }

    async Task RestoreFromBrowserAsync()
    {
        _credentialBusy = true;
        _credentialNote = null;
        try
        {
            if (await Credentials.LoadPhraseAsync() is not { } phrase)
            {
                _credentialOk = false;
                _credentialNote = "Nothing saved for this site, or you dismissed the picker.";
                return;
            }
            // Import through the normal path so the restored wallet is indistinguishable from a typed one.
            var restored = await WalletSvc.ImportAsync(phrase);
            State.SetActiveWallet(restored.Id, await WalletSvc.GetReceiveAddressAsync(restored.Id));
            _credentialOk = true;
            _credentialNote = "Wallet restored from your browser.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _credentialOk = false;
            _credentialNote = ex.Message;
        }
        finally
        {
            _credentialBusy = false;
        }
    }

    async Task LoadAsync()
    {
        var wallet = await WalletSvc.GetActiveWalletAsync();
        if (wallet is null)
        {
            _view = View.NoWallet;
            return;
        }
        _activeId = wallet.Id;
        _view = View.Ready;
        await RefreshAsync();
    }

    async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var (wallet, mnemonic) = await WalletSvc.CreateAsync();
            _activeId = wallet.Id;
            _freshWords = mnemonic.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            _view = View.ShowMnemonic;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    async Task ImportAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var wallet = await WalletSvc.ImportAsync(_importText);
            _activeId = wallet.Id;
            _importText = "";
            _view = View.Ready;
            await RefreshAsync();
        }
        catch (GameWalletException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    async Task ConfirmBackup()
    {
        _freshWords = [];
        _view = View.Ready;
        await RefreshAsync();
    }

    async Task RefreshAsync()
    {
        if (_activeId is null) return;
        _busy = true;
        try
        {
            _address ??= await WalletSvc.GetReceiveAddressAsync(_activeId);
            var balance = await WalletSvc.GetBalanceAsync(_activeId);
            var vtxos = await WalletSvc.GetVtxosAsync(_activeId);
            _vtxoCount = vtxos.Count;
            _assets = await WalletSvc.GetAssetsAsync(_activeId);
            State.SetActiveWallet(_activeId, _address);
            State.UpdateBalance(balance);
            // Silently resume the game session ONCE (login if this wallet is registered),
            // then surface the player's roster size. Guarded so repeated balance refreshes
            // don't re-attempt (and re-log) a login for an unregistered wallet.
            if (!_resumeTried)
            {
                _resumeTried = true;
                await Session.ResumeAsync();
            }
            await RefreshMineAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    async Task Register()
    {
        _busy = true;
        _idError = null;
        try
        {
            await Session.RegisterAsync(_name);
            await RefreshMineAsync();
        }
        catch (Exception ex)
        {
            _idError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    async Task ClaimStarters()
    {
        _busy = true;
        _idError = null;
        _claimMsg = null;
        try
        {
            // Paying takes a moment and costs real sats, so say which step is running rather than
            // leaving a dead button while a spend is in flight.
            var heroes = await Session.ClaimStartersAsync(step =>
            {
                _claimStep = step;
                StateHasChanged();
            });
            await RefreshMineAsync();
            await RefreshAsync();   // the fee left the wallet; the balance on screen should show it
            _claimMsg = $"Recruited {heroes.Count} hero{(heroes.Count == 1 ? "" : "es")} — recruit more any time.";
        }
        catch (Exception ex)
        {
            _idError = ex.Message;
        }
        finally
        {
            _busy = false;
            _claimStep = null;
        }
    }

    async Task RefreshMineAsync()
    {
        if (!State.IsSignedIn) return;
        try
        {
            var mine = await Api.Heroes.MineAsync();
            _myHeroCount = mine.Count;
            // Best-effort assetId → hero name, so the breakdown reads "Blaze" not a raw id.
            _assetNames = mine.Where(h => !string.IsNullOrEmpty(h.AssetId))
                              .ToDictionary(h => h.AssetId!, h => h.Name);
        }
        catch { /* roster count + asset names are best-effort */ }
    }

    // A held asset's friendly label: the hero's name when we can resolve it, else a generic tag.
    string AssetLabel(string assetId) => _assetNames.TryGetValue(assetId, out var name) ? name : "Asset";

    static string ShortId(string id) => id.Length <= 14 ? id : $"{id[..6]}…{id[^6..]}";

    async Task Send()
    {
        if (_activeId is null) return;
        _sending = true;
        _sendError = null;
        _sendResult = null;
        try
        {
            _sendResult = await WalletSvc.SendSatsAsync(_activeId, _sendTo, _sendAmount);
            _sendTo = "";
            _sendAmount = 0;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _sendError = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    static string Short(string s) => s.Length <= 14 ? s : $"{s[..8]}…{s[^4..]}";

    async Task RevealAsync()
    {
        if (_activeId is null) return;
        var mnemonic = await WalletSvc.GetMnemonicAsync(_activeId);
        if (mnemonic is not null)
        {
            _freshWords = mnemonic.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            _revealed = true;
            State.SetBackupPending(false); // they've seen their phrase — clear the shell nudge
        }
    }

    async Task CopyMnemonic() => await Copy(string.Join(' ', _freshWords));
    async Task CopyAddress() => await Copy(_address ?? "");

    async Task Copy(string text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); } catch { }
        _copied = true;
        StateHasChanged();
        await Task.Delay(1400);
        _copied = false;
        StateHasChanged();
    }

    void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= OnStateChanged;
}
