@page "/merge"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@implements IDisposable

<PageTitle>Merge · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Merge</h2>
    <span class="hud">covenant-enforced · burn two, forge one</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then fuse your heroes.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading your heroes…</div>
}
@* "You have fewer than two heroes" and "we never managed to read your roster" are different facts, and
   this branch used to state the first while meaning either. _heroesLoaded was already declared and set;
   it was simply never read. *@
else if (!_heroesLoaded)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your roster.</div>
        <p class="muted" style="margin:.6rem 0 0">
            This is not the same as owning too few heroes — we simply couldn't look. @_loadError
        </p>
        <button class="btn primary sm" style="margin-top:.7rem" @onclick="Retry" disabled="@_loading">Try again</button>
    </div>
}
else if (_mine.Count < 2)
{
    @* Both actions named here now LINK somewhere. This card used to name two things to go and do and
       point at neither, which leaves a stuck player exactly as stuck. *@
    <div class="card muted">
        You need at least two heroes to fuse — <a href="heroes?mine=1">recruit one</a> or
        <a href="breed">breed more</a> first.
    </div>
}
else
{
    <div class="card">
        <p class="muted" style="margin-top:0">
            Fuse a base with a sacrifice: your wallet deposits both heroes <b>and the fusion fee</b> into a
            covenant escrow; the arena burns them and mints ONE trait-concentrated hero back to you. The
            fee is a real spend on top of the hero you give up. The fused genome is a gamble —
            pushing toward the top tiers can breed in sterility. The base keeps its level and identity.
        </p>
        <div class="breed-picks">
            <label>Base <span class="mini">keeps level + name</span>
                <select @bind="_baseId">
                    <option value="">— pick —</option>
                    @foreach (var h in _mine)
                    {
                        <option value="@h.Id">@HeroLabels.Option(h, _mine)</option>
                    }
                </select>
            </label>
            <span class="breed-plus">✦</span>
            <label>Sacrifice <span class="mini">burned</span>
                <select @bind="_sacrificeId">
                    <option value="">— pick —</option>
                    @foreach (var h in _mine)
                    {
                        <option value="@h.Id">@HeroLabels.Option(h, _mine)</option>
                    }
                </select>
            </label>
        </div>
        @* The price, stated before the burn. Nothing on this page named a number: the fee was first seen
           inside the commit response, by which point both heroes were already escrowed. *@
        @if (Fee is { } fee)
        {
            <p class="muted" style="margin:.8rem 0 0;font-size:.85rem">
                Fusing costs <b>@fee.ToString("N0") sats</b>, deposited into the escrow with both heroes.
                @if (Sacrifice is { } s)
                {
                    <text><b>@HeroLabels.Name(s, _mine)</b> is destroyed permanently — there is no undo.</text>
                }
            </p>
        }
        <button class="btn primary" style="margin-top:1.1rem" @onclick="DoMerge"
                disabled="@(_merging || string.IsNullOrEmpty(_baseId) || string.IsNullOrEmpty(_sacrificeId) || _baseId == _sacrificeId)">
            @(_merging ? "Fusing…" : "Fuse")
        </button>
        @if (_status is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div>
        }
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div>
        }
        @if (_pendingMergeId is not null && !_merging)
        {
            <button class="btn" style="margin-top:.7rem" @onclick="RetryReveal">Retry reveal</button>
        }
    </div>

    @if (_fused is not null)
    {
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Your fused hero</h3>
            <span class="hud">two burned, one forged — into your wallet</span>
        </div>
        <div class="grid cols"><HeroCard Hero="_fused" Reveal="true" Fuse="true" /></div>
    }
}

@code {
    private List<HeroDto> _mine = new();
    private string _baseId = "";
    private string _sacrificeId = "";
    private bool _loading = true;
    private bool _merging;
    private bool _heroesLoaded;
    private string? _status;
    private string? _error;
    private string? _loadError;
    private HeroDto? _fused;
    private string? _pendingMergeId;   // set when a reveal times out — enables "Retry reveal"

    /// <summary>The server's published fee, so the page can price an IRREVERSIBLE burn before the player
    /// commits to it. It used to be learned only from the commit response — i.e. after the covenant was
    /// already sealed around both heroes.</summary>
    private GameConfigDto? _config;
    private long? Fee => Pricing.MergeFee(_config);

    /// <summary>The hero about to be burned, named at the point of commitment rather than left as a
    /// dropdown selection the player has to re-read.</summary>
    private HeroDto? Sacrifice => _mine.FirstOrDefault(h => h.Id == _sacrificeId);

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            _heroesLoaded = true;
            _loadError = null;
        }
        catch (Exception ex)
        {
            // RECORDED, not swallowed. OnState only re-runs on the NEXT wallet event, and a server hiccup
            // produces none — so a one-off failure looked exactly like owning one hero, forever.
            _loadError = ex.Message;
        }
        finally { _loading = false; }

        try { _config ??= (await Api.Chain.InfoAsync()).Config; }
        catch { /* price unknown — the page says so rather than quoting a zero */ }
    }

    /// <summary>Manual retry, because the automatic one depends on an event that may never fire.</summary>
    async Task Retry()
    {
        _error = null;
        await LoadAsync();
    }

    async Task DoMerge()
    {
        _merging = true;
        _error = null;
        _fused = null;
        _pendingMergeId = null;
        _status = "Preparing the covenant…";
        try
        {
            _fused = await Session.MergeAsync(_baseId, _sacrificeId,
                s => { _status = s; StateHasChanged(); });
            _status = null;
            _baseId = "";
            _sacrificeId = "";
            await LoadAsync();
        }
        catch (RevealPendingException ex)
        {
            // Inputs are escrowed but the reveal timed out — offer a reveal-only retry (re-running
            // the whole flow would try to re-deposit the burned base + sacrifice).
            _pendingMergeId = ex.PendingId;
            _error = ex.Message;
            _status = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        finally
        {
            _merging = false;
        }
    }

    async Task RetryReveal()
    {
        if (_pendingMergeId is null) return;
        _merging = true;
        _error = null;
        _status = "Retrying the reveal…";
        try
        {
            _fused = await Session.RevealMergedHeroAsync(_pendingMergeId,
                s => { _status = s; StateHasChanged(); });
            _status = null;
            _pendingMergeId = null;
            _baseId = "";
            _sacrificeId = "";
            await LoadAsync();
        }
        catch (RevealPendingException ex)
        {
            _error = ex.Message;   // still settling — keep the pending id so they can retry again
            _status = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        finally
        {
            _merging = false;
        }
    }

    void OnState() => InvokeAsync(async () =>
    {
        if (State.IsSignedIn && !_heroesLoaded && !_loading)
            await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;
}
