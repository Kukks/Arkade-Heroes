@page "/heroes/{Id}"
@using ArkadeHeroes.Core.Combat
@using ArkadeHeroes.Core.Genetics
@inject ArkadeHeroesClient Api
@inject WalletState State
@inject GameSession Session
@implements IDisposable

<PageTitle>@(_hero?.Name ?? _grave?.Name ?? "Hero")@(_grave is null ? "" : " (destroyed)") · Arkade Heroes</PageTitle>

<div class="page-head">
    <a href="heroes" class="hud back">← roster</a>
</div>

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading the hero…</div>
}
else if (_grave is { } g)
{
    @* A DESTROYED hero. Its row was erased at the burn site — death is permanent here and the on-chain
       asset is retired — so everything below is read off the headstone written the moment it died. This
       page exists at all because "Couldn't load this hero" was the only answer the arena had for a hero
       that lost a death-match, and that reads as a bug rather than as the game's central stake. *@
    <section class="detail-hero destroyed">
        <div class="detail-portrait">
            <HeroSprite Genome="@g.GenomeHex" Name="@g.Name" Size="210" />
            <span class="hero-gen mono">GEN·@g.Generation</span>
            <span class="hero-destroyed-mark mono" title="destroyed — this hero no longer exists">✖</span>
        </div>
        <div class="detail-headings">
            <div class="hud">destroyed · @DestroyedWhen(g)</div>
            <h1 class="destroyed-name">@g.Name</h1>
            <div class="chips">
                <span class="chip destroyed">✖ destroyed</span>
                <span class="chip">lvl <b>@g.Level</b></span>
                <span class="chip">gen <b>@g.Generation</b></span>
            </div>
            <p class="destroyed-note">@DestroyedBlurb(g)</p>
            @if (g.ReplacedByHeroId is { } into)
            {
                <a class="btn ghost" style="margin-top:.4rem" href="heroes/@into">→ What rose from it</a>
            }
            @if (g.Reason.StartsWith("deathmatch"))
            {
                <a class="btn ghost" style="margin-top:.4rem;margin-left:.4rem" href="watch/@g.SessionId">▶ Replay the match</a>
            }
        </div>
    </section>

    <div class="card">
        <h3>Lineage</h3>
        <div class="kv">
            <div><span>generation</span><b>@g.Generation</b></div>
            @if (g.ParentAId is not null)
            {
                <div><span>parent A</span><a href="heroes/@g.ParentAId" class="mono">@Short(g.ParentAId)</a></div>
            }
            @if (g.ParentBId is not null)
            {
                <div><span>parent B</span><a href="heroes/@g.ParentBId" class="mono">@Short(g.ParentBId)</a></div>
            }
            @if (g.ParentAId is null && g.ParentBId is null)
            {
                <div><span>origin</span><b>gen-0 starter</b></div>
            }
            <div><span>genome</span><code class="mono genome">@g.GenomeHex</code></div>
        </div>
    </div>
}
else if (_error || _hero is null)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't load this hero.</div>
        <p class="muted" style="margin:.7rem 0 0">It may not exist, or the arena is unreachable.</p>
    </div>
}
else
{
    var h = _hero;
    var tier = h.Rarity?.Tier ?? "Common";

    <section class="detail-hero">
        <div class="detail-portrait">
            <HeroSprite Hero="h" Size="210" />
            <span class="hero-gen mono">GEN·@h.Generation</span>
            @if (h.IsSterile)
            {
                <span class="hero-sterile mono" title="sterile — cannot breed">⌀</span>
            }
        </div>
        <div class="detail-headings">
            <div class="hud">@h.Element · @(h.IsSterile ? "sterile" : "fertile")</div>
            <h1>@h.Name</h1>
            <div class="chips">
                <span class="tier tag-@tier.ToLowerInvariant()">@tier</span>
                <span class="chip">lvl <b>@h.Level</b></span>
                <span class="chip">@h.Xp / @h.XpToNext xp</span>
                @if (h.Rarity is not null)
                {
                    <span class="chip">rarity <b>@h.Rarity.Score</b></span>
                }
                <span class="chip">bred <b>@h.BreedCount</b>×</span>
            </div>
            <div class="hpbar xpbar" title="@h.Xp / @h.XpToNext xp toward level @(h.Level + 1)">
                <i class="xp" style="width:@(XpPct(h))%"></i>
            </div>
            <a class="btn ghost" style="margin-top:1.1rem" href="@($"spar?a={h.Id}")">⚔ Spar this hero</a>
            @if (IsMine(h))
            {
                <div style="margin-top:1rem">
                    @if (!_renaming)
                    {
                        <button class="btn ghost" @onclick="StartRename" disabled="@_busy">
                            ✎ Rename@(_renameFeeSats > 0 ? $" · {_renameFeeSats} sat" : "")
                        </button>
                    }
                    else
                    {
                        <div class="sell-picks">
                            @* Bind per keystroke, not on blur: Claim below is disabled while the name is empty,
                               and @bind's default onchange only fires when the field LOSES focus — so a player
                               who types a name and goes straight for Claim hits a dead button, and only that
                               click's blur enables it. They have to click twice. *@
                            <input class="ask-input" placeholder="new name" maxlength="24" @bind="_newName" @bind:event="oninput" />
                            <button class="btn primary" @onclick="DoRename" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">@(_busy ? "…" : "Claim")</button>
                            <button class="btn ghost" @onclick="CancelRename" disabled="@_busy">Cancel</button>
                        </div>
                        @if (_renameStatus is not null)
                        {
                            <div class="status-line" style="margin-top:.5rem"><span class="dot wait"></span> @_renameStatus</div>
                        }
                        @if (_renameError is not null)
                        {
                            <div class="status-line" style="margin-top:.5rem"><span class="dot bad"></span> @_renameError</div>
                        }
                    }
                </div>
            }
        </div>
    </section>

    @* ── Bids ─────────────────────────────────────────────────────────────
       The marketplace only ever ran owner → market, so a hero nobody listed had no price and no door.
       This is that door. Nothing is billed by bidding: the invoice appears only if the owner accepts,
       so an ignored or refused bid costs the bidder nothing at all. *@
    @if (State.IsSignedIn && !IsMine(h))
    {
        <div class="card">
            <div class="page-head" style="margin-bottom:.8rem">
                <h3 style="margin:0">Make an offer</h3>
                <span class="hud">@h.Name isn't for sale — offer its owner sats for it anyway</span>
            </div>
            @if (MyBidOn(h) is { } mine)
            {
                <div class="chips" style="margin-bottom:.8rem">
                    <span class="chip">your bid <b>@mine.BidSats.ToString("N0")</b> sat</span>
                    <span class="chip @BidChipClass(mine.Status)">@BidStatusLabel(mine)</span>
                    @if (mine.Status == "accepted" && mine.FeeSats > 0)
                    {
                        <span class="chip">owner nets <b>@((mine.BidSats - mine.FeeSats).ToString("N0"))</b> sat</span>
                    }
                </div>
                <p class="muted" style="margin:0 0 .8rem">@BidBlurb(mine, h)</p>
                <div class="sell-picks">
                    @if (mine.Status == "proposed")
                    {
                        <button class="btn ghost" @onclick="() => DoWithdrawBid(mine.BidId)" disabled="@_bidBusy">Withdraw</button>
                    }
                    else if (mine.Status == "accepted")
                    {
                        <button class="btn primary" @onclick="() => DoFundBid(mine.BidId)" disabled="@_bidBusy">
                            @(_bidBusy ? "…" : $"Pay {mine.BidSats:N0} sat & claim")
                        </button>
                        <button class="btn ghost" @onclick="() => DoUnwindBid(mine.BidId)" disabled="@_bidBusy"
                                title="Only works once the delivery window has passed — your sats come straight back.">
                            Unwind & refund me
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="sell-picks">
                    @* Per-keystroke binding: the button below is disabled while the amount is empty, and
                       @bind's default onchange only fires on blur — so a player who types and goes straight
                       for the button hits a dead one. Same reasoning as the rename field above. *@
                    <input class="ask-input" type="number" min="1" placeholder="sats" @bind="_bidSats" @bind:event="oninput" />
                    <button class="btn primary" @onclick="() => DoPlaceBid(h.Id)" disabled="@(_bidBusy || _bidSats <= 0)">
                        @(_bidBusy ? "…" : "Offer to buy")
                    </button>
                </div>
                <p class="muted" style="margin:.7rem 0 0">
                    Nothing is charged now. If the owner accepts, you'll be invoiced then — and if they
                    never deliver, you can unwind the bid and take your sats back.
                </p>
            }
            @if (_bidStatus is not null)
            {
                <div class="status-line" style="margin-top:.6rem"><span class="dot wait"></span> @_bidStatus</div>
            }
            @if (_bidError is not null)
            {
                <div class="status-line" style="margin-top:.6rem"><span class="dot bad"></span> @_bidError</div>
            }
            @if (_bidDone is not null)
            {
                <div class="status-line" style="margin-top:.6rem"><span class="dot ok"></span> @_bidDone</div>
            }
        </div>
    }
    @if (IsMine(h) && IncomingBids(h).Count > 0)
    {
        <div class="card">
            <div class="page-head" style="margin-bottom:.8rem">
                <h3 style="margin:0">Offers on @h.Name</h3>
                <span class="hud">someone wants to buy this hero · accepting is what bills them</span>
            </div>
            @foreach (var b in IncomingBids(h))
            {
                <div class="equip-row">
                    <div class="equip-meta">
                        <span class="equip-slot">@BidStatusLabel(b)</span>
                        <b class="equip-name">@b.BidSats.ToString("N0") sat</b>
                    </div>
                    <span class="chip mono">@Short(b.BidderPlayerId)</span>
                    @if (b.Status == "proposed")
                    {
                        <button class="btn primary" @onclick="() => DoAcceptBid(b.BidId)" disabled="@_bidBusy">Accept</button>
                        <button class="btn ghost" @onclick="() => DoDeclineBid(b.BidId)" disabled="@_bidBusy">Decline</button>
                    }
                    else if (b.Status == "accepted")
                    {
                        @* One button, not two: the hero is the irreversible leg, so the funded check and the
                           send are the same action — a "send" that can run against an unpaid bid is a way to
                           give a hero away for nothing. *@
                        <button class="btn primary" @onclick="() => DoDeliverBid(b.BidId)" disabled="@_bidBusy">
                            @(_bidBusy ? "…" : $"Send hero & collect {(b.BidSats - b.FeeSats):N0} sat")
                        </button>
                    }
                </div>
            }
            @if (_bidStatus is not null)
            {
                <div class="status-line" style="margin-top:.6rem"><span class="dot wait"></span> @_bidStatus</div>
            }
            @if (_bidError is not null)
            {
                <div class="status-line" style="margin-top:.6rem"><span class="dot bad"></span> @_bidError</div>
            }
            @if (_bidDone is not null)
            {
                <div class="status-line" style="margin-top:.6rem"><span class="dot ok"></span> @_bidDone</div>
            }
        </div>
    }

    <div class="wallet-grid">
        <div class="card">
            <h3>Stats</h3>
            <div class="stat-grid mono">
                <div><span>HP</span><b>@h.Stats.MaxHp</b></div>
                <div><span>ATK</span><b>@h.Stats.Attack</b></div>
                <div><span>MAG</span><b>@h.Stats.Magic</b></div>
                <div><span>DEF</span><b>@h.Stats.Defense</b></div>
                <div><span>SPD</span><b>@h.Stats.Speed</b></div>
                <div><span>LCK</span><b>@h.Stats.Luck</b></div>
                <div><span>CRIT</span><b>@h.Stats.CritPercent%</b></div>
                <div><span>DODGE</span><b>@h.Stats.DodgePercent%</b></div>
            </div>
            @* Build SHAPE and the counter charm — shown ONLY when the published config has GearCounters on,
               the same gate PR #112 put on the innate badges. This surface is why the flip is legitimate
               rather than merely live: a counter is decided by the OPPONENT's shape, so a player who cannot
               see shape reads the swing as randomness instead of as a matchup to plan for.
               Shape is a pure function of the UNEQUIPPED build (genome + level) under the default counter
               knobs — the same ones a live arena resolves under — so it is recomputed here rather than served. *@
            @if (_gearCounters && _shape is { } shape)
            {
                var counterGear = CounterGear(h);
                <div class="hud" style="margin:.9rem 0 .4rem">build shape · what an opponent's charm keys off</div>
                <div class="chips">
                    <span class="chip" title="@ShapeBlurb(shape)">shape <b>@(Lower(shape))</b></span>
                    @foreach (var gear in counterGear)
                    {
                        @if (ShapeOf(gear.Counters) is { } countered)
                        {
                            <span class="chip" title="@(gear.Name): stronger against a @(Lower(countered)) build, weaker against a @(Lower(CombatShapes.WeakTo(countered))) one, and neutral otherwise — only the matchup decides.">counters <b>@(Lower(countered))</b></span>
                        }
                        else if (gear.VarianceBonus > 0)
                        {
                            <span class="chip ghost" title="@(gear.Name): a wider, mean-preserving damage roll — it buys no edge at all, only less certainty. Worth bringing as the underdog and leaving at home as the favourite.">wildcard <b>+@(gear.VarianceBonus)% roll</b></span>
                        }
                    }
                    @* Only claim "none" when the catalog actually loaded — with it missing we do not KNOW. *@
                    @if (counterGear.Count == 0 && _catalog.Count > 0)
                    {
                        <span class="muted">no counter charm — this hero's trinket is matchup-neutral</span>
                    }
                </div>
            }
        </div>

        <div class="card">
            <h3>Traits</h3>
            @if (h.Rarity is { Expressed.Count: > 0 } or { CarriedRecessives.Count: > 0 })
            {
                <div class="hud" style="margin-bottom:.4rem">expressed</div>
                <div class="chips">
                    @foreach (var t in h.Rarity!.Expressed)
                    {
                        <span class="chip">@t.Category <b class="tag-@t.Tier.ToLowerInvariant()">@t.Tier</b></span>
                    }
                    @if (h.Rarity.Expressed.Count == 0) { <span class="muted">none yet — traits emerge through breeding</span> }
                </div>
                @if (h.Rarity.CarriedRecessives.Count > 0)
                {
                    <div class="hud" style="margin:.9rem 0 .4rem">carried recessives · breeding potential</div>
                    <div class="chips">
                        @foreach (var t in h.Rarity.CarriedRecessives)
                        {
                            <span class="chip ghost">@t.Category <b class="tag-@t.Tier.ToLowerInvariant()">@t.Tier</b></span>
                        }
                    </div>
                }
            }
            else
            {
                @* Trait-blank is not the same fact for a recruit as for a bred hero, and this branch used
                   to state the recruit's version for both — telling the owner of a gen-3 child it was a
                   gen-0 starter. Only generation settles it. A bred hero with no traits is ORDINARY:
                   traits arrive by mutation, and the odds are deliberately long (see /codex), so most
                   children inherit nothing visible from either parent. *@
                @if (h.Generation == 0)
                {
                    <p class="muted">A recruit — blank on traits. Breed it and its line can mutate some.</p>
                }
                else
                {
                    <p class="muted">
                        No traits, expressed or carried — generation @h.Generation. Nothing mutated in this
                        one, which is the common outcome; traits are rare by design. Breeding it again is
                        another roll.
                    </p>
                }
            }
            @* Innate combat passives each expressed cosmetic trait grants — shown ONLY when the published
               config has InnateAbilities on (default off ⇒ hidden ⇒ no player-visible change today). *@
            @if (_innateAbilities && _passives.Count > 0)
            {
                <div class="hud" style="margin:.9rem 0 .4rem">innate passives · live in combat</div>
                <div class="chips">
                    @foreach (var p in _passives)
                    {
                        <span class="chip" title="@p.Category → @Passive(p.Category)">@Passive(p.Category) <b class="tag-@p.Tier.ToString().ToLowerInvariant()">@p.Tier</b></span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="wallet-grid">
        <div class="card">
            <h3>Skills</h3>
            @if (h.Skills.Count == 0)
            {
                <p class="muted">No skills learned.</p>
            }
            else
            {
                <div class="skill-list">
                    @foreach (var s in h.Skills)
                    {
                        <div class="skill">
                            <div class="skill-head"><b>@s.Name</b> <span class="chip">@(s.Element ?? "physical")</span></div>
                            <div class="statline mono">
                                <span>pow @s.Power</span>
                                <span>acc @s.Accuracy%</span>
                                <span>cd @s.CooldownTurns</span>
                            </div>
                            @if (!string.IsNullOrEmpty(s.Effect) && s.Effect != "None")
                            {
                                <div class="muted" style="font-size:.8rem">@s.Effect</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card">
            <h3>Equipment</h3>
            <div class="equip-list">
                @foreach (var (slot, item) in h.Equipment)
                {
                    <div class="equip-row">
                        <ItemSprite ItemId="@item" Size="40" />
                        <div class="equip-meta">
                            <span class="equip-slot">@slot</span>
                            <b class="equip-name">@Pretty(item)</b>
                        </div>
                        @if (IsMine(h))
                        {
                            <button class="btn ghost equip-x" title="unequip" @onclick="() => DoUnequip(slot)" disabled="@_busy">✕</button>
                        }
                    </div>
                }
                @if (h.Equipment.Count == 0)
                {
                    <p class="muted" style="margin:0">Nothing equipped.</p>
                }
            </div>
            @* The picker used to offer the whole SHOP — every item in the catalogue, most of which this
               player has never bought. Picking one produced "You hold 0 unit(s) of X", which is the server
               being right about a question the page should never have asked. It offers what the player
               HOLDS now, and says which of the two it is showing. *@
            @if (IsMine(h) && _catalog.Count > 0)
            {
                @if (PickerItems.Count > 0)
                {
                    <select class="equip-add" @bind="_equipPick" @bind:after="OnEquipPicked" disabled="@_busy">
                        <option value="">@PickerPlaceholder</option>
                        @foreach (var opt in PickerItems)
                        {
                            <option value="@opt.Id">@opt.Slot · @opt.Name</option>
                        }
                    </select>
                }
                else
                {
                    <p class="muted" style="margin:.6rem 0 0">
                        You don't own any gear yet — the armory is on the <a href="gear">Gear</a> page.
                    </p>
                }
                @if (_ownedItemIds is null)
                {
                    @* Said out loud rather than silently showing the catalogue as if it were the inventory:
                       the whole defect being fixed here is a list that looked like one thing and was another. *@
                    <div class="status-line" style="margin-top:.5rem">
                        <span class="dot bad"></span>
                        <span>Couldn't read which items you own, so this lists the whole catalogue — anything you don't hold will be refused.</span>
                    </div>
                }
            }
            @if (_equipError is not null)
            {
                <div class="status-line" style="margin-top:.5rem"><span class="dot bad"></span> @_equipError</div>
            }
            <h3 style="margin-top:1.2rem">Lineage</h3>
            <div class="kv">
                <div><span>generation</span><b>@h.Generation</b></div>
                @* A parent that has since been destroyed is still linked — its headstone is a real page —
                   but it is NAMED and marked, because "this hero's mother was burned into a fusion" is
                   lineage, not an error. The name comes off the headstone or not at all. *@
                @if (h.ParentAId is not null)
                {
                    <div><span>parent A</span>@ParentLink(h.ParentAId)</div>
                }
                @if (h.ParentBId is not null)
                {
                    <div><span>parent B</span>@ParentLink(h.ParentBId)</div>
                }
                @if (h.ParentAId is null && h.ParentBId is null)
                {
                    <div><span>origin</span><b>gen-0 starter</b></div>
                }
                @if (h.BreedCooldownUntil is { } cd)
                {
                    <div><span>breed cooldown</span><b>@cd.UtcDateTime.ToString("u")</b></div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <h3>On-chain · this hero is an Arkade asset</h3>
        <div class="kv wide">
            <div><span>genome</span><code class="mono genome">@h.GenomeHex</code></div>
            @if (h.AssetId is not null)
            {
                <div><span>asset id</span><code class="mono genome">@h.AssetId</code></div>
            }
            @if (h.MintArkTxId is not null)
            {
                <div><span>mint tx</span><code class="mono genome">@h.MintArkTxId</code></div>
            }
            @if (h.Provenance is { CommitmentHex: not null })
            {
                <div><span>commitment</span><code class="mono genome">@h.Provenance.CommitmentHex</code></div>
            }
            @if (h.Provenance is { ServerSeedHex: not null })
            {
                <div><span>server seed</span><code class="mono genome">@h.Provenance.ServerSeedHex</code></div>
            }
        </div>
    </div>

    <div class="card">
        <div class="page-head" style="margin-bottom:.8rem">
            <h3 style="margin:0">Progression receipts</h3>
            <span class="hud">signed facts · verified in your browser</span>
            <span class="spacer"></span>
            @if (_receipts.Count > 0)
            {
                <span class="chip mono">replayed level @_replayedLevel</span>
            }
        </div>
        @if (_receipts.Count == 0)
        {
            <p class="muted">No progression yet — this hero hasn't fought, bred, or merged.</p>
        }
        else
        {
            <div class="receipt-list">
                @foreach (var r in _receipts.OrderByDescending(r => r.UnixSeconds))
                {
                    var v = ReceiptVerifier.VerifyAgainst(r, _advertisedKey);
                    <div class="receipt">
                        <div class="receipt-head">
                            <span class="chip">@r.Type</span>
                            <span class="status-line" style="gap:.4rem">
                                <span class="dot @DotFor(v.Trust)"></span>
                                <span class="mono" style="font-size:.72rem">@LabelFor(v.Trust)</span>
                            </span>
                        </div>
                        <div class="statline mono">
                            <span>A lvl @r.LevelA (@Signed(r.XpAwardA) xp)</span>
                            <span>B lvl @r.LevelB (@Signed(r.XpAwardB) xp)</span>
                            @if (r.ResultHeroId is not null)
                            {
                                <span>→ @Short(r.ResultHeroId)</span>
                            }
                        </div>
                        @if (v.Trust != ReceiptTrust.Verified)
                        {
                            <div class="muted" style="font-size:.78rem">@v.Detail</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@* The provenance card, shared by the living-hero page and the headstone. A destroyed hero's history is
   the one a player most wants to read — it is how the death itself is recorded — so it renders for both
   rather than only where a HeroDto happens to exist. It sits OUTSIDE the branch above for exactly that
   reason: one card, one place, two callers. *@
@if (!_loading && (_hero is not null || _grave is not null))
{
    <div class="card">
        <div class="page-head" style="margin-bottom:.8rem">
            <h3 style="margin:0">Provenance</h3>
            <span class="hud">everything that ever happened to this hero</span>
        </div>
        @if (_timelineError is not null)
        {
            <div class="status-line"><span class="dot bad"></span> @_timelineError</div>
        }
        else if (_timeline is null)
        {
            <div class="status-line"><span class="dot wait"></span> reading its history…</div>
        }
        else
        {
            @if (_timeline.Caveat is not null)
            {
                <p class="tl-caveat">@_timeline.Caveat</p>
            }
            <ol class="tl">
                @foreach (var e in _timeline.Events)
                {
                    <li class="tl-row tl-@e.Kind">
                        <span class="tl-mark" title="@e.Kind">@Glyph(e.Kind)</span>
                        <div class="tl-body">
                            <div class="tl-line">
                                <b>@e.Summary</b>
                                @if (e.Outcome is not null)
                                {
                                    <span class="chip @(e.Outcome == "won" ? "ok" : "bad")">@e.Outcome</span>
                                }
                                @if (e.Sats > 0)
                                {
                                    <span class="chip mono">@e.Sats.ToString("N0") sat</span>
                                }
                            </div>
                            <div class="tl-meta mono">
                                <span>@When(e.UnixSeconds)</span>
                                @if (e.Detail is not null)
                                {
                                    <span>@e.Detail</span>
                                }
                                @foreach (var rel in e.Related)
                                {
                                    @* A destroyed hero still gets a LINK now — its headstone is a real page, and
                                       "where did it go" is the question this line raises. Only one with no name at
                                       all (destroyed before headstones existed) stays unlinked: there is genuinely
                                       nothing on the other end of it. *@
                                    @if (rel.Destroyed && rel.Name is not null)
                                    {
                                        <a href="heroes/@rel.HeroId" class="tl-gone" title="destroyed — this hero no longer exists">@rel.Name · destroyed</a>
                                    }
                                    else if (rel.Name is not null)
                                    {
                                        <a href="heroes/@rel.HeroId">@rel.Name</a>
                                    }
                                    else
                                    {
                                        <span class="tl-gone" title="destroyed — its record was erased with its on-chain asset, before headstones were kept">@Short(rel.HeroId) · destroyed</span>
                                    }
                                }
                                @if (e.WatchMatchId is not null)
                                {
                                    <a href="watch/@e.WatchMatchId">replay ↗</a>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private HeroDto? _hero;
    private HeroTombstoneDto? _grave;
    private HeroTimelineDto? _timeline;
    private string? _timelineError;
    private List<ProgressionReceiptDto> _receipts = new();
    private string? _advertisedKey;
    private int _replayedLevel;
    private bool _loading = true;
    private bool _error;
    private List<ItemDto> _catalog = new();

    /// <summary>The item ids this player holds, or null for "we could not read them".
    ///
    /// <para>Deliberately SEPARATE from <see cref="_catalog"/> rather than a filter over it. The catalog is
    /// also what <c>CounterGear</c> resolves this hero's EQUIPPED ids against for the build-shape chips, so
    /// narrowing it in place would blank those chips for any item the hero is wearing — a second bug wearing
    /// the first one's fix.</para></summary>
    private HashSet<string>? _ownedItemIds;

    private bool _busy;
    private string? _equipError;
    private string _equipPick = "";
    private bool _renaming;
    private string _newName = "";
    private long _renameFeeSats;
    private string? _renameStatus;
    private string? _renameError;
    private bool _innateAbilities;
    private IReadOnlyList<(TraitCategory Category, RarityTier Tier)> _passives = [];
    private bool _gearCounters;
    private CombatShape? _shape;
    private List<BidDto> _bids = new();
    private long _bidSats;
    private bool _bidBusy;
    private string? _bidStatus;
    private string? _bidError;
    private string? _bidDone;
    // Headstones for heroes this page NAMES but does not show — a burned parent in the lineage block, a
    // destroyed opponent in the timeline. Fetched per id and cached, because a page can name several and
    // most heroes are alive (a 404 here is the ordinary answer, not a failure).
    private readonly Dictionary<string, HeroTombstoneDto?> _graves = new();

    protected override void OnInitialized() => State.OnChange += OnState;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = false;
        _grave = null;
        _graves.Clear();
        // A DESTROYED hero has no row for /heroes/{id} to return, so the whole all-or-nothing load below
        // would fail and the page would say "couldn't load this hero" about a hero that was permanently
        // burned in front of its owner. Ask for the headstone FIRST: if there is one, this is a grave, and
        // the grave branch renders instead. Cheap — a 404 is the ordinary answer for a living hero.
        try { _grave = await Api.Heroes.TombstoneAsync(Id); }
        catch { _grave = null; }
        if (_grave is not null)
        {
            _timeline = null;
            _timelineError = null;
            try { _timeline = await Api.Heroes.TimelineAsync(Id); }
            catch { _timelineError = "Couldn't load this hero's history — the rest of the page is unaffected."; }
            _loading = false;
            return;
        }
        try
        {
            // All-or-nothing on purpose — do NOT relax this into independent loads the way
            // Ranks does. These three cross-check each other: info carries the signing key
            // the receipts are judged against, and a partial receipt list replays to a level
            // that silently contradicts the hero's real one. Here half the data produces
            // WRONG claims about provenance, not merely fewer cards.
            var hero = Api.Heroes.GetAsync(Id);
            var receipts = Api.Receipts.ForHeroAsync(Id);
            var info = Api.Chain.InfoAsync();
            await Task.WhenAll(hero, receipts, info);
            _hero = await hero;
            _receipts = await receipts;
            var chainInfo = await info;
            _advertisedKey = chainInfo.GameSignerKey;
            _renameFeeSats = chainInfo.Config?.HeroRenameFeeSats ?? 0;
            _innateAbilities = chainInfo.Config?.InnateAbilities ?? false;
            _gearCounters = chainInfo.Config?.GearCounters ?? false;
            // Passive badges are optional chrome — a genome-parse hiccup must never fail the whole hero page.
            try { _passives = _innateAbilities && _hero is not null ? Traits.InnatePassives(Genome.FromHex(_hero.GenomeHex)) : []; }
            catch { _passives = []; }
            // Same rule for the shape badge: chrome, so a bad genome hides it rather than breaking the page.
            try { _shape = _gearCounters && _hero is not null ? CombatShapes.Of(Genome.FromHex(_hero.GenomeHex), _hero.Level) : null; }
            catch { _shape = null; }
            _replayedLevel = ReceiptVerifier.ReplayLevel(Id, _receipts);
            // Deliberately NOT part of the all-or-nothing above. The timeline cross-checks nothing — it is
            // a rendering of facts those three already carry — so a failure here should cost the history
            // card, not the whole hero. It says so out loud rather than rendering as an empty history,
            // which would read as "nothing ever happened to this hero".
            _timeline = null;
            _timelineError = null;
            try { _timeline = await Api.Heroes.TimelineAsync(Id); }
            catch { _timelineError = "Couldn't load this hero's history — the rest of the page is unaffected."; }
            if (_catalog.Count == 0)
            {
                try { _catalog = await Api.Items.ShopAsync(); }
                catch { /* the equip picker is optional chrome */ }
            }
            // Which of those the player actually HOLDS. Awaited AFTER the catalog rather than alongside it:
            // the picker renders the intersection of the two, and two in-flight reads can land in either
            // order — so a parallel pair would let one render paint a list computed from half the answer.
            // Player-scoped, not hero-scoped, so it is read once per visit like the catalog above; a failed
            // read leaves it null and retries on the next hero, which is what the null branch renders.
            //
            // Gated on OWNING this hero, which is the only state that renders a picker at all. Not merely a
            // saved request: /api/items/mine is authenticated, so asking anonymously answers 400 and puts a
            // failed-resource line in the browser console on every visitor's view of every hero page. The
            // browser suite asserts zero console output per page and caught exactly that.
            if (_ownedItemIds is null && _hero is { } owned && IsMine(owned))
            {
                try { _ownedItemIds = [.. await Api.Items.MineAsync()]; }
                catch { _ownedItemIds = null; }
            }
            await LoadBidsAsync();
            // Name any DESTROYED parent in the lineage block. Optional chrome: a failure leaves the short
            // id, which is what the block showed before headstones existed.
            foreach (var parent in new[] { _hero?.ParentAId, _hero?.ParentBId }.OfType<string>())
                await LoadGraveAsync(parent);
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    // "Can't check" is shown as its own state, never as a red UNVERIFIED: accusing a
    // perfectly good receipt of forgery because we failed to learn the arena's key would
    // be a worse lie than staying quiet.
    private static string DotFor(ReceiptTrust t) => t switch
    {
        ReceiptTrust.Verified => "ok",
        ReceiptTrust.NoAnchor => "wait",
        _ => "bad",
    };

    private static string LabelFor(ReceiptTrust t) => t switch
    {
        ReceiptTrust.Verified => "verified",
        ReceiptTrust.NoAnchor => "can't check",
        _ => "UNVERIFIED",
    };

    static string Short(string s) => s.Length <= 12 ? s : $"{s[..6]}…{s[^4..]}";
    static string Signed(long n) => n > 0 ? $"+{n}" : n.ToString();

    // A mark per event class. Typographic, not pictorial — the arena's own voice, and legible at 12px.
    static string Glyph(string kind) => kind switch
    {
        "born" => "✦",
        "bred" or "bred-with" => "❖",
        "fused" or "absorbed" => "⬢",
        "burned" or "destroyed" => "✖",
        "duel" or "squad" or "spar" => "⚔",
        "deathmatch" => "☠",
        "gauntlet" => "⚑",
        "trials" => "∞",
        "sold" => "⇄",
        _ => "·",
    };

    // A zero timestamp is NOT a date — nothing in the arena stamps a hero with its birth moment, so the
    // events derived from lineage alone genuinely have no time. Printing the epoch would be a lie that
    // looks like a fact; say the moment is unknown instead.
    static string When(long unixSeconds) => unixSeconds <= 0
        ? "moment not recorded"
        : DateTimeOffset.FromUnixTimeSeconds(unixSeconds).UtcDateTime.ToString("yyyy-MM-dd HH:mm") + " UTC";

    // Prettify a catalog item id for display ("steel-saber" -> "Steel Saber").
    static string Pretty(string id) => string.IsNullOrEmpty(id) ? id
        : string.Join(' ', id.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => char.ToUpperInvariant(w[0]) + w[1..]));

    // The combat passive each expressed cosmetic category grants (rung-3 surfacing), per the design mapping.
    // Each is a rare PROC whose chance scales with the trait's rarity tier, not an always-on modifier.
    static string Passive(TraitCategory c) => c switch
    {
        TraitCategory.Aura => "Shield",
        TraitCategory.Marking => "Regen",
        TraitCategory.Eyes => "True Strike",
        TraitCategory.Crest => "Thorns",
        TraitCategory.Sigil => "Brand",
        TraitCategory.Stance => "Initiative",
        _ => c.ToString(),
    };

    // Shape names read as lowercase prose in the chips, matching the rest of the card's voice.
    static string Lower(CombatShape s) => s.ToString().ToLowerInvariant();

    // What the shape MEANS, in the terms the stat grid above it already uses.
    static string ShapeBlurb(CombatShape s) => s switch
    {
        CombatShape.Offense => "Attack/Magic lead this build — it hits hardest.",
        CombatShape.Bulk => "Defense/HP lead this build — it is hardest to kill.",
        _ => "Speed/Crit lead this build — it acts first and crits most.",
    };

    // The DTO carries the countered shape as a string; anything unrecognised reads as "no counter" rather
    // than throwing, so a newer server naming a shape this build has never heard of degrades quietly.
    static CombatShape? ShapeOf(string? counters) =>
        Enum.TryParse<CombatShape>(counters, out var s) ? s : null;

    // The counter charms / wildcard this hero is actually wearing, resolved against the SERVER's catalog
    // rather than a compiled-in copy — item rows are authored content and can differ from this build's.
    private List<ItemDto> CounterGear(HeroDto h) => h.Equipment.Values
        .Select(id => _catalog.FirstOrDefault(i => i.Id == id))
        .OfType<ItemDto>()
        .Where(i => i.Counters is not null || i.VarianceBonus > 0)
        .ToList();

    // Fill % for the XP-to-next bar; a max-level hero (no next threshold) reads full.
    static int XpPct(HeroDto h) => h.XpToNext > 0
        ? (int)Math.Clamp(Math.Round(h.Xp * 100.0 / h.XpToNext), 0, 100)
        : 100;

    // Equip controls only for the signed-in owner of this hero.
    private bool IsMine(HeroDto h) => State.IsSignedIn && h.OwnerId == State.Player?.PlayerId;

    /// <summary>What the picker offers: the player's own items, or — when that read failed — the catalogue,
    /// under a line that says so. Ownership is the same predicate the server's equip gate uses, so this is
    /// no longer a list of mostly-refusals; it is not a PROMISE, though, because the level gate and the
    /// already-allocated-units gate can still refuse an item the player genuinely holds.</summary>
    private List<ItemDto> PickerItems => _ownedItemIds is { } owned
        ? _catalog.Where(i => owned.Contains(i.Id)).ToList()
        : _catalog;

    /// <summary>Names which list is on screen, so "your items" is never claimed over the whole shop.</summary>
    private string PickerPlaceholder => _ownedItemIds is null
        ? "＋ equip an item…"
        : "＋ equip one of your items…";

    private async Task OnEquipPicked()
    {
        var itemId = _equipPick;
        _equipPick = "";                       // reset the dropdown to its placeholder
        if (!string.IsNullOrEmpty(itemId)) await DoEquip(itemId);
    }

    private async Task DoEquip(string itemId)
    {
        _busy = true; _equipError = null;
        try { _hero = await Session.EquipAsync(Id, itemId); }
        catch (Exception ex) { _equipError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DoUnequip(string slot)
    {
        _busy = true; _equipError = null;
        try { _hero = await Session.UnequipAsync(Id, slot); }
        catch (Exception ex) { _equipError = ex.Message; }
        finally { _busy = false; }
    }

    private void StartRename() { _renaming = true; _renameError = null; }
    private void CancelRename() { _renaming = false; _renameStatus = null; _renameError = null; }

    private async Task DoRename()
    {
        _busy = true; _renameError = null;
        try
        {
            _hero = await Session.RenameHeroAsync(Id, _newName.Trim(), s => { _renameStatus = s; StateHasChanged(); });
            _renaming = false; _renameStatus = null; _newName = "";
        }
        catch (Exception ex) { _renameError = ex.Message; _renameStatus = null; }
        finally { _busy = false; }
    }

    private void OnState() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= OnState;

    // ── Destroyed heroes ───────────────────────────────────────────────────

    // Heroes are HARD DELETED when they die, so there is no row to read a name off — the headstone is it.
    // A living or unknown hero 404s here and caches as null, which is why the miss is not an error.
    private async Task LoadGraveAsync(string heroId)
    {
        if (_graves.ContainsKey(heroId)) return;
        try { _graves[heroId] = await Api.Heroes.TombstoneAsync(heroId); }
        catch { _graves[heroId] = null; }
    }

    // A parent link that tells the truth about a parent that no longer exists. Still a LINK — a headstone
    // is a real page, and "what happened to it" is precisely the question a burned parent raises.
    private RenderFragment ParentLink(string heroId) => builder =>
    {
        var grave = _graves.GetValueOrDefault(heroId);
        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", $"heroes/{heroId}");
        builder.AddAttribute(2, "class", grave is null ? "mono" : "mono tl-gone");
        if (grave is not null) builder.AddAttribute(3, "title", "destroyed — this hero no longer exists");
        builder.AddContent(4, grave is null ? Short(heroId) : $"{grave.Name} · destroyed");
        builder.CloseElement();
    };

    private static string DestroyedWhen(HeroTombstoneDto g) => When(g.DestroyedAtUnixSeconds);

    // The reason codes, in the arena's own voice. The vocabulary matches what the server writes at the
    // burn site, so the two can't drift into describing different deaths.
    private static string DestroyedBlurb(HeroTombstoneDto g) => g.Reason switch
    {
        "merge-input" => "Burned as an input to a fusion. Its traits went into the hero that was forged from it; "
            + "the hero itself is gone, and its on-chain asset was retired with it.",
        "deathmatch-loser" => "Lost a death-match. Death is permanent here — the loser's hero is burned by the "
            + "covenant itself, its record erased, and its on-chain asset retired. It cannot be recovered.",
        "deathmatch-absorb-winner" => "Won its death-match, and was consumed by the absorb that followed. Both "
            + "heroes were burned to mint the one that rose from them.",
        "deathmatch-absorb-loser" => "Lost a death-match in absorb mode. Both heroes were burned to mint the one "
            + "that rose from them.",
        _ => "Permanently destroyed. Its record was erased and its on-chain asset retired.",
    };

    // ── Bids ───────────────────────────────────────────────────────────────

    private async Task LoadBidsAsync()
    {
        try { _bids = await Api.Bids.ListAsync(); }
        catch { /* the bid panel is optional chrome — never fail the hero page over it */ }
    }

    /// <summary>This player's own live bid on this hero, if any. Terminal ones are filtered out: a settled
    /// or refused bid is history, and showing it as "your bid" would block placing a fresh one.</summary>
    private BidDto? MyBidOn(HeroDto h) => _bids.FirstOrDefault(b =>
        b.HeroId == h.Id && b.BidderPlayerId == State.Player?.PlayerId
        && b.Status is "proposed" or "accepted");

    /// <summary>Live bids from OTHERS on a hero this player owns — the owner's inbox.</summary>
    private List<BidDto> IncomingBids(HeroDto h) => _bids
        .Where(b => b.HeroId == h.Id && b.Status is "proposed" or "accepted")
        .OrderByDescending(b => b.BidSats)
        .ToList();

    private static string BidStatusLabel(BidDto b) => b.Status switch
    {
        "proposed" => "awaiting the owner",
        "accepted" => "accepted · awaiting delivery",
        "settled" => "settled",
        "refunded" => "unwound · refunded",
        "declined" => "declined",
        "withdrawn" => "withdrawn",
        _ => b.Status,
    };

    private static string BidChipClass(string status) => status switch
    {
        "accepted" or "settled" => "ok",
        "declined" or "withdrawn" or "refunded" => "bad",
        _ => "",
    };

    private static string BidBlurb(BidDto b, HeroDto h) => b.Status switch
    {
        "proposed" => $"{h.Name}'s owner hasn't answered yet. You have been charged nothing — an offer is not a payment.",
        "accepted" => "Accepted. Pay the bid and the hero is yours once its owner sends it; if they never do, "
            + "unwind the bid after its delivery window and every sat comes back to you.",
        _ => "",
    };

    private async Task DoPlaceBid(string heroId)
    {
        _bidBusy = true; _bidError = null; _bidDone = null;
        try
        {
            await Api.Bids.PlaceAsync(new PlaceBidRequest(heroId, _bidSats));
            _bidDone = "Offer sent. Nothing has been charged — you'll be invoiced only if the owner accepts.";
            _bidSats = 0;
            await LoadBidsAsync();
        }
        catch (Exception ex) { _bidError = ex.Message; }
        finally { _bidBusy = false; _bidStatus = null; }
    }

    private async Task DoWithdrawBid(string bidId) =>
        await BidActionAsync(async () =>
        {
            await Api.Bids.WithdrawAsync(bidId);
            return "Offer withdrawn.";
        });

    private async Task DoAcceptBid(string bidId) =>
        await BidActionAsync(async () =>
        {
            var accepted = await Api.Bids.AcceptAsync(bidId);
            return $"Accepted — the bidder has been invoiced {accepted.Bid.BidSats:N0} sat. "
                 + $"Send the hero once it reads funded and you'll collect {accepted.SellerNetSats:N0} sat.";
        });

    private async Task DoDeclineBid(string bidId) =>
        await BidActionAsync(async () =>
        {
            await Api.Bids.DeclineAsync(bidId);
            return "Offer declined. Nothing was billed.";
        });

    private async Task DoFundBid(string bidId) =>
        await BidActionAsync(async () =>
        {
            var hero = await Session.FundBidAsync(bidId, s => { _bidStatus = s; StateHasChanged(); });
            return hero is null
                ? "Paid. Waiting for the owner to send the hero — your sats are recoverable if they never do."
                : $"{hero.Name} is yours.";
        });

    private async Task DoDeliverBid(string bidId) =>
        await BidActionAsync(async () =>
        {
            var hero = await Session.DeliverBidHeroAsync(bidId, s => { _bidStatus = s; StateHasChanged(); });
            return $"{hero.Name} was delivered and you've been paid.";
        });

    private async Task DoUnwindBid(string bidId) =>
        await BidActionAsync(async () =>
        {
            var res = await Api.Bids.RefundAsync(bidId);
            return res.RefundedSats > 0
                ? $"Unwound — {res.RefundedSats:N0} sat is on its way back to you."
                : "Unwound. Nothing had been paid, so there was nothing to return.";
        });

    // One busy/error/reload wrapper for every bid action: they all change what the page must show next
    // (a bid's state, and possibly the hero's owner), so all of them re-read rather than patch locally.
    private async Task BidActionAsync(Func<Task<string>> action)
    {
        _bidBusy = true; _bidError = null; _bidDone = null;
        try { _bidDone = await action(); }
        catch (Exception ex) { _bidError = ex.Message; }
        finally
        {
            _bidStatus = null;
            _bidBusy = false;
            await LoadBidsAsync();
            // A settle moves the hero itself, so the page's own subject may have changed hands.
            try { _hero = await Api.Heroes.GetAsync(Id); } catch { /* leave what we have */ }
        }
    }
}
