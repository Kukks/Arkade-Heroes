@page "/sell"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@implements IDisposable

<PageTitle>Sell · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Sell</h2>
    <span class="hud">covenant-enforced · no custodian, ever</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then come back to list a hero for sale.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading your heroes…</div>
}
@* "You have no heroes" and "we never managed to read your roster" are different facts, and this branch
   used to state the first while meaning either — telling a player with a full stable to go and claim
   starters they already own. _heroesLoaded was already declared and set; it was simply never read. *@
else if (!_heroesLoaded)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your roster.</div>
        <p class="muted" style="margin:.6rem 0 0">
            This is not the same as having nothing to sell — we simply couldn't look. @_loadError
        </p>
        <button class="btn primary sm" style="margin-top:.7rem" @onclick="Retry" disabled="@_loading">Try again</button>
    </div>
}
else if (_mine.Count == 0)
{
    <div class="card muted">
        You have no heroes to sell yet — <a href="heroes?mine=1">recruit one</a> or <a href="breed">breed</a> first.
    </div>
}
else
{
    <div class="card">
        <p class="muted" style="margin-top:0">
            List one of your heroes at a fixed ask. Your wallet deposits the hero into a covenant offer
            address; it rests on the market until a buyer pays the ask, and the same covenant that hands
            them the hero pays you out of it — no custodian, no middleman holding your funds.
        </p>
        <div class="sell-picks">
            <label>Hero
                <select @bind="_heroId">
                    <option value="">— pick —</option>
                    @foreach (var h in _mine)
                    {
                        <option value="@h.Id">@h.Name — lvl @h.Level · @(h.Rarity?.Tier ?? "Common")</option>
                    }
                </select>
            </label>
            <label>Ask <span class="mini">sats</span>
                @* oninput, not the default onchange: the List button is gated on the ask clearing the
                   fee, and a blur-only bind would leave it dead while a valid number is on screen (#121). *@
                <input type="number" min="1" step="1000" class="ask-input" @bind="_ask" @bind:event="oninput" />
            </label>
        </div>
        @if (_listingFeeSats > 0 && _ask > _listingFeeSats)
        {
            <p class="muted" style="margin:.6rem 0 0;font-size:.85rem">
                A <b>@_listingFeeSats sat</b> marketplace fee comes out of the sale — you receive
                <b>@((_ask - _listingFeeSats).ToString("N0")) sats</b> when it sells. Listing costs nothing,
                and a hero that never sells is never charged.
            </p>
        }
        else if (_listingFeeSats > 0 && _ask > 0)
        {
            <div class="status-line" style="margin-top:.6rem">
                <span class="dot bad"></span>
                <span>The ask must be more than the <b>@_listingFeeSats sat</b> marketplace fee — it is taken from the sale.</span>
            </div>
        }
        <button class="btn primary" style="margin-top:1.1rem" @onclick="DoList"
                disabled="@(_listing || string.IsNullOrEmpty(_heroId) || _ask <= 0 || _ask <= _listingFeeSats)">
            @(_listing ? "Listing…" : "List for sale")
        </button>
        @if (_status is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div>
        }
        @if (_error is not null)
        {
            <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div>
        }
    </div>

    @if (_listed is not null)
    {
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Listed on the market</h3>
            <span class="hud">resting · the covenant pays you on sale</span>
        </div>
        <div class="grid cols"><OfferCard Offer="_listed" Hero="_listedHero" Reveal="true" /></div>
        <p class="muted" style="margin-top:1rem"><a href="market">See it resting in the Market →</a></p>
    }
}

@code {
    private List<HeroDto> _mine = new();
    private string _heroId = "";
    private long _ask = 25000;
    private bool _loading = true;
    private bool _listing;
    private bool _heroesLoaded;
    private string? _status;
    private string? _error;
    private string? _loadError;
    private OfferDto? _listed;
    private HeroDto? _listedHero;
    private long _listingFeeSats;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        // Preview the listing fee (public config; a nice-to-have — listing still works if this fails).
        try { _listingFeeSats = (await Api.Chain.InfoAsync()).Config?.OfferListingFeeSats ?? 0; }
        catch { /* leave at 0 */ }
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            _heroesLoaded = true;
            _loadError = null;
        }
        catch (Exception ex)
        {
            // RECORDED, not swallowed. OnState only re-runs on the NEXT wallet event, and a server hiccup
            // produces none — so a one-off failure looked exactly like owning no heroes, forever.
            _loadError = ex.Message;
        }
        finally { _loading = false; }
    }

    /// <summary>Manual retry, because the automatic one depends on an event that may never fire.</summary>
    async Task Retry()
    {
        _error = null;
        await LoadAsync();
    }

    async Task DoList()
    {
        _listing = true;
        _error = null;
        _listed = null;
        _listedHero = _mine.FirstOrDefault(h => h.Id == _heroId);
        _status = "Preparing the offer…";
        try
        {
            _listed = await Session.ListHeroAsync(_heroId, _ask,
                s => { _status = s; StateHasChanged(); });
            _status = null;
            _heroId = "";
            await LoadAsync();  // the listed hero has left the wallet
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _status = null;
        }
        finally
        {
            _listing = false;
        }
    }

    void OnState() => InvokeAsync(async () =>
    {
        if (State.IsSignedIn && !_heroesLoaded && !_loading)
            await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;
}
