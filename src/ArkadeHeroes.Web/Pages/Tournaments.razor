@page "/tournaments"
@inject ArkadeHeroesClient Api
@inject GameSession Session
@inject WalletState State
@implements IDisposable

<PageTitle>Tournaments · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Tournaments</h2>
    <span class="hud">buy-in bracket · single elimination · champion + runner-up split the pot</span>
</div>

@if (!State.IsSignedIn)
{
    <div class="card muted">Press <a href="/">Play</a> on the home page — your wallet is set up automatically — then enter a bracket.</div>
}
else if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> loading brackets…</div>
}
@* "You have no heroes" and "we never managed to read your roster" are different facts, and this branch
   used to state the first while meaning either — hiding the host form, the open brackets AND the player's
   own paid-into bracket behind a lie. _heroesLoaded was already declared and set; it was simply never
   read. Same fix as /duel, /deathmatch, /gauntlet and /trials already carry. *@
else if (!_heroesLoaded)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't read your account.</div>
        <p class="muted" style="margin:.6rem 0 0">
            This is not the same as owning no heroes — we simply couldn't look, so any bracket you have
            entered is still live. @_loadError
        </p>
        <button class="btn primary sm" style="margin-top:.7rem" @onclick="Retry" disabled="@_loading">Try again</button>
    </div>
}
else if (_mine.Count == 0)
{
    <div class="card muted">You need a hero to enter — recruit one on the <a href="heroes?mine=1">Heroes</a> page.</div>
}
else
{
    <div class="card">
        <h3 style="margin-top:0">Host a tournament</h3>
        <p class="muted" style="margin-top:0">
            Pick a hero, a buy-in, and a bracket size. Every buy-in funds the pot; once full, any entrant runs the
            bracket and the champion + runner-up split it 70/30@(_rakePct is { } rake ? $" (the house keeps a {rake}% rake)" : ", less the house rake").
        </p>
        <div class="sell-picks">
            <label>Hero
                <select @bind="_heroId">
                    <option value="">— pick —</option>
                    @foreach (var h in _mine) { <option value="@h.Id">@h.Name — lvl @h.Level</option> }
                </select>
            </label>
            <label>Buy-in <span class="mini">sats</span>
                <input type="number" min="1" step="500" class="ask-input" @bind="_buyIn" />
            </label>
            <label>Size
                <select @bind="_size">
                    <option value="2">2</option>
                    <option value="4">4</option>
                    <option value="8">8</option>
                </select>
            </label>
        </div>
        <button class="btn primary" style="margin-top:1rem" @onclick="DoOpen"
                disabled="@(_busy || string.IsNullOrEmpty(_heroId) || _buyIn < 1)">
            @(_busy ? "Working…" : "Host bracket")
        </button>
        @if (_status is not null) { <div class="status-line" style="margin-top:.9rem"><span class="dot wait"></span> @_status</div> }
        @if (_error is not null) { <div class="status-line" style="margin-top:.9rem"><span class="dot bad"></span> @_error</div> }
    </div>

    <div class="page-head" style="margin-top:1.8rem">
        <h3 style="margin:0">Open brackets</h3>
        <span class="spacer"></span>
        <button class="btn ghost sm" @onclick="Reload" disabled="@_busy">Refresh</button>
    </div>
    @if (!Joinable.Any() && !Resolvable.Any() && !Waiting.Any() && !OthersFull.Any() && !Concluded.Any())
    {
        <div class="card muted">No open brackets — host one above.</div>
    }
    else
    {
        @foreach (var t in Waiting)
        {
            <div class="card"><div class="match-row">
                <span>Your bracket · <b class="mono">@t.BuyInSats.ToString("N0")</b> sat buy-in · @t.Joined / @t.Size joined</span>
                <span class="spacer"></span>
                <span class="chip">waiting for entrants</span>
            </div></div>
        }
        @foreach (var t in Joinable)
        {
            <div class="card"><div class="match-row">
                <span>Bracket · <b class="mono">@t.BuyInSats.ToString("N0")</b> sat buy-in · @t.Joined / @t.Size joined</span>
                <span class="spacer"></span>
                <button class="btn primary sm" @onclick="() => DoJoin(t.Id)" disabled="@(_busy || string.IsNullOrEmpty(_heroId))">Join</button>
            </div></div>
        }
        @foreach (var t in Resolvable)
        {
            <div class="card"><div class="match-row">
                <span>Your bracket is full · <b class="mono">@t.BuyInSats.ToString("N0")</b> sat buy-in · @t.Size entrants</span>
                <span class="spacer"></span>
                <button class="btn primary sm" @onclick="() => DoResolve(t.Id)" disabled="@_busy">Run bracket!</button>
            </div></div>
        }
        @foreach (var t in OthersFull)
        {
            <div class="card"><div class="match-row muted">
                <span>Bracket · <b class="mono">@t.BuyInSats.ToString("N0")</b> sat buy-in · full (@t.Size entrants)</span>
                <span class="spacer"></span>
                <span class="chip">an entrant will run it</span>
            </div></div>
        }
        @foreach (var t in Concluded)
        {
            <div class="card"><div class="match-row muted">
                <span>Your bracket · <b class="mono">@t.BuyInSats.ToString("N0")</b> sat buy-in · @t.Size entrants</span>
                <span class="spacer"></span>
                @if (t.Status == "refunded")
                {
                    <span class="chip">refunded — your buy-in was returned</span>
                }
                else
                {
                    <span class="chip">@(t.ChampionHeroId is not null ? $"champion {Name(t.ChampionHeroId)}" : "resolved")</span>
                    <button class="btn ghost sm" @onclick="() => DoVerify(t.Id)" disabled="@_verifying">Verify</button>
                }
            </div></div>
        }
    }

    @if (_result is not null)
    {
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Bracket results</h3>
            <span class="hud">champion @Name(_result.Tournament.ChampionHeroId)</span>
        </div>
        <div class="card">
            @foreach (var round in _result.Bracket.GroupBy(m => m.Round).OrderBy(g => g.Key))
            {
                <div class="hud" style="margin:.5rem 0">Round @(round.Key + 1)</div>
                @foreach (var m in round.OrderBy(m => m.Index))
                {
                    <div class="match-row mono" style="font-size:.82rem">
                        <span>@Name(m.AId) vs @Name(m.BId)</span>
                        <span class="spacer"></span>
                        <span class="chip">@Name(m.WinnerId) ✓</span>
                    </div>
                }
            }
            <div class="status-line" style="margin-top:.8rem"><span class="dot ok"></span>
                <span>Prizes: @string.Join(" · ", _result.Prizes.Select((p, i) => $"#{i + 1} {p:N0} sat"))</span>
            </div>
            <div class="match-row" style="margin-top:.9rem">
                <span class="hud">Don't trust the pot — recompute it</span>
                <span class="spacer"></span>
                <button class="btn ghost sm" @onclick="() => DoVerify(_result!.Tournament.Id)" disabled="@_verifying">
                    @(_verifying ? "Verifying…" : "Verify in my browser")
                </button>
            </div>
            @if (_verify is { } v)
            {
                <div class="status-line" style="margin-top:.5rem">
                    <span class="dot @(v.Ok ? "ok" : "bad")"></span>
                    <span>@(v.Ok
                        ? "Verified in your browser: the champion matches the committed seed and the entrant set locked at fill — the pot was fair, and you trusted nothing the server said."
                        : $"Verification FAILED — {v.Detail}. This result does not match the committed seed; do not trust it.")</span>
                </div>
            }
        </div>
    }
}

@code {
    private List<HeroDto> _mine = new();
    private readonly Dictionary<string, string> _names = new();
    private List<TournamentDto> _tournaments = new();
    private string _heroId = "";
    private long _buyIn = 1000;
    private int _size = 4;

    /// <summary>The house rake, or null when we couldn't read it. Nullable on purpose: an int defaulting to
    /// 0 made the page state as fact that the house takes NOTHING out of a real-money pot whenever the
    /// config read failed — a confident wrong price is worse than no price.</summary>
    private int? _rakePct;
    private bool _loading = true, _busy, _heroesLoaded, _verifying;
    private string? _status, _error, _loadError;
    private TournamentResolveResponse? _result;
    private (bool Ok, string Detail)? _verify;

    private string? MyId => _mine.FirstOrDefault()?.OwnerId;
    private IEnumerable<TournamentDto> Joinable => _tournaments.Where(t => t.Status == "open" && !t.Entrants.Any(e => e.PlayerId == MyId));
    private IEnumerable<TournamentDto> Resolvable => _tournaments.Where(t => t.Status == "full" && t.Entrants.Any(e => e.PlayerId == MyId));

    // The fourth combination of (open|full × mine|not-mine), and the one every bracket sits in the moment
    // you host it: still filling, and you are already an entrant. Joinable excludes it (you cannot join
    // twice) and Resolvable excludes it (not full yet), so without this it renders NOWHERE — you pay a
    // real-sats buy-in and your bracket vanishes, under a message inviting you to host another one.
    private IEnumerable<TournamentDto> Waiting => _tournaments.Where(t => t.Status == "open" && t.Entrants.Any(e => e.PlayerId == MyId));

    /// <summary>
    /// Brackets of mine that are OVER — the rest of the fall-through the comment above found one case of
    /// and stopped. The server's statuses are open | full | resolved | refunded, so a bracket I paid into
    /// dropped out of every bucket the moment it finished: a resolved one (my sats won or lost) and a
    /// refunded one (my sats returned by an operator) both left the page saying "No open brackets — host
    /// one above", with nothing anywhere recording that the first bracket had ever existed.
    /// </summary>
    private IEnumerable<TournamentDto> Concluded =>
        _tournaments.Where(t => t.Status is "resolved" or "refunded" && t.Entrants.Any(e => e.PlayerId == MyId));

    /// <summary>A full bracket I am NOT in. Not actionable — I can't join it — but listing it is what stops
    /// "No open brackets" from being printed over a screenful of brackets that plainly exist.</summary>
    private IEnumerable<TournamentDto> OthersFull =>
        _tournaments.Where(t => t.Status == "full" && !t.Entrants.Any(e => e.PlayerId == MyId));
    private string Name(string? heroId) => heroId is not null && _names.TryGetValue(heroId, out var n) ? n : "—";

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!State.IsSignedIn) { _loading = false; return; }
        _loading = true;
        try
        {
            _mine = await Api.Heroes.MineAsync();
            _tournaments = await Api.Tournament.ListAsync();
            foreach (var h in await Api.Heroes.AllAsync()) _names[h.Id] = h.Name;
            _heroesLoaded = true;
            _loadError = null;
        }
        catch (Exception ex)
        {
            // RECORDED, not swallowed: OnState only re-runs on the NEXT wallet event, and a server hiccup
            // produces none — so an already-signed-in player would sit forever on "you need a hero".
            _loadError = ex.Message;
        }
        finally { _loading = false; }

        // Moved OUT of the block above. It used to be the last statement in that try, so a failure to read
        // a display-only percentage also skipped _heroesLoaded and took the whole page down with it.
        try { _rakePct = (await Api.Chain.InfoAsync()).Config?.TournamentRakePct; }
        catch { /* rake unknown — the copy stops quoting a number rather than quoting zero */ }
    }

    /// <summary>Manual retry, because the automatic one depends on an event that may never fire.</summary>
    async Task Retry()
    {
        _error = null;
        await LoadAsync();
    }

    async Task DoOpen() => await RunAction(async () =>
        await Session.OpenTournamentAsync(_heroId, _buyIn, _size, s => { _status = s; StateHasChanged(); }));

    async Task DoJoin(string id) => await RunAction(async () =>
        await Session.JoinTournamentAsync(id, _heroId, s => { _status = s; StateHasChanged(); }));

    async Task DoResolve(string id) => await RunAction(async () =>
    {
        _result = await Session.ResolveTournamentAsync(id, s => { _status = s; StateHasChanged(); });
        await DoVerify(id);   // recompute the just-run bracket in the browser so the trust badge is immediate
    });

    // A pure read + client-side recompute — no wallet, no fee — so a verify failure surfaces as a red
    // badge, never a page error. Works for any resolved bracket the player can see.
    async Task DoVerify(string id)
    {
        _verifying = true; _verify = null; StateHasChanged();
        try { _verify = await Session.VerifyTournamentAsync(id); }
        catch (Exception ex) { _verify = (false, ex.Message); }
        finally { _verifying = false; }
    }

    async Task RunAction(Func<Task> action)
    {
        // Claimed BEFORE the first await. disabled="@_busy" only takes effect at the next render, which
        // happens at that await — so a second click dispatched in the window between ran the whole action
        // again, and DoOpen is not idempotent: it hosts a second bracket and pays a second real-sats
        // buy-in. Home.razor and DailyCard already guard their spends this way; this one did not.
        if (_busy) return;
        _busy = true; _error = null;
        try { await action(); _status = null; }
        catch (Exception ex) { _error = ex.Message; _status = null; }
        // Reload even when the action threw. Open and join create the bracket on the server FIRST and pay
        // the buy-in second, so a payment that fails still leaves a real bracket behind — reloading only on
        // success left the page insisting "No open brackets" while the player's half-finished (and possibly
        // unpaid) bracket sat there unseen, which is exactly the state they most need to see.
        finally { await LoadAsync(); _busy = false; }
    }

    async Task Reload()
    {
        _busy = true;
        try { _tournaments = await Api.Tournament.ListAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    void OnState() => InvokeAsync(async () =>
    {
        if (State.IsSignedIn && !_heroesLoaded && !_loading) await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;
}
