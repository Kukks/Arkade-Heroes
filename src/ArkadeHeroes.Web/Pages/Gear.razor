@page "/gear"
@inject ArkadeHeroesClient Api
@inject WalletState State
@inject GameSession Session
@implements IDisposable

<PageTitle>Gear · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Gear</h2>
    <span class="hud">forge-grade equipment — arm a hero to sharpen its edge</span>
    <span class="spacer"></span>
    <a class="btn ghost" href="market">Hero market →</a>
    @if (!_loading && !_error)
    {
        <span class="chip mono">@_items.Count items</span>
    }
</div>

@if (_buyStatus is not null)
{
    <div class="card"><div class="status-line"><span class="dot wait"></span> @_buyStatus</div></div>
}
@if (_buyError is not null)
{
    <div class="card"><div class="status-line"><span class="dot bad"></span> @_buyError</div></div>
}
@if (_justBought is not null)
{
    <div class="card"><div class="status-line"><span class="dot ok"></span> Bought <b>@_justBought</b> — equip it from a hero's page.</div></div>
}

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> opening the armory…</div>
}
else if (_error)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't reach the armory.</div>
        <p class="muted" style="margin:.7rem 0 0">Start the server: <span class="mono">dotnet run --project src/ArkadeHeroes.Server</span></p>
    </div>
}
else
{
    @foreach (var slot in SLOTS)
    {
        var items = _items.Where(i => i.Slot == slot).OrderBy(i => i.PriceSats).ToList();
        if (items.Count == 0) { continue; }
        <div class="page-head" style="margin-top:1.4rem">
            <h3 style="margin:0">@slot</h3>
            <span class="hud">@SlotHint(slot)</span>
        </div>
        <div class="grid cols">
            @foreach (var it in items)
            {
                <div class="card gear-card">
                    <div class="gear-tile"><ItemSprite ItemId="@it.Id" Size="104" /></div>
                    <div class="gear-head">
                        <span class="gear-name">@it.Name</span>
                        <span class="chip">@it.Slot</span>
                    </div>
                    <div class="statline mono">
                        @foreach (var m in Mods(it))
                        {
                            <span>@m</span>
                        }
                    </div>
                    <div class="gear-buy">
                        <div class="gear-price"><b>@it.PriceSats.ToString("N0")</b> <span>sats</span></div>
                        @if (State.IsSignedIn)
                        {
                            @if (_owned.Contains(it.Id))
                            {
                                <span class="chip ok mono">owned ✓</span>
                            }
                            else
                            {
                                <button class="btn primary" @onclick="() => DoBuy(it)" disabled="@(_buyingId is not null)">
                                    @(_buyingId == it.Id ? "Buying…" : "Buy")
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
    @if (!State.IsSignedIn)
    {
        <p class="muted" style="margin-top:1.8rem;font-size:.82rem">Hit <b>Play</b> to provision a wallet, then buy gear straight from the browser.</p>
    }
}

@code {
    private static readonly string[] SLOTS = { "Weapon", "Armor", "Trinket" };
    private List<ItemDto> _items = new();
    private bool _loading = true;
    private bool _error;
    private string? _buyingId;
    private string? _buyStatus;
    private string? _buyError;
    private string? _justBought;
    private readonly HashSet<string> _owned = new();
    private bool _ownedHydrated;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        try { _items = await Api.Items.ShopAsync(); }
        catch { _error = true; }
        finally { _loading = false; }
        await HydrateOwnedAsync();
    }

    // Reflect items the player already holds so the "owned" markers survive a refresh (they were
    // session-only before). Best-effort: the login token may still be settling on a cold load, so
    // OnState retries this once the wallet signs in.
    async Task HydrateOwnedAsync()
    {
        if (_ownedHydrated || !State.IsSignedIn) return;
        try
        {
            foreach (var id in await Api.Items.MineAsync()) _owned.Add(id);
            _ownedHydrated = true;
        }
        catch { /* not signed in yet / token racing — retried on the next state change */ }
    }

    async Task DoBuy(ItemDto it)
    {
        _buyingId = it.Id;
        _buyError = null;
        _justBought = null;
        _buyStatus = "Preparing the purchase…";
        try
        {
            await Session.BuyItemAsync(it.Id,
                s => { _buyStatus = s; StateHasChanged(); });
            _owned.Add(it.Id);
            _justBought = it.Name;
        }
        catch (Exception ex)
        {
            _buyError = ex.Message;
        }
        finally
        {
            _buyingId = null;
            _buyStatus = null;
        }
    }

    static string SlotHint(string slot) => slot switch
    {
        "Weapon" => "raises Attack / Magic",
        "Armor" => "raises Max HP / Defense",
        "Trinket" => "raises Speed / Crit",
        _ => "",
    };

    // Non-zero stat modifiers this item confers, ready to render as chips.
    static IEnumerable<string> Mods(ItemDto i)
    {
        if (i.MaxHp != 0) yield return $"{Signed(i.MaxHp)} HP";
        if (i.Attack != 0) yield return $"{Signed(i.Attack)} ATK";
        if (i.Magic != 0) yield return $"{Signed(i.Magic)} MAG";
        if (i.Defense != 0) yield return $"{Signed(i.Defense)} DEF";
        if (i.Speed != 0) yield return $"{Signed(i.Speed)} SPD";
        if (i.CritPercent != 0) yield return $"{Signed(i.CritPercent)}% CRIT";
    }

    static string Signed(int n) => n > 0 ? $"+{n}" : n.ToString();

    void OnState() => InvokeAsync(async () =>
    {
        await HydrateOwnedAsync();   // hydrate owned markers once the wallet signs in on a cold load
        StateHasChanged();
    });

    public void Dispose() => State.OnChange -= OnState;
}
