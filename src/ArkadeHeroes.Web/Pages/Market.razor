@page "/market"
@inject ArkadeHeroesClient Api
@inject WalletState State
@inject GameSession Session
@implements IDisposable

<PageTitle>Market · Arkade Heroes</PageTitle>

<div class="page-head">
    <h2>Market</h2>
    <span class="hud">covenant-enforced · buyer-funded</span>
    <span class="spacer"></span>
    <a class="btn ghost" href="gear">Gear shop →</a>
    @if (State.IsSignedIn)
    {
        <a class="btn" href="sell">List a hero</a>
    }
    @if (!_loading && !_error)
    {
        <span class="chip mono">@_active.Count live</span>
    }
</div>

@if (_buyStatus is not null)
{
    <div class="card"><div class="status-line"><span class="dot wait"></span> @_buyStatus</div></div>
}
@if (_buyError is not null)
{
    <div class="card"><div class="status-line"><span class="dot bad"></span> @_buyError</div></div>
}
@if (_bought is not null)
{
    <div class="page-head" style="margin-top:.4rem">
        <h3 style="margin:0">Bought!</h3>
        <span class="hud">you paid the seller direct · the hero is yours</span>
    </div>
    <div class="grid cols"><HeroCard Hero="_bought" Reveal="true" /></div>
}
@if (_boughtItem is not null)
{
    <div class="card">
        <div class="status-line"><span class="dot good"></span> Bought <strong>@_boughtItem</strong> — you paid the seller direct, and the unit is in your wallet.</div>
        <p class="muted" style="margin:.7rem 0 0">Equip it from <a href="gear">Gear</a>.</p>
    </div>
}

@if (_loading)
{
    <div class="status-line"><span class="dot wait"></span> browsing the stalls…</div>
}
else if (_error)
{
    <div class="card">
        <div class="status-line"><span class="dot bad"></span> Couldn't reach the arena.</div>
        <p class="muted" style="margin:.7rem 0 0">Start the server: <span class="mono">dotnet run --project src/ArkadeHeroes.Server</span></p>
    </div>
}
else if (_active.Count == 0 && _sold.Count == 0)
{
    <div class="card muted">
        No resting offers right now. Open the market by listing a hero from <a href="sell">Sell</a>,
        or a spare piece of gear from <a href="gear">Gear</a>.
    </div>
}
else
{
    @if (_active.Count > 0)
    {
        <div class="grid cols">
            @foreach (var o in _active)
            {
                <OfferCard Offer="o" Hero="@HeroFor(o)"
                           Buyable="@CanBuy(o)" Busy="@(_buyingId == o.OfferId)" OnBuy="@(() => DoBuy(o))" />
            }
        </div>
    }
    else
    {
        <div class="card muted">Nothing resting right now — but here's what just changed hands.</div>
    }

    @if (_sold.Count > 0)
    {
        <div class="page-head" style="margin-top:1.8rem">
            <h3 style="margin:0">Recently sold</h3>
            <span class="hud">covenant delivered · seller paid</span>
        </div>
        <div class="grid cols">
            @foreach (var o in _sold)
            {
                <OfferCard Offer="o" Hero="@HeroFor(o)" />
            }
        </div>
    }
}

@code {
    private List<OfferDto> _active = new();
    private List<OfferDto> _sold = new();
    private Dictionary<string, HeroDto> _heroes = new();
    private bool _loading = true;
    private bool _error;
    private string? _buyingId;
    private string? _buyStatus;
    private string? _buyError;
    private HeroDto? _bought;
    private string? _boughtItem;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnState;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        try
        {
            // A live market shows what a buyer can act on; a short "recently sold" strip carries the
            // SOLD flourish for what just changed hands. No client-side status filter: /api/offers
            // returns ONLY active offers (GameService.ListOffersAsync), so filtering here for "pending"
            // as well was dead — and worse, it implied undeposited offers reach the market. They do not.
            _active = (await Api.Offers.ListAsync()).ToList();
            try { _sold = await Api.Offers.SoldAsync(4); }
            catch { _sold = new(); }

            // Resolve genome portraits for hero offers from the public roster (one call).
            if (_active.Concat(_sold).Any(o => o.Kind == "hero" && !string.IsNullOrEmpty(o.HeroId)))
            {
                try { _heroes = (await Api.Heroes.AllAsync()).ToDictionary(h => h.Id); }
                catch { /* portraits are a nicety; the cards still render without them */ }
            }
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    // Buyable = a signed-in viewer looking at someone else's resting offer, of either kind: an item and a
    // hero rest under the SAME offer covenant, so the fulfilment is identical and only the aftermath differs.
    bool CanBuy(OfferDto o) =>
        State.IsSignedIn && _buyingId is null
        && o.Status == "active" && o.SellerId != State.Player?.PlayerId;

    async Task DoBuy(OfferDto o)
    {
        _buyingId = o.OfferId;
        _buyError = null;
        _bought = null;
        _boughtItem = null;
        _buyStatus = "Preparing the purchase…";
        try
        {
            if (o.Kind == "hero")
                _bought = await Session.BuyHeroAsync(o.OfferId,
                    s => { _buyStatus = s; StateHasChanged(); });
            else
            {
                await Session.BuyItemOfferAsync(o.OfferId,
                    s => { _buyStatus = s; StateHasChanged(); });
                _boughtItem = o.ItemName;
            }
            await LoadAsync();  // the offer has closed; refresh active + sold
        }
        catch (Exception ex)
        {
            _buyError = ex.Message;
        }
        finally
        {
            _buyingId = null;
            _buyStatus = null;
        }
    }

    private HeroDto? HeroFor(OfferDto o) =>
        !string.IsNullOrEmpty(o.HeroId) && _heroes.TryGetValue(o.HeroId, out var h) ? h : null;

    void OnState() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= OnState;
}
