# Arkade Heroes — docker compose environment template.
#
#   cp .env.example .env      then edit .env
#
# .env is gitignored (see .gitignore) and excluded from the Docker build context (see
# .dockerignore), so values you put there stay on the host: they are injected as
# environment variables at RUN time and never become part of an image layer.
#
# THIS FILE IS COMMITTED. It must only ever contain placeholders — never a real value.
# Every variable below is OPTIONAL; docker-compose.yml has a working default for each
# except the secrets, which default to empty on purpose.

# ══════════════════════════════════════════════════════════════════════════════
#  SECRETS — never commit real values, never bake into an image
# ══════════════════════════════════════════════════════════════════════════════

# *** TREASURY SEED PHRASE. ON MAINNET THIS SPENDS REAL BITCOIN. ***
# BIP-39 mnemonic for the treasury wallet (Chain__NArk__TreasuryMnemonic).
# LEAVE EMPTY unless you are RESTORING an existing treasury: empty means the app
# generates a mnemonic on first boot and persists it in the wallet DB on the named
# volume. Anyone who can read this line can drain the treasury.
# Example shape only — DO NOT USE, these are not real and funds sent to them are lost:
#   TREASURY_MNEMONIC="abandon abandon abandon ... about"
TREASURY_MNEMONIC=

# 32-byte hex key signing progression receipts (Game__ReceiptKeyHex).
# Empty = a fresh ephemeral key each process start, so receipts issued before a restart
# stop verifying. Set a stable value in a real deployment. Private: not treasury-spending,
# but whoever holds it can forge progression receipts.
RECEIPT_KEY_HEX=

# ══════════════════════════════════════════════════════════════════════════════
#  Published ports + wiring
# ══════════════════════════════════════════════════════════════════════════════

# Host port for the game API. Default: 5210.
SERVER_PORT=5210
# Host port for the frontend. Default: 5132.
WEB_PORT=5132
# Where the BROWSER reaches the API. Must be reachable from the user's machine, so a
# compose service name will NOT work here. Default: http://localhost:5210.
API_BASE_URL=http://localhost:5210
# Image tag used by docker compose. Default: local.
TAG=local
# GHCR namespace for the images. Default: arkade-heroes.
GITHUB_REPOSITORY_OWNER=arkade-heroes

# ══════════════════════════════════════════════════════════════════════════════
#  Chain backend
# ══════════════════════════════════════════════════════════════════════════════

# "InMemory" (default) = simulated chain, no bitcoin. Also EXPOSES /api/dev/* endpoints
# that mint assets and sats for free — never expose an InMemory deployment publicly.
# "NArk" = the real Arkade stack.
CHAIN_MODE=InMemory
# arkd endpoint. Default: http://host.docker.internal:7070
ARK_URI=http://host.docker.internal:7070
# Esplora-compatible REST API. Default: http://host.docker.internal:3000/api
ESPLORA_URI=http://host.docker.internal:3000/api
# Arkade Script emulator (covenant co-signing). Required for every covenant path.
EMULATOR_URI=http://host.docker.internal:7073

# ══════════════════════════════════════════════════════════════════════════════
#  Runtime / policy
# ══════════════════════════════════════════════════════════════════════════════

# Production (default) or Development.
ASPNETCORE_ENVIRONMENT=Production
# Default: Information.
LOG_LEVEL=Information
# Block the starter-hero claim until Terms are accepted. Default: false.
# Turn ON for any deployment staking real bitcoin.
REQUIRE_TERMS_ACCEPTANCE=false
# Genome-derived innate combat passives. Default: true. Changing it changes the
# published game-config hash.
INNATE_ABILITIES=true
# Hero progression flush interval. Default: 00:00:15.
HERO_FLUSH_INTERVAL=00:00:15

# ══════════════════════════════════════════════════════════════════════════════
#  Economy — fees (treasury income)
# ══════════════════════════════════════════════════════════════════════════════

BREEDING_FEE_SATS=1000
MERGE_FEE_SATS=1000
HERO_RENAME_FEE_SATS=500
# Marketplace fee, taken from each completed sale by the offer covenant. Default: 1000.
# An ask at or below this value is refused. Affects only NEW offers.
OFFER_LISTING_FEE_SATS=1000
# Tournament house rake, % of the buy-in pot. Default: 10.
TOURNAMENT_RAKE_PCT=10
MATCH_FEE_BASE_SATS=500
MATCH_FEE_PER_LEVEL=20
DEATH_MATCH_FEE_MULTIPLIER=2
ABSORB_FEE_MULTIPLIER=3
BREED_FEE_DOUBLING_CAP=3

# ══════════════════════════════════════════════════════════════════════════════
#  Economy — treasury solvency + emission (sats are REAL BITCOIN)
# ══════════════════════════════════════════════════════════════════════════════

# The daily faucet clamps payout to (treasury balance − this). Default: 0 = no floor.
TREASURY_RESERVE_FLOOR_SATS=0
# Also hold back the current season pot when paying the faucet. Default: false.
RESERVE_SEASON_POT=false
DAILY_BASE_SATS=50
DAILY_QUEST_BONUS_SATS=150
DAILY_QUESTS_PER_DAY=3
DAILY_STREAK_STEP_PCT=10
DAILY_STREAK_CAP_PCT=100
SEASON_POT_BASE_SATS=25000
SEASON_FEE_ACCRUAL_PCT=20
SEASON_LENGTH_DAYS=14

# ══════════════════════════════════════════════════════════════════════════════
#  Pacing + combat odds
# ══════════════════════════════════════════════════════════════════════════════

BREEDING_COOLDOWN_BASE_UNIT=00:00:30
# Raise this (~00:10:00) in a real deployment; it rate-limits the capped XP faucet.
GAUNTLET_COOLDOWN=00:00:30
WAGER_ESCROW_REFUND_AFTER=24:00:00
MATCHMAKING_TAKE=10
# Published on /api/chain/info so clients re-verify. Defaults: 102 (~40%), 90 (~35%).
ABSORB_CHANCE=102
ABSORB_CONTINUE_CHANCE=90
